          "type": "string"
        },
        "pubDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "updatedDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "author": {
          "type": "string",
          "default": "RankRGV Team"
        },
        "category": {
          "type": "string",
          "enum": [
            "local-seo",
            "web-design",
            "business-automation",
            "google-maps"
          ]
        },
        "targetKeyword": {
          "type": "string"
        },
        "ogImage": {
          "type": "string"
        },
        "draft": {
          "type": "boolean",
