{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "updatedDate": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "default": "RankRGV Team",
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "local-seo",
        "web-design",
        "business-automation",
        "google-maps"
      ]
    },
    "targetKeyword": {
      "type": "string"
    },
    "ogImage": {
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "pubDate",
    "category",
    "targetKeyword"
  ]
}