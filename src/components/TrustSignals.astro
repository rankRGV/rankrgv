---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats?: Stat[];
}

const { stats = [
  { value: '3×', label: 'Avg. increase in client calls' },
  { value: '90 days', label: 'Average time to first rankings' },
  { value: '4.8★', label: 'Average client rating' },
  { value: '6 cities', label: 'Covered across the RGV' },
] } = Astro.props;
---

<section class="bg-bg border-y border-border py-10" aria-label="Trust signals">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
      {stats.map((stat, i) => (
        <div class={`reveal reveal-delay-${i + 1}`}>
          <div class="text-3xl sm:text-4xl font-extrabold gradient-text mb-1">{stat.value}</div>
          <div class="text-sm text-text-muted font-medium">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
