---
interface Stat {
  value: string;
  label: string;
  /** Use a smaller value size for word values that would wrap at the default big-number size. */
  compact?: boolean;
}

interface Props {
  stats?: Stat[];
}

const { stats = [
  { value: 'Monthly', label: 'Plain-English report' },
  { value: '6', label: 'RGV cities served' },
  { value: 'Direct', label: 'You work with Eddie' },
  { value: '0', label: 'Long-term contracts' },
] } = Astro.props;
---

<section class="bg-bg border-y border-border py-10" aria-label="Trust signals">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
      {stats.map((stat, i) => (
        <div class={`reveal reveal-delay-${i + 1}`}>
          <div class={`${stat.compact ? 'text-2xl sm:text-3xl' : 'text-3xl sm:text-4xl'} font-extrabold gradient-text mb-1`}>{stat.value}</div>
          <div class="text-sm text-text-muted font-medium">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
