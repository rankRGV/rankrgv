---
import { graderHref, site } from '@/config/site';

const stickyGraderUrl = graderHref('sticky-mobile');
---

<!-- Sticky Call CTA — mobile only, appears after hero scroll, dismissable -->
<div
  id="sticky-call-cta"
  class="fixed bottom-0 left-0 right-0 z-50 md:hidden translate-y-full transition-transform duration-300 ease-out"
  aria-label="Quick actions: grade my business or call"
  role="complementary"
>
  <div
    class="flex items-center justify-between gap-3 px-4 py-3 shadow-2xl"
    style="background: linear-gradient(90deg, #1e40af 0%, #7e22ce 100%); padding-bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));"
  >
    <!-- Label -->
    <div class="flex-1 min-w-0">
      <div class="text-white/70 text-xs font-medium leading-none mb-1">See your score or talk to us</div>
      <a
        href={site.phoneHref}
        data-track="sticky-cta-number"
        class="text-white font-bold text-sm leading-tight no-underline"
        aria-label={`Call RankRGV at ${site.phone}`}
      >
        {site.phone}
      </a>
    </div>

    <!-- Call (secondary) -->
    <a
      href={site.phoneHref}
      data-track="sticky-cta-call"
      class="border border-white/40 text-white font-semibold text-xs px-3 py-2.5 rounded-xl no-underline flex-shrink-0 active:scale-95 transition-transform duration-100"
      aria-label="Call RankRGV now"
    >
      Call
    </a>

    <!-- Grade Free (primary) -->
    <a
      href={stickyGraderUrl}
      data-track="sticky-cta-grader"
      class="bg-white text-blue-800 font-bold text-sm px-4 py-2.5 rounded-xl no-underline flex-shrink-0 active:scale-95 transition-transform duration-100"
      aria-label="Get my free business grade"
    >
      Grade Free
    </a>

    <!-- Dismiss -->
    <button
      id="sticky-call-dismiss"
      class="flex-shrink-0 p-1 -mr-1 text-white/50 hover:text-white transition-colors"
      aria-label="Dismiss"
      type="button"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12" />
      </svg>
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var cta = document.getElementById('sticky-call-cta');
    var dismissBtn = document.getElementById('sticky-call-dismiss');
    if (!cta) return;

    // Check if dismissed this session
    var dismissed = false;
    try {
      if (sessionStorage.getItem('stickyCtaDismissed') === '1') dismissed = true;
    } catch (e) {}

    var shown = false;
    var SCROLL_THRESHOLD = 400;

    function show() {
      if (shown || dismissed) return;
      cta.classList.remove('translate-y-full');
      shown = true;
    }

    function hide() {
      if (!shown) return;
      cta.classList.add('translate-y-full');
      shown = false;
    }

    function onScroll() {
      if (dismissed) return;
      if (window.scrollY > SCROLL_THRESHOLD) {
        show();
      } else {
        hide();
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    if (dismissBtn) {
      dismissBtn.addEventListener('click', function () {
        dismissed = true;
        hide();
        try {
          sessionStorage.setItem('stickyCtaDismissed', '1');
        } catch (e) {}
      });
    }
  })();
</script>
