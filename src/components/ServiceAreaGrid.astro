---
import { serviceAreas } from '@/data/serviceAreas';

interface Props {
  headline?: string;
  serviceSlug?: string; // If provided, links go to /service-areas/[city]/[service]/
}

const { headline = 'We serve these RGV cities', serviceSlug } = Astro.props;
---

<section class="py-20 bg-bg-surface" aria-label="Service areas">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-text text-center mb-12 reveal">{headline}</h2>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
      {serviceAreas.map((area, i) => {
        const href = serviceSlug
          ? `/service-areas/${area.slug}/${serviceSlug}/`
          : `/service-areas/${area.slug}/`;
        return (
          <a
            href={href}
            class={`block bg-bg rounded-xl p-5 border border-border text-center card-hover no-underline group reveal reveal-delay-${Math.min(i + 1, 4)}`}
          >
            <div class="w-10 h-10 rounded-xl bg-brand-blue/10 flex items-center justify-center mx-auto mb-3 group-hover:bg-brand-blue/20 transition-colors duration-250">
              <svg class="w-5 h-5 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div class="font-semibold text-text text-sm group-hover:text-brand-blue transition-colors duration-150">{area.name}</div>
            <div class="text-xs text-text-muted mt-0.5">{area.county} Co.</div>
          </a>
        );
      })}
    </div>
  </div>
</section>
