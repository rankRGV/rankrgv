---
import { Image } from 'astro:assets';
import logoSrc from '../assets/RankRGV_compact_logo.png';
import { graderHref, site } from '@/config/site';
import { mainNav } from '@/data/navigation';

interface Props {
  lang?: 'en' | 'es';
}
const { lang = 'en' } = Astro.props;

const es = lang === 'es';
const graderUrl = graderHref('header', lang);

const navEs = [
  { label: 'Servicios', href: '/es/seo-local/', dropdown: null },
  { label: 'Áreas de Servicio', href: '/es/areas-de-servicio/', dropdown: null },
  { label: 'Precios', href: '/es/precios/', dropdown: null },
  { label: 'Blog', href: '/blog/', dropdown: null },
  { label: 'Nosotros', href: '/about/', dropdown: null },
  { label: 'Contacto', href: '/contact/', dropdown: null },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-bg-dark"
>
  <!-- Top utility bar — phone + service area coverage -->
  <div id="top-bar" class="hidden sm:block border-b border-white/10" style="background: #1d4ed8; transition: max-height 0.25s ease, overflow 0.25s ease;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-9">
        <!-- Phone -->
        <a
          href={site.phoneHref}
          class="flex items-center gap-1.5 text-xs text-white/90 hover:text-white transition-colors no-underline font-medium"
          aria-label="Call RankRGV"
        >
          <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z" />
          </svg>
          {site.phone}
        </a>
        <!-- Service area coverage — crawlable local signal -->
        <span class="text-xs text-white/85 hidden lg:block">
          {es ? 'Atendemos McAllen · Brownsville · Edinburg · Harlingen · Mission · Pharr' : 'Serving McAllen · Brownsville · Edinburg · Harlingen · Mission · Pharr'}
        </span>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 lg:h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 no-underline flex-shrink-0" aria-label="RankRGV Home">
        <Image
          id="site-logo"
          src={logoSrc}
          alt="RankRGV"
          width={256}
          height={64}
          class="h-8 w-auto transition-all duration-300"
          loading="eager"
          fetchpriority="high"
        />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
        {(es ? navEs : mainNav).map((item) => (
          item.dropdown ? (
            <div class="relative group">
              <button
                class="header-nav-btn flex items-center gap-1 px-3 py-2 text-sm font-medium text-white/80 hover:text-white rounded-md transition-colors duration-150"
                aria-expanded="false"
                aria-haspopup="true"
              >
                {item.label}
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>

              <!-- Dropdown -->
              <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                <div class="bg-white rounded-xl shadow-2xl border border-border p-2 min-w-[220px]">
                  {item.dropdown.map((child) => (
                    <a
                      href={child.href}
                      class="block px-4 py-2.5 rounded-lg text-sm font-medium text-text hover:bg-bg-surface hover:text-brand-blue transition-colors duration-150 no-underline"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class="header-nav-link px-3 py-2 text-sm font-medium text-white/80 hover:text-white rounded-md transition-colors duration-150 no-underline"
            >
              {item.label}
            </a>
          )
        ))}
      </nav>

      <!-- Primary conversion CTA; phone remains available in the utility bar -->
      <div class="hidden lg:flex items-center">
        <a href={graderUrl} class="btn-primary text-sm py-2 px-4">
          {es ? 'Califica Mi Negocio Gratis' : 'Get My Free Business Grade'}
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="header-mobile-btn lg:hidden p-2 text-white/80 hover:text-white"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="relative block w-6 h-6">
          <svg id="icon-open" class="w-6 h-6 absolute inset-0 transition-[opacity,transform] duration-150 ease-out" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="w-6 h-6 absolute inset-0 opacity-0 -rotate-45 transition-[opacity,transform] duration-150 ease-out" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile menu — always dark bg regardless of scroll. Grid-rows transition (not display:none) so open/close animates instead of teleporting. -->
  <div
    id="mobile-menu"
    class="lg:hidden grid transition-[grid-template-rows,opacity] duration-200 ease-out"
    style="grid-template-rows: 0fr; opacity: 0;"
  >
    <div class="overflow-hidden">
      <div class="border-t border-white/10 bg-bg-dark max-h-[calc(100vh-3.5rem)] overflow-y-auto overscroll-contain px-4 py-4 space-y-1">
        {(es ? navEs : mainNav).map((item) => (
          <>
            {(item as any).dropdown ? (
              <details class="group/acc js-accordion">
                <summary class="flex items-center justify-between px-3 py-2 text-sm font-medium text-white/80 hover:text-white rounded-md transition-colors cursor-pointer list-none">
                  {item.label}
                  <svg class="w-4 h-4 text-white/50 transition-transform duration-200 group-open/acc:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="pl-3">
                  {((item as any).dropdown as any[]).map((child: any) => (
                    <a
                      href={child.href}
                      class="block px-3 py-2 text-sm text-white/70 hover:text-white rounded-md transition-colors no-underline"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </details>
            ) : (
              <a
                href={item.href}
                class="block px-3 py-2 text-sm font-medium text-white/80 hover:text-white rounded-md transition-colors no-underline"
              >
                {item.label}
              </a>
            )}
          </>
        ))}
        <div class="pt-3 border-t border-white/10 flex flex-col gap-3">
          <a href={site.phoneHref} class="text-sm text-white/70 px-3 no-underline">{site.phone}</a>
          <a href={graderUrl} class="btn-primary text-sm text-center">{es ? 'Califica Mi Negocio Gratis' : 'Get My Free Business Grade'}</a>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Spacer: h-14 mobile (no top bar), h-[100px] sm+ (top bar 36px + nav 64px) -->
<div class="h-14 sm:h-[100px]"></div>

<script is:inline>
  const header    = document.getElementById('site-header');
  const logo      = document.getElementById('site-logo');
  const topBar    = document.getElementById('top-bar');
  const navLinks  = header.querySelectorAll('.header-nav-link');
  const navBtns   = header.querySelectorAll('.header-nav-btn');
  const mobileBtn = header.querySelector('.header-mobile-btn');

  function setScrolled(scrolled) {
    if (scrolled) {
      // Nav row: frosted white
      header.style.background = 'rgba(255,255,255,0.97)';
      header.style.backdropFilter = 'blur(12px)';
      header.style.boxShadow = '0 1px 16px rgba(0,0,0,0.10)';
      // Top bar stays blue — hide it on scroll to reclaim space
      if (topBar) { topBar.style.maxHeight = '0'; topBar.style.overflow = 'hidden'; topBar.style.borderBottomWidth = '0'; }

      logo.style.filter = '';
      navLinks.forEach(l => { l.style.color = '#0f172a'; });
      navBtns.forEach(b  => { b.style.color = '#0f172a'; });
      if (mobileBtn) mobileBtn.style.color = '#0f172a';
    } else {
      // Dark header — top bar visible
      header.style.background = '';
      header.style.backdropFilter = '';
      header.style.boxShadow = '';
      if (topBar) { topBar.style.maxHeight = ''; topBar.style.overflow = ''; topBar.style.borderBottomWidth = ''; }

      logo.style.filter = 'brightness(0) invert(1)';
      navLinks.forEach(l => { l.style.color = ''; });
      navBtns.forEach(b  => { b.style.color = ''; });
      if (mobileBtn) mobileBtn.style.color = '';
    }
  }

  // Initial state — page loads at top, dark header
  setScrolled(window.scrollY > 20);

  window.addEventListener('scroll', () => {
    setScrolled(window.scrollY > 20);
  }, { passive: true });

  // ── Mobile menu toggle ───────────────────────────────────
  const btn       = document.getElementById('mobile-menu-btn');
  const menu      = document.getElementById('mobile-menu');
  const iconOpen  = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn.addEventListener('click', () => {
    const wasOpen = menu.style.opacity === '1';
    const nowOpen = !wasOpen;

    menu.style.gridTemplateRows = nowOpen ? '1fr' : '0fr';
    menu.style.opacity = nowOpen ? '1' : '0';
    btn.setAttribute('aria-expanded', String(nowOpen));

    iconOpen.style.opacity = nowOpen ? '0' : '1';
    iconOpen.style.transform = nowOpen ? 'rotate(45deg)' : 'rotate(0deg)';
    iconClose.style.opacity = nowOpen ? '1' : '0';
    iconClose.style.transform = nowOpen ? 'rotate(0deg)' : 'rotate(-45deg)';

    // Hide the floating sticky CTA bar while the mobile menu is open — they occupy
    // the same space and the bar was covering the menu's own CTA/contact links.
    const stickyBar = document.getElementById('sticky-call-cta');
    if (stickyBar) stickyBar.style.transform = nowOpen ? 'translateY(100%)' : '';
  });

  // ── Accordion open/close animation (details/summary) ─────
  // Native <details> snaps open instantly; animate height via WAAPI instead,
  // measuring the summary + content so it works with any amount of text.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('details.js-accordion').forEach((el) => {
      const summary = el.querySelector(':scope > summary');
      const content = el.querySelector(':scope > summary + div');
      if (!summary || !content) return;
      let animation = null;
      let isClosing = false;
      let isExpanding = false;

      summary.addEventListener('click', (e) => {
        e.preventDefault();
        el.style.overflow = 'hidden';
        if (isClosing || !el.open) {
          openAccordion();
        } else if (isExpanding || el.open) {
          closeAccordion();
        }
      });

      function openAccordion() {
        el.style.height = `${el.offsetHeight}px`;
        el.open = true;
        window.requestAnimationFrame(runExpand);
      }

      function runExpand() {
        isExpanding = true;
        const startHeight = `${el.offsetHeight}px`;
        const endHeight = `${summary.offsetHeight + content.offsetHeight}px`;
        if (animation) animation.cancel();
        animation = el.animate(
          { height: [startHeight, endHeight] },
          { duration: 200, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' }
        );
        animation.onfinish = () => onFinish(true);
        animation.oncancel = () => { isExpanding = false; };
      }

      function closeAccordion() {
        isClosing = true;
        const startHeight = `${el.offsetHeight}px`;
        const endHeight = `${summary.offsetHeight}px`;
        if (animation) animation.cancel();
        animation = el.animate(
          { height: [startHeight, endHeight] },
          { duration: 160, easing: 'ease-out' }
        );
        animation.onfinish = () => onFinish(false);
        animation.oncancel = () => { isClosing = false; };
      }

      function onFinish(open) {
        el.open = open;
        animation = null;
        isClosing = false;
        isExpanding = false;
        el.style.height = '';
        el.style.overflow = '';
      }
    });
  }
</script>
