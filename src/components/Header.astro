---
import { site } from '@/config/site';
import { mainNav } from '@/data/navigation';
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-bg-dark"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 no-underline" aria-label="RankRGV Home">
        <span class="text-xl font-extrabold tracking-tight text-white">
          Rank<span class="gradient-text">RGV</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
        {mainNav.map((item) => (
          item.dropdown ? (
            <div class="relative group">
              <button
                class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-white/80 hover:text-white rounded-md transition-colors duration-150"
                aria-expanded="false"
                aria-haspopup="true"
              >
                {item.label}
                <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>

              <!-- Dropdown -->
              <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                <div class="bg-white rounded-xl shadow-2xl border border-border p-2 min-w-[220px]">
                  {item.dropdown.map((child) => (
                    <a
                      href={child.href}
                      class="block px-4 py-2.5 rounded-lg text-sm font-medium text-text hover:bg-bg-surface hover:text-brand-blue transition-colors duration-150 no-underline"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class="px-3 py-2 text-sm font-medium text-white/80 hover:text-white rounded-md transition-colors duration-150 no-underline"
            >
              {item.label}
            </a>
          )
        ))}
      </nav>

      <!-- CTA + Phone -->
      <div class="hidden lg:flex items-center gap-3">
        <a
          href={site.phoneHref}
          class="text-sm font-medium text-white/70 hover:text-white transition-colors no-underline"
          aria-label="Call RankRGV"
        >
          {site.phone}
        </a>
        <a href="/get-started/" class="btn-primary text-sm py-2 px-4">
          Get Free Audit
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-white/80 hover:text-white"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="lg:hidden hidden bg-bg-dark border-t border-white/10">
    <div class="px-4 py-4 space-y-1">
      {mainNav.map((item) => (
        <>
          {item.dropdown ? (
            <div>
              <p class="px-3 py-1 text-xs font-semibold text-white/40 uppercase tracking-wider">{item.label}</p>
              {item.dropdown.map((child) => (
                <a
                  href={child.href}
                  class="block px-3 py-2 text-sm text-white/70 hover:text-white rounded-md transition-colors no-underline"
                >
                  {child.label}
                </a>
              ))}
            </div>
          ) : (
            <a
              href={item.href}
              class="block px-3 py-2 text-sm font-medium text-white/80 hover:text-white rounded-md transition-colors no-underline"
            >
              {item.label}
            </a>
          )}
        </>
      ))}
      <div class="pt-3 border-t border-white/10 flex flex-col gap-3">
        <a href={site.phoneHref} class="text-sm text-white/70 px-3 no-underline">{site.phone}</a>
        <a href="/get-started/" class="btn-primary text-sm text-center">Get Free Audit</a>
      </div>
    </div>
  </div>
</header>

<!-- Spacer to prevent content from hiding under fixed header -->
<div class="h-16"></div>

<script is:inline>
  // ── Frosted glass on scroll ──────────────────────────────
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header.classList.add('header-scrolled');
      header.classList.remove('bg-bg-dark');
    } else {
      header.classList.remove('header-scrolled');
      header.classList.add('bg-bg-dark');
    }
  }, { passive: true });

  // ── Mobile menu toggle ───────────────────────────────────
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn.addEventListener('click', () => {
    const isOpen = !menu.classList.contains('hidden');
    menu.classList.toggle('hidden', isOpen);
    iconOpen.classList.toggle('hidden', !isOpen);
    iconClose.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
