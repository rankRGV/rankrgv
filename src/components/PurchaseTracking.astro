---
// Counts a Stripe payment-link purchase once, on whichever welcome page Stripe
// redirects to. Used by /welcome/ and the per-plan welcome pages.
---

<script>
  // Count the purchase here: Stripe payment links redirect to /welcome/ after a
  // successful payment. The click handler in BaseLayout leaves a note in
  // sessionStorage when a buy.stripe.com link is clicked; no note (direct visit,
  // or a payment link opened from somewhere else) means no purchase event. The
  // note is cleared after one use so a reload doesn't count twice.
  (() => {
    let pending: { link?: string; path?: string; t?: number } | null = null;
    try {
      pending = JSON.parse(sessionStorage.getItem('rankrgv_pending_checkout') || 'null');
      sessionStorage.removeItem('rankrgv_pending_checkout');
    } catch { return; }
    if (!pending || !pending.t || Date.now() - pending.t > 2 * 60 * 60 * 1000) return;
    // Known self-serve plans: payment link id -> name and monthly price.
    const plans: Record<string, { name: string; value: number }> = {
      'eVq5kEadn9Ut0YA6sy1Jm0p': { name: 'Increase Call Plan', value: 397 },
      'bJe8wQ1GRaYx9v604a1Jm0q': { name: 'Increase Call Plan', value: 397 },
      'dRm3cw99jfeNePqcQW1Jm0k': { name: 'Google Business Optimization', value: 299 },
    };
    const planKey = Object.keys(plans).find((k) => (pending!.link || '').includes(k));
    const plan = planKey ? plans[planKey] : { name: 'Stripe payment link', value: 0 };
    if (typeof (window as any).fbq === 'function') {
      (window as any).fbq('track', 'Purchase', { currency: 'USD', value: plan.value, content_name: plan.name }, { eventID: 'stripe-' + pending.t });
    }
    if (typeof (window as any).gtag !== 'function') return;
    (window as any).gtag('event', 'purchase', {
      transaction_id: 'stripe-' + pending.t,
      currency: 'USD',
      value: plan.value,
      items: [{ item_name: plan.name, price: plan.value, quantity: 1 }],
      event_label: pending.link || '',
      page_path: pending.path || '',
    });
  })();
</script>
