---
interface PainPoint {
  icon: string; // SVG path data
  title: string;
  body: string;
}

interface Props {
  headline?: string;
  points?: PainPoint[];
}

const {
  headline = 'Sound familiar?',
  points = [
    {
      icon: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
      title: "You're invisible on Google",
      body: "Your competitors show up because Google trusts them more, not because they are better at what they do. An incomplete profile, inconsistent business information, and pages that never mention the cities you serve all tell Google to pick someone else. It picks whoever gave it more signals to work with. That is what we fix.",
    },
    {
      icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
      title: 'Leads fall through the cracks',
      body: "Someone finds you online and calls. You miss it. They do not leave a voicemail. They move to the next result in under 30 seconds and never come back. Without an automatic follow up in place, that lead is gone for good. Most RGV businesses have no system for this.",
    },
    {
      icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
      title: 'Your website exists but Google ignores it',
      body: "Most RGV business websites we audit have been live for years and rank for nothing. The site looks fine. The problem is it was never built to tell Google what you do or who you serve. No city pages. No local signals. No content that connects you to the searches your customers are actually making.",
    },
  ],
} = Astro.props;
---

<section class="py-20 bg-bg-surface" aria-label="Pain points">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-text text-center mb-12 reveal">{headline}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {points.map((point, i) => (
        <div class={`bg-bg rounded-2xl p-8 border border-border card-hover reveal reveal-delay-${i + 1}`}>
          <div class="w-12 h-12 rounded-xl bg-brand-blue/10 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={point.icon} />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-text mb-3">{point.title}</h3>
          <p class="text-text-muted leading-relaxed">{point.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
