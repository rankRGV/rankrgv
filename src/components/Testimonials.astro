---
import { reviews } from '@/data/reviews';
import type { Review } from '@/data/reviews';

interface Props {
  headline?: string;
  subheadline?: string;
  items?: Review[];
}

const {
  headline = 'RGV businesses getting real results',
  subheadline = 'Real clients, real outcomes. No made-up metrics.',
  items = reviews,
} = Astro.props;

// Split into two columns for masonry effect
const col1 = items.filter((_, i) => i % 2 === 0);
const col2 = items.filter((_, i) => i % 2 === 1);
---

<section class="py-24 bg-bg-surface overflow-hidden" aria-label="Testimonials">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="max-w-2xl mx-auto text-center mb-16">
      <div class="inline-flex items-center gap-2 mb-4 px-4 py-1.5 rounded-full bg-brand-blue/10 text-brand-blue text-sm font-semibold reveal">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        Client Results
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-text mb-3 reveal reveal-delay-1">{headline}</h2>
      <p class="text-text-muted text-lg reveal reveal-delay-2">{subheadline}</p>
    </div>

    <!-- Aggregate rating bar -->
    <div class="flex items-center justify-center gap-4 mb-14 reveal reveal-delay-3">
      <div class="flex gap-1">
        {Array.from({ length: 5 }).map(() => (
          <svg class="w-6 h-6 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
      </div>
      <span class="text-text font-bold text-lg">5.0</span>
      <span class="text-text-muted text-sm">
        {items.length === 1 ? 'from 1 verified Google review' : `from ${items.length} verified Google reviews`}
      </span>
    </div>

    <!-- Layout: single centered card when only 1 review, masonry 2-col otherwise -->
    <div class={items.length === 1 ? 'max-w-2xl mx-auto' : 'grid grid-cols-1 md:grid-cols-2 gap-5 items-start'}>

      <!-- Column 1 (or single card) -->
      <div class={items.length === 1 ? '' : 'space-y-5'}>
        {col1.map((review, i) => (
          <article
            class={`bg-bg rounded-2xl p-7 border border-border card-hover reveal reveal-delay-${Math.min(i + 1, 4)}`}
            aria-label={`Testimonial from ${review.name}`}
          >
            <!-- Quote mark -->
            <div class="text-brand-blue/20 text-6xl font-serif leading-none mb-3 select-none" aria-hidden="true">"</div>

            <!-- Quote -->
            <blockquote class="text-text text-base leading-relaxed mb-6">
              {review.quote}
            </blockquote>

            <!-- Result badge -->
            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-50 border border-green-200 text-green-700 text-xs font-semibold mb-5">
              <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              {review.result}
            </div>

            <!-- Stars -->
            <div class="flex gap-0.5 mb-4" role="img" aria-label={`${review.stars} out of 5 stars`}>
              {Array.from({ length: review.stars }).map(() => (
                <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            <!-- Author -->
            <footer class="flex items-center gap-3 pt-4 border-t border-border">
              <div class={`w-10 h-10 rounded-full ${review.avatarColor} flex items-center justify-center text-white font-bold text-sm flex-shrink-0`}>
                {review.initials}
              </div>
              <div>
                <div class="font-bold text-text text-sm">{review.name}</div>
                <div class="text-text-muted text-xs">{review.business} · {review.city}, TX</div>
              </div>
            </footer>
          </article>
        ))}
      </div>

      <!-- Column 2 (offset for masonry feel) -->
      <div class="space-y-5 md:mt-10">
        {col2.map((review, i) => (
          <article
            class={`bg-bg rounded-2xl p-7 border border-border card-hover reveal reveal-delay-${Math.min(i + 2, 4)}`}
            aria-label={`Testimonial from ${review.name}`}
          >
            <div class="text-brand-blue/20 text-6xl font-serif leading-none mb-3 select-none" aria-hidden="true">"</div>

            <blockquote class="text-text text-base leading-relaxed mb-6">
              {review.quote}
            </blockquote>

            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-50 border border-green-200 text-green-700 text-xs font-semibold mb-5">
              <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              {review.result}
            </div>

            <div class="flex gap-0.5 mb-4" role="img" aria-label={`${review.stars} out of 5 stars`}>
              {Array.from({ length: review.stars }).map(() => (
                <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            <footer class="flex items-center gap-3 pt-4 border-t border-border">
              <div class={`w-10 h-10 rounded-full ${review.avatarColor} flex items-center justify-center text-white font-bold text-sm flex-shrink-0`}>
                {review.initials}
              </div>
              <div>
                <div class="font-bold text-text text-sm">{review.name}</div>
                <div class="text-text-muted text-xs">{review.business} · {review.city}, TX</div>
              </div>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
