---
import { reviews } from '@/data/reviews';
import type { Review } from '@/data/reviews';

interface Props {
  headline?: string;
  items?: Review[];
}

const {
  headline = 'RGV businesses getting real results',
  items = reviews,
} = Astro.props;
---

<section class="py-20 bg-bg-surface" aria-label="Testimonials">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-text text-center mb-12 reveal">{headline}</h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {items.map((review, i) => (
        <div class={`bg-bg rounded-2xl p-8 border border-border flex flex-col card-hover reveal reveal-delay-${i + 1}`}>
          <!-- Stars -->
          <div class="flex gap-1 mb-5" aria-label={`${review.stars} out of 5 stars`}>
            {Array.from({ length: review.stars }).map(() => (
              <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <!-- Result badge -->
          <div class="inline-flex items-center gap-2 mb-4 px-3 py-1 rounded-full bg-brand-blue/10 text-brand-blue text-xs font-semibold w-fit">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            {review.result}
          </div>

          <!-- Quote -->
          <blockquote class="text-text-muted text-sm leading-relaxed flex-grow mb-6">
            "{review.quote}"
          </blockquote>

          <!-- Attribution -->
          <footer>
            <div class="font-bold text-text text-sm">{review.name}</div>
            <div class="text-text-muted text-xs mt-0.5">{review.business} · {review.city}, TX</div>
          </footer>
        </div>
      ))}
    </div>
  </div>
</section>
