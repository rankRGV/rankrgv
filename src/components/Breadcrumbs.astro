---
interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="bg-bg-surface border-b border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
    <ol class="flex items-center flex-wrap gap-1 text-sm text-text-muted">
      {items.map((item, i) => (
        <li class="flex items-center gap-1">
          {i < items.length - 1 ? (
            <>
              <a
                href={item.href}
                class="hover:text-brand-blue transition-colors no-underline"
              >
                {item.label}
              </a>
              <svg class="w-3 h-3 text-text-muted/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </>
          ) : (
            <span class="text-text font-medium" aria-current="page">{item.label}</span>
          )}
        </li>
      ))}
    </ol>
  </div>
</nav>
