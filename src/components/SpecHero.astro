---
// Concept hero (branch concept/awwwards-hero). Big type + stats strip pattern borrowed from
// ITSUA (Awwwards nominee, Oct 2026). Trust strip uses only RankRGV's own policies and rating,
// the same facts the live homepage already publishes. CSS-only motion, no JS libraries.
import { Image } from 'astro:assets';
import { site } from '@/config/site';
import eddiePhoto from '@/assets/eddie-urbano.png';
const cities = ['McAllen', 'Edinburg', 'Mission', 'Pharr', 'Brownsville', 'Harlingen', 'Weslaco'];
const cityLinks = [
  { name: 'McAllen', href: '/service-areas/mcallen/' },
  { name: 'Edinburg', href: '/service-areas/edinburg/' },
  { name: 'Mission', href: '/service-areas/mission/' },
  { name: 'Pharr', href: '/service-areas/pharr/' },
  { name: 'Brownsville', href: '/service-areas/brownsville/' },
  { name: 'Harlingen', href: '/service-areas/harlingen/' },
];
interface Props { theme?: 'dark' | 'light' }
const { theme = 'dark' } = Astro.props;
// Facts below all match the live site (web design page, pricing page, FAQ, Google reviews).
const facts = ['Websites from $1,500', 'Local SEO from $600/mo', 'Month-to-month, no contract'];
// Same logos and approval as ClientLogos.astro, shown white on the dark hero.
const clients = [
  { name: 'Edel Roofing', file: 'edel-roofing', w: 189, h: 96, height: 46 },
  { name: 'Cool Aid Air Conditioning', file: 'cool-aid', w: 256, h: 96, height: 36 },
  { name: 'Collision Masters', file: 'collision-masters', w: 234, h: 96, height: 40 },
  { name: 'VaultX', file: 'vaultx', w: 196, h: 96, height: 32 },
  { name: 'Luxoria Realty', file: 'luxoria-realty', w: 328, h: 96, height: 32 },
  { name: 'Tekton Home Solutions', file: 'tekton-roofing', w: 323, h: 96, height: 36 },
];
---
<section class:list={['spec relative overflow-hidden', theme === 'dark' && 'spec--dark']} aria-labelledby="hero-heading">
  <div class="spec-grid" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12 lg:pt-14 lg:pb-16">
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 mb-6 lg:mb-12 text-sm">
      <p class="spec-eyebrow font-semibold text-brand-blue">Web design &amp; local SEO in McAllen, TX</p>
      <a href="/es/" hreflang="es" lang="es" class="spec-eslink font-semibold text-text-muted hover:text-brand-blue">¿Prefiere español? Ver en español →</a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_22rem] xl:grid-cols-[minmax(0,1fr)_26rem] gap-8 lg:gap-14 items-start">
      <div class="min-w-0">
        <h1 id="hero-heading" class="spec-h1 font-extrabold text-text">
          <span class="spec-line" style="--d:0ms">When McAllen</span>
          <span class="spec-line" style="--d:90ms">Googles what you do,</span>
          <span class="spec-line" style="--d:180ms"><mark class="spec-mark">be the first call.</mark></span>
        </h1>
        <p class="spec-sub mt-5 lg:mt-7 text-lg sm:text-xl text-text-muted leading-relaxed max-w-xl spec-fade" style="--d:300ms">Websites and local SEO for Rio Grande Valley businesses. A fast site built to get calls, then found on Google Maps and in AI answers. You work directly with Eddie.</p>
        <ul class="spec-facts mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-text spec-fade" style="--d:360ms">
          {facts.map((f) => <li><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>{f}</li>)}
        </ul>

        <div class="hidden lg:flex items-center gap-4 mt-10 spec-fade" style="--d:420ms">
          <Image src={eddiePhoto} alt="" widths={[96, 144]} sizes="56px" class="w-14 h-14 rounded-full object-cover object-[50%_20%] ring-2 ring-white shadow" />
          <p class="spec-muted-on text-sm leading-snug text-text-muted"><span class="spec-ink-on block font-bold text-text">Eddie Urbano, founder</span>You talk to me, not an account manager. <a href={site.phoneHref} class="spec-phone font-semibold text-brand-blue whitespace-nowrap">{site.phone}</a></p>
        </div>
      </div>

      <aside class="spec-card spec-fade flex flex-col" style="--d:260ms" aria-labelledby="grade-card-heading">
        <figure class="spec-proof order-2 lg:order-1">
          <img src="/images/grader-report-cool-aid.webp" alt="RankRGV Business Grader report for Cool Aid Air Conditioning in Edinburg: Google profile score 98 out of 100, excellent" width="1120" height="570" fetchpriority="high" decoding="async" />
          <figcaption>A real grade. Cool Aid Air Conditioning, a RankRGV client, scanned Oct 8, 2026.</figcaption>
        </figure>
        <form action={`${site.graderUrl}/`} method="get" class="order-1 lg:order-2 p-5 sm:p-6 pt-5 lg:pt-5 space-y-2.5">
          <input type="hidden" name="utm_source" value="rankrgv.com" /><input type="hidden" name="utm_medium" value="website" /><input type="hidden" name="utm_campaign" value="business-grader" /><input type="hidden" name="utm_content" value="concept-hero" />
          <p id="grade-card-heading" class="text-base font-bold text-text">See your own grade in 60 seconds</p>
          <label class="block"><span class="sr-only">Your business name</span><input name="business" type="text" maxlength="60" autocomplete="organization" placeholder="Your business name" class="spec-input" /></label>
          <label class="block"><span class="sr-only">City</span><select name="city" class="spec-input font-semibold">{cities.map((c) => <option value={c}>{c}</option>)}</select></label>
          <button type="submit" class="spec-btn"><span>Get my free grade</span><span class="spec-btn-arrow" aria-hidden="true">→</span></button>
          <p class="pt-1 text-xs text-text-muted">Automated. Free. No signup. From public Google data.</p>
        </form>
      </aside>

      <div class="lg:hidden flex items-center gap-4 -mt-2">
        <Image src={eddiePhoto} alt="" widths={[96, 144]} sizes="56px" class="w-14 h-14 rounded-full object-cover object-[50%_20%] ring-2 ring-white shadow" />
        <p class="spec-muted-on text-sm leading-snug text-text-muted"><span class="spec-ink-on block font-bold text-text">Eddie Urbano, founder</span>You talk to me, not an account manager. <a href={site.phoneHref} class="spec-phone font-semibold text-brand-blue whitespace-nowrap">{site.phone}</a></p>
      </div>
    </div>

    <nav class="mt-10 lg:mt-14 flex flex-wrap items-center gap-x-1 gap-y-2 text-sm spec-fade" style="--d:480ms" aria-label="Cities we serve">
      <span class="spec-ink-on mr-2 font-semibold text-text">Based in McAllen. Serving</span>
      {cityLinks.map((c) => <a href={c.href} class="spec-chip">{c.name}</a>)}
      <a href="/service-areas/" class="spec-chip">All Valley cities</a>
    </nav>
  </div>

  <div class="spec-band relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-7 grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-6 lg:gap-12 items-center">
      <a href={site.social.gbp} target="_blank" rel="noopener" class="spec-rating group flex items-center gap-4">
        <span class="spec-rating-num">5.0</span>
        <span class="flex flex-col">
          <span class="text-amber-400 text-lg leading-none tracking-wide" aria-label="5 out of 5 stars">★★★★★</span>
          <span class="spec-ink-on mt-1 text-sm font-semibold text-text">Rated on Google</span>
          <span class="spec-phone text-sm font-semibold text-brand-blue group-hover:underline underline-offset-4">Read the reviews →</span>
        </span>
      </a>
      <div class="min-w-0">
        <h2 class="spec-muted-on text-xs font-semibold uppercase tracking-wider text-text-muted mb-4 text-center lg:text-left">Businesses we've worked with</h2>
        <ul class="grid grid-cols-3 lg:flex lg:flex-wrap items-center justify-items-center lg:justify-between gap-x-6 gap-y-5">
          {clients.map((c) => (
            <li class="flex items-center">
              <img src={`/images/clients/${c.file}.webp`} alt={c.name} width={c.w} height={c.h} loading="lazy" decoding="async" style={`height:${c.height}px;width:auto;max-width:100%;`} class="spec-logo" />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .spec { background: linear-gradient(180deg, #f5f8ff 0%, #ffffff 70%); }
  .spec-grid {
    position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(to right, rgb(29 78 216 / 0.045) 1px, transparent 1px);
    background-size: calc(100% / 12) 100%;
    mask-image: linear-gradient(to bottom, #000 40%, transparent 85%);
  }

  .spec-h1 { font-size: clamp(2.35rem, 5.6vw, 4.1rem); line-height: 1.04; letter-spacing: -0.035em; }
  @media (min-width: 1024px) { .spec-line { white-space: nowrap; } .spec-h1 { font-size: clamp(2.35rem, calc((100vw - 500px) / 12.5), 4.1rem); } }
  .spec-line { display: block; }
  .spec-mark { background: none; color: inherit; position: relative; white-space: nowrap; z-index: 0; }
  .spec-mark::before {
    content: ''; position: absolute; left: -0.05em; right: -0.05em; bottom: 0.08em; height: 0.32em; z-index: -1;
    background: #fcd34d; border-radius: 2px; transform-origin: left; transform: scaleX(1);
  }

  .spec-card { background: #fff; border: 1px solid var(--color-border); border-radius: 18px; overflow: hidden; box-shadow: 0 1px 2px rgb(15 23 42 / .04), 0 24px 48px -16px rgb(29 78 216 / .18); }
  .spec-proof { margin: 0; padding: 0 14px 14px; }
  @media (min-width: 1024px) { .spec-proof { padding: 14px 14px 0; } }
  .spec-proof img { display: block; width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--color-border); }
  .spec-proof figcaption { margin-top: 8px; font-size: 12px; color: var(--color-text-muted); }

  .spec-input { width: 100%; height: 50px; padding: 0 14px; border: 1px solid var(--color-border); border-radius: 10px; background: #fff; font-size: 16px; color: var(--color-text); }
  .spec-input:focus { outline: 2px solid var(--color-brand-blue); outline-offset: 1px; border-color: transparent; }
  .spec-btn { width: 100%; height: 52px; display: flex; align-items: stretch; border-radius: 10px; overflow: hidden; background: var(--color-brand-blue); color: #fff; font-weight: 700; font-size: 16px; transition: background-color 180ms ease; }
  .spec-btn:hover { background: var(--color-brand-blue-dark); }
  .spec-btn > span:first-child { flex: 1; display: flex; align-items: center; justify-content: center; }
  .spec-btn-arrow { width: 52px; display: flex; align-items: center; justify-content: center; background: rgb(0 0 0 / .14); transition: width 220ms cubic-bezier(.2,.8,.2,1); }
  .spec-btn:hover .spec-btn-arrow { width: 68px; }

  .spec-chip { display: inline-flex; align-items: center; height: 32px; padding: 0 12px; border: 1px solid var(--color-border); border-radius: 99px; background: #fff; color: var(--color-text); font-weight: 500; transition: border-color 150ms ease, color 150ms ease; }
  .spec-chip:hover { border-color: var(--color-brand-blue); color: var(--color-brand-blue); }

  .spec-facts li { display: inline-flex; align-items: center; gap: 6px; }
  .spec-facts svg { color: var(--color-brand-blue); }

  .spec-band { border-top: 1px solid var(--color-border); background: rgb(255 255 255 / .7); }
  .spec-rating-num { font-size: 3rem; font-weight: 800; letter-spacing: -0.04em; line-height: 1; color: var(--color-text); }
  .spec-logo { opacity: .75; transition: opacity 150ms ease; }
  .spec-logo:hover { opacity: 1; }
  @media (min-width: 1024px) { .spec-rating { padding-right: 3rem; border-right: 1px solid var(--color-border); } }

  /* Dark theme: navy like the live hero; the white grade card pops forward. */
  .spec--dark { background: radial-gradient(70rem 40rem at 85% -10%, rgb(29 78 216 / .45), transparent 60%), radial-gradient(40rem 30rem at -10% 110%, rgb(29 78 216 / .2), transparent 60%), #0b1224; }
  .spec--dark .spec-grid { background-image: linear-gradient(to right, rgb(255 255 255 / 0.05) 1px, transparent 1px); }
  .spec--dark .spec-h1, .spec--dark .spec-ink-on { color: #fff; }
  .spec--dark .spec-mark { color: #fbbf24; }
  .spec--dark .spec-mark::before { height: 0.07em; bottom: -0.04em; background: #fbbf24; }
  .spec--dark .spec-sub, .spec--dark .spec-muted-on, .spec--dark .spec-eslink { color: rgb(255 255 255 / .8); }
  .spec--dark .spec-eslink:hover { color: #fff; }
  .spec--dark .spec-eyebrow, .spec--dark .spec-phone { color: #93c5fd; }
  .spec--dark .spec-chip { background: rgb(255 255 255 / .06); border-color: rgb(255 255 255 / .2); color: #fff; }
  .spec--dark .spec-chip:hover { border-color: #93c5fd; color: #93c5fd; }
  .spec--dark .spec-facts { color: rgb(255 255 255 / .85); }
  .spec--dark .spec-facts svg { color: #fbbf24; }
  .spec--dark .spec-band { border-top-color: rgb(255 255 255 / .1); background: rgb(255 255 255 / .03); }
  .spec--dark .spec-rating-num { color: #fff; }
  .spec--dark .spec-logo { filter: brightness(0) invert(1); opacity: .6; }
  .spec--dark .spec-logo:hover { opacity: .95; }
  @media (min-width: 1024px) { .spec--dark .spec-rating { border-right-color: rgb(255 255 255 / .12); } }
  .spec--dark .spec-card { border-color: transparent; box-shadow: 0 30px 60px -20px rgb(0 0 0 / .6), 0 0 0 1px rgb(255 255 255 / .08); }

  /* Entrance motion. Skipped for reduced-motion users. */
  @media (prefers-reduced-motion: no-preference) {
    .spec-line { animation: spec-rise 700ms cubic-bezier(.2,.8,.2,1) both; animation-delay: var(--d); }
    .spec-mark::before { animation: spec-sweep 600ms cubic-bezier(.6,0,.2,1) 650ms both; }
    .spec-fade { animation: spec-fade 600ms ease-out both; animation-delay: var(--d); }
    .spec-stat { animation: spec-fade 500ms ease-out both; animation-delay: var(--d); }
  }
  @keyframes spec-rise { from { opacity: 0; transform: translateY(0.3em); } to { opacity: 1; transform: none; } }
  @keyframes spec-sweep { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes spec-fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
</style>
