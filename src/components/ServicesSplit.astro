---
// Concept services section: web design and local SEO side by side, web design first.
// Every price and inclusion is copied from /web-design/ and /pricing/.
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const check = 'M5 13l4 4L19 7';
const mainEn = [
  {
    href: '/web-design/',
    tag: 'Web design',
    title: 'Websites built in McAllen to get calls',
    body: 'A fast website that explains your services and makes it easy for customers to call or send you a message. City and service pages, contact forms and visitor tracking are part of the build.',
    items: ['Foundation site, 5 to 7 pages: $1,500', 'Growth site, 10 to 15 pages: $2,500', '30 days of support after launch', 'Fixed price before any work starts'],
    link: 'View web design',
    note: 'One-time price, plus sales tax',
  },
  {
    href: '/local-seo/',
    tag: 'Local SEO',
    title: 'Get found on Google Maps in the RGV',
    body: 'Help customers find your business on Google Maps and in the local searches they already make. You get reports in plain English.',
    items: ['Visibility plan: $600/mo', 'Domination plan: $975/mo', 'Google Business Profile management included', 'Month-to-month. Leave any month.'],
    link: 'View local SEO',
    note: 'Monthly, plus sales tax',
  },
];
// Spanish: same facts, plan names as on /es/precios/. No Spanish web design page yet, so that card goes to its pricing section.
const mainEs = [
  {
    href: '/es/precios/#web-design-pricing',
    tag: 'Diseño web',
    title: 'Sitios web hechos en McAllen para recibir llamadas',
    body: 'Un sitio web rápido que explica tus servicios y hace fácil que los clientes te llamen o te manden un mensaje. Las páginas por ciudad y por servicio, los formularios de contacto y la medición de visitas son parte del sitio.',
    items: ['Sitio Fundación, de 5 a 7 páginas: $1,500', 'Sitio Crecimiento, de 10 a 15 páginas: $2,500', '30 días de soporte después del lanzamiento', 'Precio fijo antes de empezar cualquier trabajo'],
    link: 'Ver diseño web',
    note: 'Pago único, más impuesto de ventas',
  },
  {
    href: '/es/seo-local/',
    tag: 'SEO local',
    title: 'Aparece en Google Maps en el RGV',
    body: 'Ayudamos a que los clientes encuentren tu negocio en Google Maps y en las búsquedas locales que ya hacen. Recibes reportes fáciles de entender.',
    items: ['Plan Visibilidad: $600/mes', 'Plan Dominación: $975/mes', 'Incluye el manejo de tu perfil de Google Business', 'Mes a mes. Te puedes ir cualquier mes.'],
    link: 'Ver SEO local',
    note: 'Mensual, más impuesto de ventas',
  },
];
const extraEn = [
  { href: '/ads-management/', title: 'Google & Meta Ads', body: 'Paid search and social alongside SEO. Flat management fee, separate from ad spend.' },
  { href: '/business-automation/', title: 'Business Automation', body: 'Missed-call texts, review requests and follow-ups, so leads stop slipping away.' },
];
const extraEs = [
  { href: '/es/precios/#ads-management-pricing', title: 'Anuncios en Google y Meta', body: 'Búsqueda pagada y redes sociales junto con el SEO. Tarifa fija de manejo, aparte de lo que gastas en anuncios.' },
  { href: '/es/precios/#automation-pricing', title: 'Automatización de negocios', body: 'Mensajes automáticos por llamadas perdidas, solicitudes de reseñas y seguimientos, para que no se te escapen los clientes.' },
];
const main = es ? mainEs : mainEn;
const extra = es ? extraEs : extraEn;
const t = es
  ? { eyebrow: 'Lo que hacemos', heading: 'Un sitio web que convierte. Y después, las búsquedas que te mandan gente.', sub: 'La mayoría de los negocios del Valle necesitan los dos. Empieza con cualquiera.' }
  : { eyebrow: 'What we do', heading: 'A website that converts. Then the searches that send people to it.', sub: 'Most Valley businesses need both. Start with either one.' };
---
<section class="py-14 lg:py-20 bg-bg-surface" aria-labelledby="services-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-8 sm:mb-10">
      <p class="text-sm font-semibold text-brand-blue mb-2">{t.eyebrow}</p>
      <h2 id="services-heading" class="text-3xl sm:text-4xl font-extrabold tracking-tight text-text mb-3">{t.heading}</h2>
      <p class="text-text-muted text-lg">{t.sub}</p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
      {main.map((s) => (
        <a href={s.href} class="svc group flex flex-col rounded-3xl bg-white border border-border p-7 sm:p-9">
          <span class="self-start mb-4 px-3 py-1 rounded-full bg-brand-blue/10 text-brand-blue text-xs font-bold uppercase tracking-wide">{s.tag}</span>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-text leading-tight mb-3">{s.title}</h3>
          <p class="text-text-muted leading-relaxed mb-6">{s.body}</p>
          <ul class="space-y-2.5 mb-8">
            {s.items.map((it) => (
              <li class="flex items-start gap-3 text-text">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d={check} /></svg>
                {it}
              </li>
            ))}
          </ul>
          <span class="mt-auto flex flex-col items-start gap-1 sm:flex-row sm:items-center sm:justify-between sm:gap-4 pt-5 border-t border-border">
            <span class="inline-flex items-center gap-2 font-bold text-brand-blue whitespace-nowrap">{s.link}<span class="svc-arrow" aria-hidden="true">→</span></span>
            <span class="text-xs text-text-muted">{s.note}</span>
          </span>
        </a>
      ))}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-5">
      {extra.map((e) => (
        <a href={e.href} class="svc group flex items-center justify-between gap-6 rounded-2xl bg-white border border-border px-6 py-5">
          <span><span class="block font-bold text-text">{e.title}</span><span class="block text-sm text-text-muted">{e.body}</span></span>
          <span class="svc-arrow text-brand-blue text-xl" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .svc { transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease; }
  .svc:hover { border-color: var(--color-brand-blue); box-shadow: 0 20px 40px -20px rgb(29 78 216 / .25); }
  .svc-arrow { display: inline-block; transition: transform 200ms cubic-bezier(.2,.8,.2,1); }
  .svc:hover .svc-arrow { transform: translateX(4px); }
</style>
