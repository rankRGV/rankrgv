---
import { site } from '@/config/site';

interface Props {
  headline?: string;
  subheadline?: string;
  primaryCTA?: { label: string; href: string };
  secondaryCTA?: { label: string; href: string };
}

const {
  headline = 'Your customers are searching right now. Someone else is getting that call.',
  subheadline = 'Call for a free 15 minute conversation. We will tell you exactly where you stand, what your competitors are doing that you are not, and how fast that changes.',
  primaryCTA = { label: `Call ${site.phone}`, href: site.phoneHref },
  secondaryCTA = { label: 'Get a Free Written Audit', href: '/get-started/' },
} = Astro.props;
---

<section
  class="py-20 relative overflow-hidden"
  style="background: linear-gradient(135deg, #1d4ed8 0%, #1e3a8a 60%, #0f172a 100%);"
  aria-label="Call to action"
>
  <!-- Subtle dot-grid overlay — same as hero but lighter -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.07) 1px, transparent 0); background-size: 28px 28px;"
    aria-hidden="true"
  ></div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4 reveal">{headline}</h2>
    <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto reveal reveal-delay-1">{subheadline}</p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center reveal reveal-delay-2">
      <!-- Primary CTA: white button on blue bg — high contrast -->
      <a
        href={primaryCTA.href}
        class="inline-flex items-center justify-center gap-2 bg-white text-brand-blue font-bold px-7 py-3.5 rounded-lg transition-all duration-200 hover:bg-blue-50 hover:shadow-lg no-underline"
      >
        <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z" />
        </svg>
        {primaryCTA.label}
      </a>
      <!-- Secondary CTA: ghost on blue bg -->
      <a href={secondaryCTA.href} class="btn-secondary">
        {secondaryCTA.label}
      </a>
    </div>
  </div>
</section>
