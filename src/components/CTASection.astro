---
import { site } from '@/config/site';

interface Props {
  headline?: string;
  subheadline?: string;
  primaryCTA?: { label: string; href: string };
  secondaryCTA?: { label: string; href: string };
}

const {
  headline = 'Ready to show up when your customers search?',
  subheadline = "Let's find out exactly what keywords you're missing — and build a plan to own them.",
  primaryCTA = { label: 'Get Your Free SEO Audit', href: '/get-started/' },
  secondaryCTA = { label: `Call ${site.phone}`, href: site.phoneHref },
} = Astro.props;
---

<section
  class="py-20 relative overflow-hidden"
  style="background: linear-gradient(135deg, #1d4ed8 0%, #1e3a8a 60%, #312e81 100%);"
  aria-label="Call to action"
>
  <!-- Subtle dot-grid overlay — same as hero but lighter -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.07) 1px, transparent 0); background-size: 28px 28px;"
    aria-hidden="true"
  ></div>

  <!-- Right-side glow blob -->
  <div
    class="absolute -right-32 -top-32 w-96 h-96 rounded-full pointer-events-none"
    style="background: radial-gradient(circle, rgba(124,58,237,0.35) 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4 reveal">{headline}</h2>
    <p class="text-lg text-white/75 mb-10 max-w-2xl mx-auto reveal reveal-delay-1">{subheadline}</p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center reveal reveal-delay-2">
      <!-- Primary CTA: white button on blue bg — high contrast -->
      <a
        href={primaryCTA.href}
        class="inline-flex items-center justify-center gap-2 bg-white text-brand-blue font-bold px-7 py-3.5 rounded-lg transition-all duration-200 hover:bg-blue-50 hover:shadow-lg no-underline"
      >
        {primaryCTA.label}
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <!-- Secondary CTA: ghost on blue bg -->
      <a href={secondaryCTA.href} class="btn-secondary">
        {secondaryCTA.label}
      </a>
    </div>
  </div>
</section>
