---
import { site } from '@/config/site';
const cities = ['McAllen', 'Edinburg', 'Mission', 'Pharr', 'Brownsville', 'Harlingen', 'Weslaco'];
---
<section class="hero-bg relative overflow-hidden" aria-labelledby="hero-heading">
  <div class="absolute inset-0 bg-gradient-to-br from-brand-blue/25 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] gap-10 xl:gap-16 items-center">
      <div class="min-w-0">
        <p class="text-sm font-semibold text-white/85 mb-5">Local SEO agency in McAllen, TX</p>
        <h1 id="hero-heading" class="text-4xl sm:text-5xl xl:text-[3.5rem] font-extrabold text-white leading-[1.08] tracking-tight text-balance">When McAllen Googles what you do, <span class="text-amber-400">be the first call.</span></h1>
        <p class="mt-5 text-lg sm:text-xl text-white/85 leading-relaxed max-w-xl text-pretty">Local SEO for Rio Grande Valley businesses. Get found on Google Maps and in AI answers, with a McAllen team and month-to-month service.</p>
        <form id="hero-grade-form" action={`${site.graderUrl}/`} method="get" class="grade-form hero-form mt-8 max-w-xl text-left">
          <input type="hidden" name="utm_source" value="rankrgv.com" /><input type="hidden" name="utm_medium" value="website" /><input type="hidden" name="utm_campaign" value="business-grader" /><input type="hidden" name="utm_content" value="homepage-hero" />
          <p class="grade-heading">See your grade in 60 seconds</p>
          <div class="grade-controls">
            <label class="grade-business"><span class="sr-only">Your business name</span><input id="hero-business" name="business" type="text" maxlength="60" autocomplete="organization" placeholder="Your business name" /></label>
            <label class="grade-city"><span class="sr-only">City</span><select id="hero-city" name="city">{cities.map((city) => <option value={city}>{city}</option>)}</select></label>
            <button type="submit" class="grade-submit">Get my free grade <span aria-hidden="true">→</span></button>
          </div>
        </form>
        <p class="mt-4 text-sm text-white/80">Automated. Free. No signup. Your Google profile score and Maps position, from public data.</p>
        <p class="mt-2 text-sm text-white/80">Prefer a personal audit? <a href="/contact/" class="font-semibold text-white underline underline-offset-4">Ask Eddie</a>, or <a href={site.phoneHref} class="font-semibold text-white underline underline-offset-4 whitespace-nowrap">call {site.phone}</a>.</p>
      </div>
      <figure class="min-w-0 w-full max-w-[30rem] mx-auto lg:mx-0">
        <div class="hero-report">
          <img src="/images/grader-report-cool-aid.webp" alt="RankRGV Business Grader report for Cool Aid Air Conditioning in Edinburg: Google profile score 98 out of 100, Google Maps position number 11 for AC repair" width="1120" height="1330" fetchpriority="high" decoding="async" />
        </div>
        <figcaption class="mt-3 text-sm text-white/75 text-center lg:text-left">A real report. Cool Aid Air Conditioning, a RankRGV client, scanned Oct 8, 2026.</figcaption>
      </figure>
    </div>
  </div>
</section>
<style>
  .hero-report { border-radius: 16px; overflow: hidden; background: #f8fafc; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.08); }
  .hero-report img { display: block; width: 100%; height: auto; }
</style>
