---
interface Step {
  number: string;
  title: string;
  body: string;
}

interface Props {
  headline?: string;
  subheadline?: string;
  steps?: Step[];
}

const {
  headline = 'How it works',
  subheadline = 'No long-term contracts. No fluff. Just a clear process that gets results.',
  steps = [
    {
      number: '01',
      title: 'Free SEO Audit',
      body: "We look at your Google Business Profile, your website, and who is ranking above you for your main searches. Most businesses see for the first time exactly which calls are going to a competitor. Takes 48 hours.",
    },
    {
      number: '02',
      title: 'Build Your Strategy',
      body: "Every keyword gets mapped to a specific page built to rank for it. Without this step, most businesses build content Google never connects to real searches. You see the full plan before we build anything.",
    },
    {
      number: '03',
      title: 'Build & Optimize',
      body: "We build every page and your Google Business Profile with the signals Google needs: local content, schema, the right categories, consistent citations. This is the part most businesses skip, which is why their site ranks for nothing after years online.",
    },
    {
      number: '04',
      title: 'Track & Grow',
      body: "Every month you get a plain English report: which keywords moved, how many calls came from Google, and what is next. Rankings compound. We keep pushing so you do not lose the ground you gain.",
    },
  ],
} = Astro.props;

// Determine columns: 4 steps → 4-col, 6 steps → 3-col per row
const isEvenSix = steps.length === 6;
---

<section id="how-we-work" class="py-20 bg-bg" aria-label="How we work">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-text mb-4 reveal">{headline}</h2>
      <p class="text-text-muted text-lg reveal reveal-delay-1">{subheadline}</p>
    </div>

    <!-- Grid: 3 cols for 6 steps, 4 cols for 4 steps -->
    <div class={`grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-12 ${isEvenSix ? 'lg:grid-cols-3' : 'lg:grid-cols-4'}`}>
      {steps.map((step, i) => {
        // Don't show connector after last in each row
        const colCount = isEvenSix ? 3 : 4;
        const isLastInRow = (i + 1) % colCount === 0;
        const isLast = i === steps.length - 1;
        const showConnector = !isLastInRow && !isLast;

        return (
          <div class={`relative reveal reveal-delay-${Math.min(i + 1, 4)}`}>
            <!-- Connector line to next step (desktop only) -->
            {showConnector && (
              <div
                class="step-connector hidden lg:block absolute top-8 left-[calc(50%+2.5rem)] right-[-2rem] h-px overflow-hidden"
                aria-hidden="true"
              >
                <div class="h-full w-full bg-gradient-to-r from-brand-blue/40 to-brand-blue/10 origin-left scale-x-0 transition-transform duration-700 ease-out connector-line"></div>
              </div>
            )}

            <div class="text-center">
              <!-- Step number badge -->
              <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-brand-blue text-white text-xl font-extrabold mb-5 mx-auto shadow-lg shadow-brand-blue/25">
                {step.number}
              </div>
              <h3 class="text-base font-bold text-text mb-2">{step.title}</h3>
              <p class="text-text-muted text-sm leading-relaxed">{step.body}</p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script is:inline>
  // Animate connector lines when steps come into view
  const connectors = document.querySelectorAll('.connector-line');
  const connectorObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          // Stagger each line slightly
          const idx = Array.from(connectors).indexOf(e.target);
          setTimeout(() => {
            e.target.style.transform = 'scaleX(1)';
          }, idx * 120);
          connectorObserver.unobserve(e.target);
        }
      });
    },
    { threshold: 0.5 }
  );
  connectors.forEach((c) => connectorObserver.observe(c));
</script>
