---
import { site } from '@/config/site';

interface Props {
  headline: string;
  subheadline: string;
  primaryCTA?: { label: string; href: string };
  secondaryCTA?: { label: string; href: string };
  badge?: string;
  showVisual?: boolean; // false on non-SEO pages (web design, automation)
}

const {
  headline,
  subheadline,
  primaryCTA = { label: 'Get Your Free SEO Audit', href: '/get-started/' },
  secondaryCTA = { label: 'See how it works', href: '#how-we-work' },
  badge,
  showVisual = true,
} = Astro.props;
---

<section class="hero-bg py-28 lg:py-36 relative overflow-hidden" aria-label="Hero">
  <!-- Depth gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-brand-blue/20 via-transparent to-brand-purple/20 pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class={showVisual ? 'grid grid-cols-1 lg:grid-cols-2 gap-12 xl:gap-20 items-center' : 'max-w-3xl'}>

      <!-- Left: Text content -->
      <div>
        <!-- Badge -->
        {badge && (
          <div class="inline-flex items-center gap-2 mb-6 px-4 py-2 rounded-full bg-white/10 border border-white/20 text-sm font-medium text-white/80 float">
            <span class="w-2 h-2 rounded-full bg-brand-blue-light flex-shrink-0"></span>
            {badge}
          </div>
        )}

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
          <span set:html={headline} />
        </h1>

        <!-- Subheadline -->
        <p class="text-lg sm:text-xl text-white/70 leading-relaxed mb-10 max-w-xl">
          {subheadline}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={primaryCTA.href} class="btn-primary">
            {primaryCTA.label}
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href={secondaryCTA.href} class="btn-secondary">
            {secondaryCTA.label}
          </a>
        </div>

        <!-- Social proof strip -->
        <div class="flex items-center gap-3 mt-8 pt-6 border-t border-white/10">
          <div class="flex gap-0.5" aria-label="5 out of 5 stars">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-white/60 text-sm">5.0 rating · Trusted by McAllen & RGV business owners</p>
        </div>
      </div>

      <!-- Right: Map Pack visual -->
      {showVisual && (
        <div class="hidden lg:block relative px-6 pt-6 pb-8">
          <!-- Glow behind card -->
          <div class="absolute inset-0 bg-brand-blue/15 rounded-3xl blur-3xl" aria-hidden="true"></div>

          <!-- Main map pack card -->
          <div class="relative bg-white rounded-2xl shadow-2xl overflow-hidden">

            <!-- Browser chrome -->
            <div class="flex items-center gap-1.5 px-4 py-3 bg-gray-50 border-b border-gray-100">
              <div class="w-3 h-3 rounded-full bg-red-400" aria-hidden="true"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-400" aria-hidden="true"></div>
              <div class="w-3 h-3 rounded-full bg-green-400" aria-hidden="true"></div>
              <div class="flex-1 mx-3 bg-white border border-gray-200 rounded-full px-3 py-1 flex items-center gap-2">
                <svg class="w-3 h-3 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <span class="text-xs text-gray-600">ac repair mcallen tx</span>
              </div>
            </div>

            <!-- Map area -->
            <div
              class="relative h-28 overflow-hidden"
              style="background: linear-gradient(135deg, #d1fae5 0%, #bfdbfe 100%);"
              aria-hidden="true"
            >
              <!-- Grid lines for map feel -->
              <div
                class="absolute inset-0 opacity-20"
                style="background-image: linear-gradient(#94a3b8 1px, transparent 1px), linear-gradient(90deg, #94a3b8 1px, transparent 1px); background-size: 36px 36px;"
              ></div>
              <!-- Pin #1 — client, highlighted -->
              <div class="absolute top-4 left-[28%] flex flex-col items-center">
                <div class="w-7 h-7 rounded-full bg-brand-blue border-2 border-white shadow-lg flex items-center justify-center text-white text-xs font-bold">1</div>
                <div class="w-1.5 h-2 bg-brand-blue rounded-b-full"></div>
              </div>
              <!-- Pin #2 -->
              <div class="absolute top-9 left-[52%] flex flex-col items-center">
                <div class="w-5 h-5 rounded-full bg-gray-400 border-2 border-white shadow flex items-center justify-center text-white text-xs font-bold">2</div>
                <div class="w-1 h-1.5 bg-gray-400 rounded-b-full"></div>
              </div>
              <!-- Pin #3 -->
              <div class="absolute top-14 left-[68%] flex flex-col items-center">
                <div class="w-5 h-5 rounded-full bg-gray-400 border-2 border-white shadow flex items-center justify-center text-white text-xs font-bold">3</div>
                <div class="w-1 h-1.5 bg-gray-400 rounded-b-full"></div>
              </div>
            </div>

            <!-- Local pack results -->
            <div class="divide-y divide-gray-100">
              <!-- Result #1 — prospect's business, highlighted -->
              <div class="flex items-center gap-3 px-4 py-3.5 bg-blue-50/70">
                <div class="w-7 h-7 rounded-full bg-brand-blue flex items-center justify-center text-white text-xs font-bold flex-shrink-0">1</div>
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-bold text-brand-blue">Your Business Here</div>
                  <div class="flex items-center gap-1 mt-0.5">
                    <span class="text-amber-400 text-xs">★★★★★</span>
                    <span class="text-xs text-gray-500">5.0 · AC Repair · McAllen, TX</span>
                  </div>
                </div>
                <span class="flex-shrink-0 text-xs bg-green-100 text-green-700 font-bold px-2 py-0.5 rounded-full">#1</span>
              </div>
              <!-- Result #2 — faded competitor -->
              <div class="flex items-center gap-3 px-4 py-3 opacity-40">
                <div class="w-6 h-6 rounded-full bg-gray-300 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">2</div>
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-medium text-gray-600">Competitor A</div>
                  <div class="text-xs text-gray-400">★★★★ 4.1 (19) · HVAC</div>
                </div>
              </div>
              <!-- Result #3 — more faded -->
              <div class="flex items-center gap-3 px-4 py-3 opacity-20">
                <div class="w-6 h-6 rounded-full bg-gray-300 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">3</div>
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-medium text-gray-600">Competitor B</div>
                  <div class="text-xs text-gray-400">★★★ 3.8 (7) · HVAC</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Floating card — top right: traffic growth -->
          <div
            class="absolute -top-2 right-2 bg-white rounded-xl shadow-xl px-3.5 py-2.5 border border-gray-100 flex items-center gap-2.5 float"
            aria-hidden="true"
          >
            <div class="w-9 h-9 rounded-full bg-green-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <div>
              <div class="text-sm font-extrabold text-gray-900 leading-none">+312%</div>
              <div class="text-xs text-gray-500 mt-0.5">Google traffic</div>
            </div>
          </div>

          <!-- Floating card — bottom left: time to rank -->
          <div
            class="absolute -bottom-2 left-2 bg-white rounded-xl shadow-xl px-3.5 py-2.5 border border-gray-100 flex items-center gap-2.5 float"
            style="animation-delay: 1.5s;"
            aria-hidden="true"
          >
            <div class="w-9 h-9 rounded-full bg-brand-blue/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <div class="text-sm font-extrabold text-gray-900 leading-none">90 days</div>
              <div class="text-xs text-gray-500 mt-0.5">to first rankings</div>
            </div>
          </div>
        </div>
      )}

    </div>
  </div>
</section>
