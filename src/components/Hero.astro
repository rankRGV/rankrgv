---
import { site } from '@/config/site';

interface Props {
  headline: string;
  subheadline: string;
  primaryCTA?: { label: string; href: string };
  secondaryCTA?: { label: string; href: string };
  badge?: string;
  showVisual?: boolean;
  visualType?: 'map-pack' | 'pagespeed' | 'sms'; // which right-side visual to render
  mockupQuery?: string;    // text in the fake search bar (map-pack only)
  mockupCategory?: string; // "type · City, TX" line under result #1 (map-pack only)
}

const {
  headline,
  subheadline,
  primaryCTA = { label: 'Call for a Free 15-Min Consultation', href: site.phoneHref },
  secondaryCTA = { label: 'Get a Free Written Audit', href: '/get-started/' },
  badge,
  showVisual = true,
  visualType = 'map-pack',
  mockupQuery = 'local seo mcallen tx',
  mockupCategory = 'Marketing Agency · McAllen, TX',
} = Astro.props;
---

<section class="hero-bg pt-10 pb-28 lg:py-36 relative overflow-hidden" aria-label="Hero">
  <!-- Depth gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-brand-blue/20 via-transparent to-brand-purple/20 pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class={showVisual ? 'grid grid-cols-1 lg:grid-cols-2 gap-12 xl:gap-20 items-center' : 'max-w-3xl'}>

      <!-- Left: Text content -->
      <div>
        <!-- Badge -->
        {badge && (
          <div class="inline-flex items-center gap-2 mb-6 px-4 py-2 rounded-full bg-white/10 border border-white/20 text-sm font-medium text-white/80 float">
            <span class="w-2 h-2 rounded-full bg-brand-blue-light flex-shrink-0"></span>
            {badge}
          </div>
        )}

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
          <span set:html={headline} />
        </h1>

        <!-- Subheadline -->
        <p class="text-lg sm:text-xl text-white/70 leading-relaxed mb-10 max-w-xl">
          {subheadline}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={primaryCTA.href} class="btn-primary">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z" />
            </svg>
            {primaryCTA.label}
          </a>
          <a href={secondaryCTA.href} class="btn-secondary">
            {secondaryCTA.label}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <!-- Social proof strip -->
        <div class="flex items-center gap-3 mt-8 pt-6 border-t border-white/10">
          <div class="flex gap-0.5" role="img" aria-label="5 out of 5 stars">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-white/60 text-sm">5.0 ★ Google rating · RGV-focused · Month-to-month</p>
        </div>
      </div>

      <!-- Right: Service-specific visual -->
      {showVisual && (
        <div class="hidden lg:block relative px-6 pt-6 pb-8">
          <!-- Glow behind card -->
          <div class="absolute inset-0 bg-brand-blue/15 rounded-3xl blur-3xl" aria-hidden="true"></div>

          {visualType === 'pagespeed' ? (
            <>
              <div class="relative bg-white rounded-2xl shadow-2xl overflow-hidden">
                <!-- Browser chrome -->
                <div class="flex items-center gap-1.5 px-4 py-3 bg-gray-50 border-b border-gray-100">
                  <div class="w-3 h-3 rounded-full bg-red-400" aria-hidden="true"></div>
                  <div class="w-3 h-3 rounded-full bg-yellow-400" aria-hidden="true"></div>
                  <div class="w-3 h-3 rounded-full bg-green-400" aria-hidden="true"></div>
                  <div class="flex-1 mx-3 bg-white border border-gray-200 rounded-full px-3 py-1 flex items-center gap-2">
                    <svg class="w-3 h-3 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                    <span class="text-xs text-gray-600">pagespeed.web.dev · rankrgv.com</span>
                  </div>
                </div>

                <!-- Score section -->
                <div class="px-5 pt-5 pb-2">
                  <div class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-4">PageSpeed Insights · Mobile</div>
                  <div class="flex items-center gap-5 mb-4">
                    <!-- SVG score ring -->
                    <div class="relative flex-shrink-0" aria-hidden="true">
                      <svg viewBox="0 0 100 100" class="w-24 h-24">
                        <!-- Track -->
                        <circle cx="50" cy="50" r="42" fill="none" stroke="#e5e7eb" stroke-width="7" />
                        <!-- Score arc: 99/100 — circumference ≈ 263.9, 99% ≈ 261.2 -->
                        <circle
                          cx="50" cy="50" r="42" fill="none"
                          stroke="#22c55e" stroke-width="7"
                          stroke-dasharray="261 264"
                          stroke-linecap="round"
                          transform="rotate(-90 50 50)"
                        />
                      </svg>
                      <div class="absolute inset-0 flex flex-col items-center justify-center">
                        <span class="text-2xl font-extrabold text-green-600 leading-none">99</span>
                        <span class="text-xs text-gray-400 mt-0.5">Score</span>
                      </div>
                    </div>
                    <div>
                      <div class="font-bold text-gray-900 text-sm mb-1.5">Performance</div>
                      <div class="flex items-center gap-1.5 mb-1">
                        <div class="w-2 h-2 rounded-full bg-green-500 flex-shrink-0"></div>
                        <span class="text-xs text-gray-600 font-medium">Excellent · Top 1%</span>
                      </div>
                      <div class="text-xs text-gray-400">Faster than 99% of websites</div>
                    </div>
                  </div>
                </div>

                <!-- Core Web Vitals -->
                <div class="px-5 pb-5 border-t border-gray-100 pt-4">
                  <div class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Core Web Vitals</div>
                  <div class="grid grid-cols-2 gap-2">
                    <div class="flex items-center gap-2.5 bg-green-50 border border-green-100 rounded-xl px-3 py-2.5">
                      <div class="w-2 h-2 rounded-full bg-green-500 flex-shrink-0"></div>
                      <div>
                        <div class="text-xs font-extrabold text-gray-800 leading-none">0.8 s</div>
                        <div class="text-xs text-gray-400 mt-0.5">LCP · Good</div>
                      </div>
                    </div>
                    <div class="flex items-center gap-2.5 bg-green-50 border border-green-100 rounded-xl px-3 py-2.5">
                      <div class="w-2 h-2 rounded-full bg-green-500 flex-shrink-0"></div>
                      <div>
                        <div class="text-xs font-extrabold text-gray-800 leading-none">&lt; 10 ms</div>
                        <div class="text-xs text-gray-400 mt-0.5">INP · Good</div>
                      </div>
                    </div>
                    <div class="flex items-center gap-2.5 bg-green-50 border border-green-100 rounded-xl px-3 py-2.5">
                      <div class="w-2 h-2 rounded-full bg-green-500 flex-shrink-0"></div>
                      <div>
                        <div class="text-xs font-extrabold text-gray-800 leading-none">0.00</div>
                        <div class="text-xs text-gray-400 mt-0.5">CLS · Good</div>
                      </div>
                    </div>
                    <div class="flex items-center gap-2.5 bg-green-50 border border-green-100 rounded-xl px-3 py-2.5">
                      <div class="w-2 h-2 rounded-full bg-green-500 flex-shrink-0"></div>
                      <div>
                        <div class="text-xs font-extrabold text-gray-800 leading-none">0.6 s</div>
                        <div class="text-xs text-gray-400 mt-0.5">FCP · Good</div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Floating card — top right: Lighthouse badge -->
              <div class="absolute -top-2 right-2 bg-white rounded-xl shadow-xl px-3.5 py-2.5 border border-gray-100 flex items-center gap-2.5 float" aria-hidden="true">
                <div class="w-9 h-9 rounded-full bg-green-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-extrabold text-gray-900 leading-none">99+</div>
                  <div class="text-xs text-gray-500 mt-0.5">Lighthouse score</div>
                </div>
              </div>

              <!-- Floating card — bottom left: load time -->
              <div class="absolute -bottom-2 left-2 bg-white rounded-xl shadow-xl px-3.5 py-2.5 border border-gray-100 flex items-center gap-2.5 float" style="animation-delay: 1.5s;" aria-hidden="true">
                <div class="w-9 h-9 rounded-full bg-brand-blue/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-extrabold text-gray-900 leading-none">&lt; 1s</div>
                  <div class="text-xs text-gray-500 mt-0.5">Page load time</div>
                </div>
              </div>
            </>

          ) : visualType === 'sms' ? (
            <>
              <div class="relative bg-white rounded-2xl shadow-2xl overflow-hidden">
                <!-- Messaging app header -->
                <div class="flex items-center gap-3 px-4 py-3 bg-gray-50 border-b border-gray-100">
                  <div class="w-8 h-8 rounded-full bg-gradient-to-br from-brand-blue to-brand-purple flex items-center justify-center text-white text-xs font-bold flex-shrink-0" aria-hidden="true">
                    RR
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-sm font-bold text-gray-900 leading-none">McAllen Roofing Co.</div>
                    <div class="text-xs text-gray-500 mt-0.5">Automated response · RankRGV</div>
                  </div>
                  <div class="flex-shrink-0 bg-green-100 text-green-700 text-xs font-semibold px-2 py-0.5 rounded-full">Live</div>
                </div>

                <!-- Chat thread -->
                <div class="px-4 py-4 space-y-3 bg-gray-50/40" aria-label="Example automated text conversation">
                  <!-- Missed call indicator -->
                  <div class="flex justify-center" aria-hidden="true">
                    <div class="flex items-center gap-1.5 bg-gray-100 rounded-full px-3 py-1.5">
                      <svg class="w-3 h-3 text-red-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M16.5 1.5a14.5 14.5 0 010 21M7.5 1.5a14.5 14.5 0 000 21M3 16.5l1.5-1.5M21 16.5l-1.5-1.5" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z" />
                      </svg>
                      <span class="text-xs text-gray-500 font-medium">Missed call · 3:14 PM</span>
                    </div>
                  </div>

                  <!-- Outbound auto-text -->
                  <div class="flex justify-end">
                    <div class="max-w-[82%] bg-brand-blue text-white text-xs rounded-2xl rounded-tr-sm px-3.5 py-2.5 leading-relaxed shadow-sm">
                      Hey! We missed your call — what can we help you with?
                      <div class="text-white/60 text-xs mt-1.5 text-right">3:14 PM · 28 sec later</div>
                    </div>
                  </div>

                  <!-- Inbound customer reply -->
                  <div class="flex justify-start">
                    <div class="max-w-[82%] bg-white border border-gray-200 text-gray-800 text-xs rounded-2xl rounded-tl-sm px-3.5 py-2.5 leading-relaxed shadow-sm">
                      Need a quote for a roof repair in McAllen
                      <div class="text-gray-400 text-xs mt-1.5">3:16 PM</div>
                    </div>
                  </div>

                  <!-- Outbound follow-up -->
                  <div class="flex justify-end">
                    <div class="max-w-[82%] bg-brand-blue text-white text-xs rounded-2xl rounded-tr-sm px-3.5 py-2.5 leading-relaxed shadow-sm">
                      Perfect! Can you share your address? Someone will call you within the hour.
                      <div class="text-white/60 text-xs mt-1.5 text-right">3:16 PM · Auto-sent</div>
                    </div>
                  </div>

                  <!-- Lead rescued status -->
                  <div class="flex justify-center" aria-hidden="true">
                    <div class="flex items-center gap-1.5 bg-green-100 rounded-full px-3 py-1.5">
                      <svg class="w-3 h-3 text-green-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span class="text-xs text-green-700 font-semibold">Lead rescued in 2 minutes</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Floating card — top right: response time -->
              <div class="absolute -top-2 right-2 bg-white rounded-xl shadow-xl px-3.5 py-2.5 border border-gray-100 flex items-center gap-2.5 float" aria-hidden="true">
                <div class="w-9 h-9 rounded-full bg-amber-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-extrabold text-gray-900 leading-none">28 sec</div>
                  <div class="text-xs text-gray-500 mt-0.5">Auto-response</div>
                </div>
              </div>

              <!-- Floating card — bottom left: lead saved -->
              <div class="absolute -bottom-2 left-2 bg-white rounded-xl shadow-xl px-3.5 py-2.5 border border-gray-100 flex items-center gap-2.5 float" style="animation-delay: 1.5s;" aria-hidden="true">
                <div class="w-9 h-9 rounded-full bg-green-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-extrabold text-gray-900 leading-none">Lead saved</div>
                  <div class="text-xs text-gray-500 mt-0.5">vs. calling a competitor</div>
                </div>
              </div>
            </>

          ) : (
            <>
              <div class="relative bg-white rounded-2xl shadow-2xl overflow-hidden">
                <!-- Browser chrome -->
                <div class="flex items-center gap-1.5 px-4 py-3 bg-gray-50 border-b border-gray-100">
                  <div class="w-3 h-3 rounded-full bg-red-400" aria-hidden="true"></div>
                  <div class="w-3 h-3 rounded-full bg-yellow-400" aria-hidden="true"></div>
                  <div class="w-3 h-3 rounded-full bg-green-400" aria-hidden="true"></div>
                  <div class="flex-1 mx-3 bg-white border border-gray-200 rounded-full px-3 py-1 flex items-center gap-2">
                    <svg class="w-3 h-3 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <span class="text-xs text-gray-600">{mockupQuery}</span>
                  </div>
                </div>

                <!-- Map area -->
                <div
                  class="relative h-28 overflow-hidden"
                  style="background: linear-gradient(135deg, #d1fae5 0%, #bfdbfe 100%);"
                  aria-hidden="true"
                >
                  <div class="absolute inset-0 opacity-20" style="background-image: linear-gradient(#94a3b8 1px, transparent 1px), linear-gradient(90deg, #94a3b8 1px, transparent 1px); background-size: 36px 36px;"></div>
                  <div class="absolute top-4 left-[28%] flex flex-col items-center">
                    <div class="w-7 h-7 rounded-full bg-brand-blue border-2 border-white shadow-lg flex items-center justify-center text-white text-xs font-bold">1</div>
                    <div class="w-1.5 h-2 bg-brand-blue rounded-b-full"></div>
                  </div>
                  <div class="absolute top-9 left-[52%] flex flex-col items-center">
                    <div class="w-5 h-5 rounded-full bg-gray-400 border-2 border-white shadow flex items-center justify-center text-white text-xs font-bold">2</div>
                    <div class="w-1 h-1.5 bg-gray-400 rounded-b-full"></div>
                  </div>
                  <div class="absolute top-14 left-[68%] flex flex-col items-center">
                    <div class="w-5 h-5 rounded-full bg-gray-400 border-2 border-white shadow flex items-center justify-center text-white text-xs font-bold">3</div>
                    <div class="w-1 h-1.5 bg-gray-400 rounded-b-full"></div>
                  </div>
                </div>

                <!-- Local pack results -->
                <div class="divide-y divide-gray-100">
                  <div class="flex items-center gap-3 px-4 py-3.5 bg-blue-50/70">
                    <div class="w-7 h-7 rounded-full bg-brand-blue flex items-center justify-center text-white text-xs font-bold flex-shrink-0">1</div>
                    <div class="flex-1 min-w-0">
                      <div class="text-sm font-bold text-brand-blue">Your Business Here</div>
                      <div class="flex items-center gap-1 mt-0.5">
                        <span class="text-amber-400 text-xs">★★★★★</span>
                        <span class="text-xs text-gray-500">5.0 · {mockupCategory}</span>
                      </div>
                    </div>
                    <span class="flex-shrink-0 text-xs bg-green-100 text-green-700 font-bold px-2 py-0.5 rounded-full">#1</span>
                  </div>
                  <div class="flex items-center gap-3 px-4 py-3 opacity-40">
                    <div class="w-6 h-6 rounded-full bg-gray-300 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">2</div>
                    <div class="flex-1 min-w-0">
                      <div class="text-sm font-medium text-gray-600">Competitor A</div>
                      <div class="text-xs text-gray-400">★★★★ 4.1 (19) · HVAC</div>
                    </div>
                  </div>
                  <div class="flex items-center gap-3 px-4 py-3 opacity-20">
                    <div class="w-6 h-6 rounded-full bg-gray-300 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">3</div>
                    <div class="flex-1 min-w-0">
                      <div class="text-sm font-medium text-gray-600">Competitor B</div>
                      <div class="text-xs text-gray-400">★★★ 3.8 (7) · HVAC</div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Floating card — top right: traffic growth -->
              <div class="absolute -top-2 right-2 bg-white rounded-xl shadow-xl px-3.5 py-2.5 border border-gray-100 flex items-center gap-2.5 float" aria-hidden="true">
                <div class="w-9 h-9 rounded-full bg-green-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-extrabold text-gray-900 leading-none">+312%</div>
                  <div class="text-xs text-gray-500 mt-0.5">Google traffic</div>
                </div>
              </div>

              <!-- Floating card — bottom left: time to rank -->
              <div class="absolute -bottom-2 left-2 bg-white rounded-xl shadow-xl px-3.5 py-2.5 border border-gray-100 flex items-center gap-2.5 float" style="animation-delay: 1.5s;" aria-hidden="true">
                <div class="w-9 h-9 rounded-full bg-brand-blue/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-extrabold text-gray-900 leading-none">90 days</div>
                  <div class="text-xs text-gray-500 mt-0.5">to first rankings</div>
                </div>
              </div>
            </>
          )}
        </div>
      )}

    </div>
  </div>
</section>
