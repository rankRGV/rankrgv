---
import { site } from '@/config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: object | object[];
  geoRegion?: string;
  geoPlacename?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = site.defaultOgImage,
  noindex = false,
  schema,
  geoRegion = 'US-TX',
  geoPlacename = 'McAllen, Texas',
} = Astro.props;

const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, site.url).href;

// Normalize schema to always be an array
const schemas = schema
  ? Array.isArray(schema)
    ? schema
    : [schema]
  : [];
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />

<!-- Primary meta -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Geo targeting -->
<meta name="geo.region" content={geoRegion} />
<meta name="geo.placename" content={geoPlacename} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_US" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Favicon -->
<link rel="icon" type="image/png" href="/faviconRankRGV.png" />
<link rel="apple-touch-icon" href="/faviconRankRGV.png" />

<!-- Inter font is self-hosted via @fontsource-variable/inter (no external request) -->

<!-- JSON-LD Schema -->
{schemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
