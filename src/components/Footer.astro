---
import { graderHref, site } from '@/config/site';
import { services } from '@/data/services';
import { serviceAreas } from '@/data/serviceAreas';

interface Props {
  lang?: 'en' | 'es';
}
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const graderUrl = graderHref('footer', lang);

const footerServiceLinkBySlug = {
  'local-seo': {
    href: es ? '/es/seo-local/' : '/local-seo/',
    label: es ? 'SEO Local y Google Maps' : 'Local SEO & Google Maps',
  },
  'web-design': {
    href: '/web-design/',
    label: es ? 'Diseño Web' : 'Web Design',
  },
  'ads-management': {
    href: '/ads-management/',
    label: es ? 'Google y Meta Ads' : 'Google & Meta Ads',
  },
  'business-automation': {
    href: '/business-automation/',
    label: es ? 'Automatización' : 'Business Automation',
  },
} as const;

function getFooterServiceLink(slug: string, fallbackLabel: string) {
  const serviceLink = footerServiceLinkBySlug[slug as keyof typeof footerServiceLinkBySlug];
  return serviceLink ?? { href: `/${slug}/`, label: fallbackLabel };
}
---

<footer class="bg-bg-dark text-white/60 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">

      <!-- Brand column -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-block mb-4 no-underline">
          <span class="text-2xl font-extrabold text-white tracking-tight">
            Rank<span class="gradient-text">RGV</span>
          </span>
        </a>
        <p class="text-sm leading-relaxed mb-6">
          {es ? 'SEO local y marketing digital para negocios del Valle. Te ayudamos a que te encuentren, te llamen y crezcas.' : 'Local SEO & digital marketing for Rio Grande Valley businesses. We help you get found, get called, and grow.'}
        </p>
        <div class="flex flex-wrap gap-3">
          <!-- Facebook -->
          <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" class="text-white/40 hover:text-white transition-colors" aria-label="RankRGV on Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <!-- Instagram -->
          <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="text-white/40 hover:text-white transition-colors" aria-label="RankRGV on Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
          <!-- X / Twitter -->
          <a href={site.social.twitter} target="_blank" rel="noopener noreferrer" class="text-white/40 hover:text-white transition-colors" aria-label="RankRGV on X">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.741l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <!-- LinkedIn -->
          <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" class="text-white/40 hover:text-white transition-colors" aria-label="RankRGV on LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <!-- YouTube -->
          <a href={site.social.youtube} target="_blank" rel="noopener noreferrer" class="text-white/40 hover:text-white transition-colors" aria-label="RankRGV on YouTube">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.495 6.205a3.007 3.007 0 00-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 00.527 6.205a31.247 31.247 0 00-.522 5.805 31.247 31.247 0 00.522 5.783 3.007 3.007 0 002.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 002.088-2.088 31.247 31.247 0 00.5-5.783 31.247 31.247 0 00-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/>
            </svg>
          </a>
          <!-- Google Business Profile -->
          <a href={site.social.gbp} target="_blank" rel="noopener noreferrer" class="text-white/40 hover:text-white transition-colors" aria-label="RankRGV on Google Business">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">{es ? 'Servicios' : 'Services'}</h3>
        <ul class="space-y-2">
          {services.map((s) => (
            <li>
              {(() => {
                const serviceLink = getFooterServiceLink(s.slug, s.name);
                return (
                  <a
                    href={serviceLink.href}
                    class="text-sm text-white/60 hover:text-white transition-colors no-underline"
                  >
                    {serviceLink.label}
                  </a>
                );
              })()}
            </li>
          ))}
          <li class="pt-2">
            <a href={graderUrl} class="text-sm text-brand-blue-light hover:text-white transition-colors no-underline font-medium">
              {es ? 'Califica Tu Negocio Gratis →' : 'Get My Free Business Grade →'}
            </a>
          </li>
        </ul>
      </div>

      <!-- Service Areas -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">{es ? 'Áreas de Servicio' : 'Service Areas'}</h3>
        <ul class="space-y-2">
          {serviceAreas.map((a) => (
            <li>
              <a
                href={es ? `/es/areas-de-servicio/${a.slug}/` : `/service-areas/${a.slug}/`}
                class="text-sm text-white/60 hover:text-white transition-colors no-underline"
              >
                {a.name}, TX
              </a>
            </li>
          ))}
          <li class="pt-2">
            <a href={es ? '/es/areas-de-servicio/' : '/service-areas/'} class="text-sm text-brand-blue-light hover:text-white transition-colors no-underline font-medium">
              {es ? 'Todas las Áreas →' : 'All Service Areas →'}
            </a>
          </li>
        </ul>
      </div>

      <!-- Company + Contact -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">{es ? 'Empresa' : 'Company'}</h3>
        <ul class="space-y-2 mb-6">
          <li><a href="/about/" class="text-sm text-white/60 hover:text-white transition-colors no-underline">{es ? 'Nosotros' : 'About'}</a></li>
          <li><a href="/blog/" class="text-sm text-white/60 hover:text-white transition-colors no-underline">Blog</a></li>
          <li><a href="/pricing/" class="text-sm text-white/60 hover:text-white transition-colors no-underline">{es ? 'Precios' : 'Pricing'}</a></li>
          <li><a href="/contact/" class="text-sm text-white/60 hover:text-white transition-colors no-underline">{es ? 'Contacto' : 'Contact'}</a></li>
          <li><a href="/privacy-policy/" class="text-sm text-white/60 hover:text-white transition-colors no-underline">{es ? 'Privacidad' : 'Privacy Policy'}</a></li>
          <li><a href="/terms/" class="text-sm text-white/60 hover:text-white transition-colors no-underline">{es ? 'Términos' : 'Terms of Service'}</a></li>
        </ul>
        <div class="space-y-2">
          <a href={site.phoneHref} class="flex items-center gap-2 text-sm text-white/60 hover:text-white transition-colors no-underline">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {site.phone}
          </a>
          <a href={`mailto:${site.email}`} class="flex items-center gap-2 text-sm text-white/60 hover:text-white transition-colors no-underline">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {site.email}
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-white/60">
        © {new Date().getFullYear()} {site.name}. {es ? 'Todos los derechos reservados. Atendemos el Valle del Río Grande, Texas.' : 'All rights reserved. Serving the Rio Grande Valley, Texas.'}
      </p>
      <p class="text-xs text-white/50">
        McAllen · Brownsville · Edinburg · Harlingen · Mission · Pharr
      </p>
    </div>
  </div>
</footer>
