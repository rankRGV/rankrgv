---
import { site } from '@/config/site';

interface Props {
  headline?: string;
  subheadline?: string;
  submitLabel?: string;
}

const {
  headline = 'Get your free SEO audit',
  subheadline = "Tell us about your business and we'll show you exactly what keyword opportunities you're missing.",
  submitLabel = 'Send My Free Audit Request',
} = Astro.props;
---

<div class="bg-bg rounded-2xl border border-border p-8 sm:p-10">
  <h2 class="text-2xl font-bold text-text mb-2">{headline}</h2>
  <p class="text-text-muted mb-6">{subheadline}</p>

  <!-- Plan interest banner (hidden by default; JS shows it when ?plan= is in the URL) -->
  <div
    id="plan-selection-banner"
    class="hidden items-center gap-3 bg-brand-blue/10 border border-brand-blue/20 rounded-xl px-4 py-3 mb-6"
  >
    <svg class="w-4 h-4 text-brand-blue flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span class="text-sm text-text">Inquiring about: <strong id="plan-banner-text" class="text-brand-blue"></strong></span>
  </div>

  <form
    action={`https://submit-form.com/${site.formsparkId}`}
    method="POST"
    id="contact-form"
    class="space-y-5"
    novalidate
  >
    <!-- Honeypot spam prevention -->
    <input type="checkbox" name="_honeypot" style="display:none" tabindex="-1" autocomplete="off" />
    <!-- Redirect after success -->
    <input type="hidden" name="_redirect" value={`${site.url}/thank-you/`} />
    <!-- Plan interest from URL params — populated by the script below -->
    <input type="hidden" id="plan_interest" name="plan_interest" value="" />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="name" class="block text-sm font-medium text-text mb-1.5">Your name <span class="text-red-500">*</span></label>
        <input
          type="text"
          id="name"
          name="name"
          required
          autocomplete="name"
          class="w-full rounded-lg border border-border bg-bg-surface px-4 py-3 text-text placeholder:text-text-muted/60 focus:outline-none focus:ring-2 focus:ring-brand-blue focus:border-transparent transition-shadow duration-150"
          placeholder="Maria Gonzalez"
        />
      </div>
      <div>
        <label for="business" class="block text-sm font-medium text-text mb-1.5">Business name <span class="text-red-500">*</span></label>
        <input
          type="text"
          id="business"
          name="business"
          required
          class="w-full rounded-lg border border-border bg-bg-surface px-4 py-3 text-text placeholder:text-text-muted/60 focus:outline-none focus:ring-2 focus:ring-brand-blue focus:border-transparent transition-shadow duration-150"
          placeholder="Rio Grande Family Clinic"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="email" class="block text-sm font-medium text-text mb-1.5">Email <span class="text-red-500">*</span></label>
        <input
          type="email"
          id="email"
          name="email"
          required
          autocomplete="email"
          class="w-full rounded-lg border border-border bg-bg-surface px-4 py-3 text-text placeholder:text-text-muted/60 focus:outline-none focus:ring-2 focus:ring-brand-blue focus:border-transparent transition-shadow duration-150"
          placeholder="maria@example.com"
        />
      </div>
      <div>
        <label for="phone" class="block text-sm font-medium text-text mb-1.5">Phone</label>
        <input
          type="tel"
          id="phone"
          name="phone"
          autocomplete="tel"
          class="w-full rounded-lg border border-border bg-bg-surface px-4 py-3 text-text placeholder:text-text-muted/60 focus:outline-none focus:ring-2 focus:ring-brand-blue focus:border-transparent transition-shadow duration-150"
          placeholder="956-555-0100"
        />
      </div>
    </div>

    <!-- SMS Consent Block -->
    <div class="rounded-xl border border-brand-blue/20 bg-brand-blue/5 px-5 py-4 space-y-3">
      <label class="flex items-start gap-3 cursor-pointer group">
        <div class="relative mt-0.5 flex-shrink-0 w-5 h-5">
          <input
            type="checkbox"
            id="sms_consent"
            name="sms_consent"
            value="yes"
            class="absolute inset-0 opacity-0 w-full h-full cursor-pointer z-10"
            aria-label="Consent to receive SMS messages from RankRGV"
          />
          <div id="sms-checkbox-visual" class="w-5 h-5 rounded border-2 border-border bg-bg-surface transition-colors duration-150 group-hover:border-brand-blue/60 flex items-center justify-center">
            <svg id="sms-checkmark" class="w-3 h-3 text-white hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
        </div>
        <span class="text-sm font-medium text-text leading-snug">
          Yes — allow RankRGV's assistant to text me answers and updates about my request.
        </span>
      </label>
      <p class="text-xs text-text-muted leading-relaxed pl-8">
        By providing your phone number you consent to receive SMS messages from RankRGV related to your inquiry or requested services. Message frequency may vary. Message and data rates may apply. Reply <strong>STOP</strong> to opt out or <strong>HELP</strong> for assistance. Your mobile information will not be sold or shared with third parties for promotional or marketing purposes.
      </p>
    </div>

    <div>
      <label for="city" class="block text-sm font-medium text-text mb-1.5">City <span class="text-red-500">*</span></label>
      <select
        id="city"
        name="city"
        required
        class="w-full rounded-lg border border-border bg-bg-surface px-4 py-3 text-text focus:outline-none focus:ring-2 focus:ring-brand-blue focus:border-transparent transition-shadow duration-150"
      >
        <option value="">Select your city…</option>
        <option value="McAllen">McAllen</option>
        <option value="Brownsville">Brownsville</option>
        <option value="Edinburg">Edinburg</option>
        <option value="Harlingen">Harlingen</option>
        <option value="Mission">Mission</option>
        <option value="Pharr">Pharr</option>
        <option value="Other RGV">Other RGV city</option>
      </select>
    </div>

    <div>
      <label for="website" class="block text-sm font-medium text-text mb-1.5">Website URL</label>
      <input
        type="url"
        id="website"
        name="website"
        autocomplete="url"
        class="w-full rounded-lg border border-border bg-bg-surface px-4 py-3 text-text placeholder:text-text-muted/60 focus:outline-none focus:ring-2 focus:ring-brand-blue focus:border-transparent transition-shadow duration-150"
        placeholder="https://yoursite.com"
      />
    </div>

    <div>
      <label for="message" class="block text-sm font-medium text-text mb-1.5">What's your biggest challenge right now?</label>
      <textarea
        id="message"
        name="message"
        rows="4"
        class="w-full rounded-lg border border-border bg-bg-surface px-4 py-3 text-text placeholder:text-text-muted/60 focus:outline-none focus:ring-2 focus:ring-brand-blue focus:border-transparent transition-shadow duration-150 resize-none"
        placeholder="We don't show up on Google, our website is old, leads aren't calling back…"
      ></textarea>
    </div>

    <button
      type="submit"
      class="w-full btn-primary justify-center py-4 text-base"
    >
      {submitLabel}
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </button>

    <p class="text-xs text-text-muted text-center leading-relaxed">
      No spam, no obligations. Just a straight answer about your opportunities.<br />
      <a href="/privacy-policy/" class="text-brand-blue hover:underline">Privacy Policy</a>
      <span class="mx-1.5 opacity-40">·</span>
      <a href="/terms/" class="text-brand-blue hover:underline">Terms of Service</a>
    </p>
  </form>
</div>

<script>
  (() => {
    // Fire a GA4 lead event before the form navigates away to FormSpark.
    // Registered on document in the capture phase — GA4's own Enhanced
    // Measurement auto-listener sits on document too and calls
    // stopPropagation(), which would swallow a listener attached directly
    // to the form before it ever ran. A sibling capture listener on the
    // same node still fires regardless.
    // transport_type: 'beacon' so the hit is queued via sendBeacon and
    // survives the immediate page unload from the form POST.
    document.addEventListener('submit', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target || target.id !== 'contact-form') return;
      if (typeof (window as any).gtag !== 'function') return;
      (window as any).gtag('event', 'generate_lead', {
        event_category: 'engagement',
        event_label: (document.getElementById('plan_interest') as HTMLInputElement | null)?.value || 'contact_form',
        page_path: window.location.pathname,
        transport_type: 'beacon',
      });
    }, true);
  })();

  (() => {
    // SMS consent checkbox visual state
    const smsInput = document.getElementById('sms_consent') as HTMLInputElement | null;
    const smsVisual = document.getElementById('sms-checkbox-visual');
    const smsCheck = document.getElementById('sms-checkmark');
    if (smsInput && smsVisual && smsCheck) {
      smsInput.addEventListener('change', () => {
        if (smsInput.checked) {
          smsVisual.classList.add('bg-brand-blue', 'border-brand-blue');
          smsVisual.classList.remove('border-border');
          smsCheck.classList.remove('hidden');
        } else {
          smsVisual.classList.remove('bg-brand-blue', 'border-brand-blue');
          smsVisual.classList.add('border-border');
          smsCheck.classList.add('hidden');
        }
      });
    }
  })();

  (() => {
    const params = new URLSearchParams(window.location.search);
    const plan = params.get('plan');
    const service = params.get('service');
    if (!plan) return;

    const serviceLabels: Record<string, string> = {
      'local-seo': 'Local SEO',
      'web-design': 'Web Design',
      'gbp-management': 'GBP Management',
      'business-automation': 'Business Automation',
    };
    const svcLabel = (service && serviceLabels[service]) ? ' — ' + serviceLabels[service] : '';
    const displayText = plan + svcLabel;

    const field = document.getElementById('plan_interest') as HTMLInputElement | null;
    if (field) field.value = displayText;

    const banner = document.getElementById('plan-selection-banner');
    const text = document.getElementById('plan-banner-text');
    if (banner && text) {
      text.textContent = displayText;
      banner.classList.remove('hidden');
      banner.classList.add('flex');
    }
  })();
</script>
