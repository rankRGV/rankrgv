---
import { site } from '@/config/site';
import SEOHead from '@/components/SEOHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import StickyCallCTA from '@/components/StickyCallCTA.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogLocale?: string;
  noindex?: boolean;
  schema?: object | object[];
  geoRegion?: string;
  geoPlacename?: string;
  lang?: 'en' | 'es';
  hreflang?: { lang: string; href: string }[];
}

const {
  title,
  description,
  canonical,
  ogImage = site.defaultOgImage,
  ogLocale,
  noindex = false,
  schema,
  geoRegion,
  geoPlacename,
  lang = 'en',
  hreflang,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.url).href;
const resolvedOgLocale = ogLocale ?? (lang === 'es' ? 'es_MX' : 'en_US');
---

<!doctype html>
<html lang={lang}>
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonicalUrl}
      ogImage={ogImage}
      ogLocale={resolvedOgLocale}
      noindex={noindex}
      schema={schema}
      geoRegion={geoRegion}
      geoPlacename={geoPlacename}
    />
    {hreflang?.map((h) => (
      <link rel="alternate" hreflang={h.lang} href={h.href} />
    ))}
    <slot name="head" />
  </head>
  <body class="bg-bg text-text font-sans antialiased">
    <Header lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
    <StickyCallCTA />

    <!-- GA4 — only loads when ga4Id is set -->
    {site.ga4Id && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`}
        ></script>
        <script is:inline define:vars={{ ga4Id: site.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', ga4Id);
        </script>

        <!-- Click-to-call tracking — every tel: link fires a GA4 event -->
        <script is:inline>
          document.addEventListener('click', function (e) {
            var link = e.target.closest('a[href^="tel:"]');
            if (!link) return;
            gtag('event', 'phone_click', {
              event_category: 'engagement',
              event_label: link.href,
              page_path: window.location.pathname,
              transport_type: 'beacon',
            });
          });
        </script>
      </>
    )}

    <!-- Scroll reveal — Intersection Observer -->
    <script is:inline>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
