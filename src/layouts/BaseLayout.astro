---
import { site } from '@/config/site';
import SEOHead from '@/components/SEOHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import StickyCallCTA from '@/components/StickyCallCTA.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogLocale?: string;
  noindex?: boolean;
  schema?: object | object[];
  geoRegion?: string;
  geoPlacename?: string;
  lang?: 'en' | 'es';
  hreflang?: { lang: string; href: string }[];
  /** Drop the site header, footer and sticky call bar (private client pages). */
  bare?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = site.defaultOgImage,
  ogLocale,
  noindex = false,
  schema,
  geoRegion,
  geoPlacename,
  lang = 'en',
  hreflang,
  bare = false,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.url).href;
const resolvedOgLocale = ogLocale ?? (lang === 'es' ? 'es_MX' : 'en_US');
---

<!doctype html>
<html lang={lang}>
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonicalUrl}
      ogImage={ogImage}
      ogLocale={resolvedOgLocale}
      noindex={noindex}
      schema={schema}
      geoRegion={geoRegion}
      geoPlacename={geoPlacename}
    />
    {hreflang?.map((h) => (
      <link rel="alternate" hreflang={h.lang} href={h.href} />
    ))}
    <slot name="head" />
  </head>
  <body class="bg-bg text-text font-sans antialiased">
    {!bare && <Header lang={lang} />}
    <main id="main-content">
      <slot />
    </main>
    {!bare && <Footer lang={lang} />}
    {!bare && <StickyCallCTA />}

    <!-- PostHog (project token is a public client key) -->
    <script is:inline>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      if (!/^(localhost|127\.0\.0\.1)$/.test(location.hostname)) {
        window.posthog.init('phc_B9F38PB4aMzuqJusDWUpoSvNgR7XpVD6HK2jkaUp6v65', {
          api_host: 'https://us.i.posthog.com',
          person_profiles: 'identified_only',
        });
      }
    </script>

    <!-- GA4 — only loads when ga4Id is set -->
    {site.ga4Id && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`}
        ></script>
        <script is:inline define:vars={{ ga4Id: site.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          // Assigned directly to window (not a bare function declaration) —
          // Astro's production build scopes is:inline scripts such that a
          // plain `function gtag(){}` never becomes a real window property,
          // so later script blocks calling gtag() throw a silent
          // ReferenceError that dies inside the event listener. Explicit
          // window.gtag assignment survives that scoping regardless.
          window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', ga4Id);
        </script>

        <!-- Primary conversion tracking -->
        <script is:inline>
          document.addEventListener('click', function (e) {
            var link = e.target.closest('a');
            if (!link) return;

            if (link.href.startsWith('tel:')) {
              window.gtag('event', 'phone_click', {
                event_category: 'engagement',
                event_label: link.href,
                page_path: window.location.pathname,
                transport_type: 'beacon',
              });
              return;
            }

            if (!link.href.startsWith('https://grader.rankrgv.com')) return;
            window.gtag('event', 'grader_click', {
              event_category: 'engagement',
              event_label: link.href,
              link_text: link.textContent.trim(),
              page_path: window.location.pathname,
              transport_type: 'beacon',
            });
          });
        </script>
      </>
    )}

    <!-- Scroll reveal — Intersection Observer -->
    <script is:inline>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0, rootMargin: '0px 0px -10% 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
