---
import { site } from '@/config/site';
import SEOHead from '@/components/SEOHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import StickyCallCTA from '@/components/StickyCallCTA.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogLocale?: string;
  noindex?: boolean;
  schema?: object | object[];
  geoRegion?: string;
  geoPlacename?: string;
  lang?: 'en' | 'es';
  hreflang?: { lang: string; href: string }[];
  /** Drop the site header, footer and sticky call bar (private client pages). */
  bare?: boolean;
  /** Drop only the mobile sticky bar (homepage: the hero and final section already offer both actions). */
  hideSticky?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = site.defaultOgImage,
  ogLocale,
  noindex = false,
  schema,
  geoRegion,
  geoPlacename,
  lang = 'en',
  hreflang,
  bare = false,
  hideSticky = false,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.url).href;
const resolvedOgLocale = ogLocale ?? (lang === 'es' ? 'es_MX' : 'en_US');
---

<!doctype html>
<html lang={lang}>
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonicalUrl}
      ogImage={ogImage}
      ogLocale={resolvedOgLocale}
      noindex={noindex}
      schema={schema}
      geoRegion={geoRegion}
      geoPlacename={geoPlacename}
    />
    {hreflang?.map((h) => (
      <link rel="alternate" hreflang={h.lang} href={h.href} />
    ))}
    <slot name="head" />
  </head>
  <body class="bg-bg text-text font-sans antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-brand-blue focus:shadow-lg">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    {!bare && <Header lang={lang} />}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer lang={lang} />}
    {!bare && !hideSticky && <StickyCallCTA lang={lang} />}

    <!-- GA4 loads after the page has painted (window load + idle), so it
         doesn't compete with the hero for bandwidth on mobile. Calls made
         before then are queued in window.dataLayer. -->
    <script is:inline>
      window.__afterLoad = function (fn) {
        var go = function () { 'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 2000 }) : setTimeout(fn, 1); };
        if (document.readyState === 'complete') go(); else window.addEventListener('load', go, { once: true });
      };
    </script>

    <!-- Meta pixel. Same idea as GA4: the fbq queue exists right away, the
         script itself loads after the page has painted, and only the real
         site reports (no localhost or Vercel previews). -->
    {site.metaPixelId && (
      <script is:inline define:vars={{ metaPixelId: site.metaPixelId }}>
        if (/(^|\.)rankrgv\.com$/.test(location.hostname)) {
          var n = window.fbq = window.fbq || function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          };
          if (!window._fbq) window._fbq = n;
          n.push = n; n.loaded = true; n.version = '2.0'; n.queue = n.queue || [];
          fbq('init', metaPixelId);
          fbq('track', 'PageView');
          window.__afterLoad(function () {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://connect.facebook.net/en_US/fbevents.js';
            document.head.appendChild(s);
          });
        }
      </script>
    )}

    <!-- GA4 — only loads when ga4Id is set -->
    {site.ga4Id && (
      <>
        <script is:inline define:vars={{ ga4Id: site.ga4Id }}>
          window.__afterLoad(function () {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
            document.head.appendChild(s);
          });

          window.dataLayer = window.dataLayer || [];
          // Assigned directly to window (not a bare function declaration) —
          // Astro's production build scopes is:inline scripts such that a
          // plain `function gtag(){}` never becomes a real window property,
          // so later script blocks calling gtag() throw a silent
          // ReferenceError that dies inside the event listener. Explicit
          // window.gtag assignment survives that scoping regardless.
          window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
          gtag('js', new Date());
          // Only the real site reports. Localhost and Vercel previews stay out of GA4.
          if (/(^|\.)rankrgv\.com$/.test(location.hostname)) gtag('config', ga4Id);
        </script>

        <!-- Primary conversion tracking -->
        <script is:inline>
          document.addEventListener('click', function (e) {
            var link = e.target.closest('a');
            if (!link) return;

            if (link.href.startsWith('tel:')) {
              window.gtag('event', 'phone_click', {
                event_category: 'engagement',
                event_label: link.href,
                page_path: window.location.pathname,
                transport_type: 'beacon',
              });
              return;
            }

            // Stripe payment links: count the checkout start, and leave a note so
            // /welcome/ (Stripe's after-payment redirect) can count the purchase once.
            if (link.href.startsWith('https://buy.stripe.com/')) {
              window.gtag('event', 'begin_checkout', {
                event_category: 'ecommerce',
                event_label: link.href,
                link_text: link.textContent.trim(),
                page_path: window.location.pathname,
                transport_type: 'beacon',
              });
              try {
                sessionStorage.setItem('rankrgv_pending_checkout', JSON.stringify({
                  link: link.href, path: window.location.pathname, t: Date.now(),
                }));
              } catch (err) {}
              if (window.fbq) window.fbq('track', 'InitiateCheckout', { currency: 'USD' });
              return;
            }

            if (!link.href.startsWith('https://grader.rankrgv.com')) return;
            window.gtag('event', 'grader_click', {
              event_category: 'engagement',
              event_label: link.href,
              link_text: link.textContent.trim(),
              page_path: window.location.pathname,
              transport_type: 'beacon',
            });
          });

          // Grade forms (homepage hero etc.) submit as GET to the grader, not as a link,
          // so count them as the same grader_click event.
          document.addEventListener('submit', function (e) {
            var form = e.target;
            if (!form.action || !form.action.startsWith('https://grader.rankrgv.com')) return;
            var content = form.querySelector('input[name="utm_content"]');
            window.gtag('event', 'grader_click', {
              event_category: 'engagement',
              event_label: form.action,
              link_text: 'form: ' + (content ? content.value : 'unknown'),
              page_path: window.location.pathname,
              transport_type: 'beacon',
            });
          });
        </script>
      </>
    )}

    <!-- Scroll reveal — Intersection Observer -->
    <script is:inline>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0, rootMargin: '0px 0px -10% 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
