---
import { site } from '@/config/site';
import SEOHead from '@/components/SEOHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import StickyCallCTA from '@/components/StickyCallCTA.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: object | object[];
  geoRegion?: string;
  geoPlacename?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = site.defaultOgImage,
  noindex = false,
  schema,
  geoRegion,
  geoPlacename,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonicalUrl}
      ogImage={ogImage}
      noindex={noindex}
      schema={schema}
      geoRegion={geoRegion}
      geoPlacename={geoPlacename}
    />
  </head>
  <body class="bg-bg text-text font-sans antialiased">
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <StickyCallCTA />

    <!-- GA4 — only loads when ga4Id is set -->
    {site.ga4Id && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`}
        ></script>
        <script is:inline define:vars={{ ga4Id: site.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', ga4Id);
        </script>
      </>
    )}

    <!-- Scroll reveal — Intersection Observer -->
    <script is:inline>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
