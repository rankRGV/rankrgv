---
import ServiceLayout from '@/layouts/ServiceLayout.astro';
import Hero from '@/components/Hero.astro';
import TrustSignals from '@/components/TrustSignals.astro';
import HowWeWork from '@/components/HowWeWork.astro';
import Testimonials from '@/components/Testimonials.astro';
import PricingSection from '@/components/PricingSection.astro';
import FAQSection from '@/components/FAQSection.astro';
import CTASection from '@/components/CTASection.astro';
import ServiceAreaGrid from '@/components/ServiceAreaGrid.astro';
import { getServiceBySlug } from '@/data/services';
import {
  buildServiceSchema,
  buildFAQSchema,
  buildHowToSchema,
  buildBreadcrumbSchema,
  buildWebPageSchema,
} from '@/components/SchemaMarkup.astro';
import { site } from '@/config/site';

const service = getServiceBySlug('ads-management')!;

const faqs = [
  {
    question: 'How much should I spend on Google Ads in McAllen?',
    answer:
      "For most McAllen service businesses, the right starting range is usually $1,000 to $3,000 per month in ad spend. Enough to gather real data, see which searches convert, and build momentum without lighting money on fire. The exact number depends on your category, your margin, and how aggressive you want to be. We start with the search demand and cost-per-click in your market, then back into a budget that makes business sense.",
  },
  {
    question: "What's the difference between Google Ads and Meta Ads?",
    answer:
      "Google Ads captures existing demand. Someone is already searching for a roofer, attorney, HVAC company, or med spa and wants a solution now. Meta Ads creates demand and stays in front of people based on interests, behavior, and retargeting audiences. Google is usually the best first move for high-intent service leads. Meta becomes powerful when you want to stay visible, build demand, and retarget the traffic you're already generating.",
  },
  {
    question: 'Do you charge a percentage of ad spend?',
    answer:
      "No, not on standard small-business accounts. We use a flat monthly management fee so our incentives stay clean. If you increase budget, you should do it because the numbers justify it, not because your agency makes more when you spend more. For larger accounts over roughly $10,000 per month in ad spend, we usually scope custom pricing.",
  },
  {
    question: 'How long until I see results from Google Ads?',
    answer:
      "Paid search moves much faster than SEO. Most accounts start generating usable data within the first week and meaningful lead patterns within the first 30 days. That does not mean day-one perfection. The first month is where we learn which keywords, audiences, ads, and landing pages are actually producing calls and form fills. After that, optimization gets sharper quickly.",
  },
  {
    question: 'Can I run ads and SEO at the same time?',
    answer:
      "Yes, and for many RGV businesses that's the smartest setup. Ads generate leads now while SEO compounds over time. Paid search covers the short-term demand you need this month; SEO builds the long-term rankings that reduce your dependence on paid traffic later. Together, they create a much more stable acquisition system.",
  },
  {
    question: 'Do you write the ads or do I?',
    answer:
      "We handle the ad copy structure, testing plan, and revisions. Your input still matters because you know your offers, objections, and best customers better than anyone. The strongest campaigns combine your real sales language with our performance-testing process.",
  },
];

const howToSteps = [
  {
    name: 'Free Account Audit',
    text: 'We review your current campaigns, your landing pages, your tracking, and the competitive landscape in McAllen and the broader RGV. If you are not running ads yet, we start from market demand and keyword economics.',
  },
  {
    name: 'Campaign Strategy',
    text: 'We decide where budget should go first: Google Search, Meta lead generation, retargeting, or a cross-platform mix. You get a plan tied to actual business goals, not random channel activity.',
  },
  {
    name: 'Build & Launch',
    text: 'We structure campaigns, build ad groups and audiences, set up conversion tracking, and launch with clean account architecture so optimization later is based on real signal.',
  },
  {
    name: 'Optimize',
    text: 'Search terms, bids, placements, audiences, creative, and lead quality all get reviewed continuously. The goal is not more clicks. The goal is more qualified leads at a sustainable cost.',
  },
  {
    name: 'Scale',
    text: 'Once a campaign proves it can produce leads profitably, we expand what is working: better offers, more coverage, stronger retargeting, and more aggressive budget deployment.',
  },
  {
    name: 'Report',
    text: 'You get clear reporting on spend, conversions, cost per lead, and next actions. No vanity metrics, no inflated attribution, and no hiding behind dashboards.',
  },
];

const adsCards = [
  {
    name: 'Starter',
    price: '$350',
    period: '/month',
    description: 'Up to $1,000/mo in ad spend. Google Ads, Meta Ads, or both.',
    features: [
      'Campaign setup and structure',
      'Ongoing bid and audience optimization',
      'Conversion tracking setup',
      'Basic ad copy support',
      'Monthly performance report',
    ],
    cta: { label: 'Get started', href: '/get-started/?service=ads-management&plan=Starter' },
  },
  {
    name: 'Growth',
    badge: 'Most Popular',
    highlighted: true,
    price: '$500',
    period: '/month',
    description: '$1,000 to $3,000/mo in ad spend. Built to scale lead volume consistently.',
    features: [
      'Everything in Starter',
      'Multi-campaign management',
      'A/B ad copy testing',
      'Audience segmentation',
      'Retargeting setup',
      'Bi-weekly optimization check',
    ],
    cta: { label: 'Get started', href: '/get-started/?service=ads-management&plan=Growth' },
  },
  {
    name: 'Scale',
    price: '$750',
    period: '/month',
    description: '$3,000 to $10,000/mo in ad spend. Full account management for serious volume.',
    features: [
      'Everything in Growth',
      'Cross-platform strategy (Google + Meta)',
      'Landing page recommendations',
      'Advanced audience and lookalike targeting',
      'Weekly optimization check',
      'Priority support',
    ],
    cta: { label: "Let's talk scope", href: '/contact/' },
  },
];

const schema = [
  buildServiceSchema(
    'Google & Meta Ads Management McAllen TX',
    'RankRGV manages Google Ads and Meta Ads campaigns for Rio Grande Valley businesses. Flat monthly fees, conversion tracking, and lead-focused optimization.',
    site.areaServed
  ),
  buildFAQSchema(faqs),
  buildHowToSchema(
    'How Paid Ads Management Works for RGV Businesses',
    'The process RankRGV uses to launch, optimize, and scale Google Ads and Meta Ads for businesses across the Rio Grande Valley.',
    howToSteps
  ),
  buildBreadcrumbSchema([
    { label: 'Home', href: '/' },
    { label: 'Google & Meta Ads', href: '/ads-management/' },
  ]),
  buildWebPageSchema(service.titleTag, service.metaDescription, '/ads-management/'),
];
---

<ServiceLayout service={service} schema={schema}>
  <Hero
    badge="Google & Meta Ads Management"
    headline='More leads now.<br /><span class="gradient-text">While SEO keeps compounding.</span>'
    subheadline="Paid ads are how you create pipeline this month while your long-term rankings are still being built. We manage Google Ads and Meta Ads for RGV businesses on a flat monthly fee — no commissions, no setup fees, no long-term lock-in."
    secondaryCTA={{ label: 'See how it works', href: '#how-we-work' }}
    mockupQuery="google ads management mcallen tx"
    mockupCategory="Ads Management · McAllen, TX"
  />

  <TrustSignals
    stats={[
      { value: 'Flat Fee', label: 'Monthly management' },
      { value: '0%', label: 'Commissions on spend' },
      { value: 'Google + Meta', label: 'Platforms managed' },
      { value: '0', label: 'Long-term contracts' },
    ]}
  />

  <section class="py-20 bg-bg" aria-labelledby="what-is-paid-ads">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <h2 id="what-is-paid-ads" class="text-3xl sm:text-4xl font-bold text-text mb-6">
            Paid ads for the RGV: fast demand capture, cleaner than most agencies make it
          </h2>
          <p class="text-text-muted text-lg leading-relaxed mb-6">
            <strong>Google Ads</strong> captures high-intent searches already happening right now. <strong>Meta Ads</strong> helps you stay in front of the right people, generate demand, and retarget the traffic you are already paying for.
          </p>
          <p class="text-text-muted text-lg leading-relaxed mb-6">
            The part most agencies get wrong is incentives. Percentage-of-spend pricing rewards your agency when you spend more, whether the campaign improves or not. We use a flat monthly fee so the goal stays where it belongs: more qualified leads, better conversion tracking, and disciplined optimization.
          </p>
          <p class="text-text-muted text-lg leading-relaxed">
            The Rio Grande Valley is still a strong paid media market for small businesses. Search demand is real, competition is uneven, and cost-per-click is usually lower than major Texas metros. That window will not stay open forever.
          </p>
        </div>

        <div class="space-y-4 reveal reveal-delay-1">
          {[
            {
              title: 'Google Ads = high-intent demand',
              body: 'Best for people actively searching for your service right now. Ideal for home services, legal, medical, and any category where the phone call matters.',
            },
            {
              title: 'Meta Ads = attention + retargeting',
              body: 'Best for staying visible, nurturing interest, and following up with visitors who did not convert on first touch.',
            },
            {
              title: 'RGV economics are still favorable',
              body: 'Compared with Dallas, Austin, or Houston, many Valley categories still have lower click costs and weaker account competition.',
            },
          ].map(({ title, body }) => (
            <div class="p-5 rounded-xl border bg-bg-surface border-border">
              <div class="font-bold text-text mb-2">{title}</div>
              <div class="text-text-muted text-sm leading-relaxed">{body}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-bg-surface" aria-labelledby="ads-included">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-16">
        <h2 id="ads-included" class="text-3xl sm:text-4xl font-bold text-text mb-4 reveal">
          What is included in ads management
        </h2>
        <p class="text-text-muted text-lg reveal reveal-delay-1">
          The core work that actually improves lead flow and campaign efficiency.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            icon: 'M4 6h16M4 12h16M4 18h7',
            title: 'Campaign Setup',
            body: 'Clean account structure, campaign architecture, keyword grouping, and audience setup so performance data is usable from day one.',
          },
          {
            icon: 'M4 19h16M4 15l4-4 4 4 8-8',
            title: 'Ongoing Optimization',
            body: 'Bid strategy refinement, negative keywords, audience exclusions, placement cleanup, and budget shifts based on lead quality.',
          },
          {
            icon: 'M9 17v-6h13M9 17l-4-4m4 4l-4 4M15 7V3H2',
            title: 'Conversion Tracking',
            body: 'Call tracking, form tracking, and event setup so we know which campaigns create leads instead of guessing from clicks.',
          },
          {
            icon: 'M7 8h10M7 12h6m-6 4h10',
            title: 'Ad Copy Support',
            body: 'Offer framing, headline testing, and message iteration built around the angles your customers actually respond to.',
          },
          {
            icon: 'M12 8c-2.21 0-4 1.79-4 4m0 0c0 2.21 1.79 4 4 4m-4-4H4m8 4v4m0-12V4m0 12c2.21 0 4-1.79 4-4',
            title: 'Retargeting',
            body: 'Follow-up campaigns for site visitors and warm audiences so paid traffic has more than one chance to convert.',
          },
          {
            icon: 'M9 17v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
            title: 'Monthly Reporting',
            body: 'Spend, conversions, cost per lead, and next actions explained plainly so you can see if the account is actually working.',
          },
        ].map((item, i) => (
          <div class={`bg-bg rounded-2xl p-7 border border-border card-hover reveal reveal-delay-${Math.min(i + 1, 4)}`}>
            <div class="w-11 h-11 rounded-xl bg-brand-blue/10 flex items-center justify-center mb-5">
              <svg class="w-5 h-5 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
              </svg>
            </div>
            <h3 class="font-bold text-text mb-2">{item.title}</h3>
            <p class="text-text-muted text-sm leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <HowWeWork
    headline="How we run paid ads for RGV businesses"
    subheadline="Simple process, strict tracking, and optimization tied to lead quality."
    steps={howToSteps.map((s, i) => ({
      number: String(i + 1).padStart(2, '0'),
      title: s.name,
      body: s.text,
    }))}
  />

  <section class="py-20 bg-bg" aria-labelledby="rgv-ads-window">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 id="rgv-ads-window" class="text-3xl sm:text-4xl font-bold text-text mb-6 reveal">
          The paid ads window in the Valley is still open
        </h2>
        <div class="space-y-5 text-text-muted text-lg leading-relaxed">
          <p class="reveal reveal-delay-1">
            A lot of RGV businesses are either not running paid campaigns at all or they are running them badly: broad keywords, no negatives, weak offers, poor follow-up, and incomplete tracking. That creates an opening for businesses willing to run disciplined campaigns.
          </p>
          <p class="reveal reveal-delay-2">
            In many categories, you do not need a massive budget to win. You need tighter account structure, faster response times, and a realistic view of lead quality by source.
          </p>
          <p class="reveal reveal-delay-3">
            The businesses that build competent paid acquisition now will own more market share while everyone else is still treating ads like a boost button.
          </p>
        </div>
      </div>
    </div>
  </section>

  <PricingSection
    id="ads-management-pricing"
    headline="Google & Meta Ads pricing"
    subheadline="Flat monthly fee based on ad budget. No setup fees. No commissions on spend."
    bg="bg-surface"
    cards={adsCards}
    note="Spending more than $10,000/month? We scope those accounts individually — usually a base fee plus a percentage of spend."
  />

  <Testimonials />

  <ServiceAreaGrid
    headline="Ads management across the Rio Grande Valley"
    serviceSlug="ads-management"
  />

  <FAQSection faqs={faqs} headline="Paid ads questions from RGV business owners" />

  <CTASection
    headline="Need leads sooner than SEO alone can deliver?"
    subheadline="We will look at your market, your current demand, and whether Google Ads, Meta Ads, or both make sense for your next move."
  />
</ServiceLayout>
