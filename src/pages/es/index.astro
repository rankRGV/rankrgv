---
// Spanish homepage (redesign 2026-10-19). Same layout and components as the English homepage,
// with lang="es" copy. FAQs below are the Spanish homepage FAQs plus the website price question.
import BaseLayout from '@/layouts/BaseLayout.astro';
import SpecHero from '@/components/SpecHero.astro';
import ServicesSplit from '@/components/ServicesSplit.astro';
import FAQSection from '@/components/FAQSection.astro';
import HomeReviews from '@/components/HomeReviews.astro';
import { graderHref, site } from '@/config/site';
import { buildOrgSchema, buildFAQSchema, buildWebPageSchema } from '@/components/SchemaMarkup.astro';

const faqs = [
  {
    question: '¿Cuánto cuesta un sitio web?',
    answer: 'Nuestros sitios web empiezan en $1,500 por un sitio Fundación de 5 a 7 páginas y $2,500 por un sitio Crecimiento de 10 a 15 páginas con páginas completas por servicio y por ciudad, más impuesto de ventas. Los proyectos más grandes para varias ciudades se cotizan aparte. Recibes un precio fijo antes de empezar cualquier trabajo.',
  },
  {
    question: '¿Cuánto tiempo tarda en verse resultados con SEO local en McAllen?',
    answer: 'El SEO se construye con los meses. Qué tan rápido se mueven las posiciones depende de dónde empiezas, de tu servicio y de tu competencia. Medimos el avance y te explicamos qué cambió. No prometemos una posición específica en Google ni un número de llamadas.',
  },
  {
    question: '¿Tienen que firmar un contrato a largo plazo?',
    answer: 'No. El SEO local es mes a mes. Nos ganamos tu confianza con el trabajo y con reportes claros, y te puedes ir cualquier mes.',
  },
  {
    question: '¿Qué diferencia a RankRGV de otras agencias en el Valle?',
    answer: 'RankRGV tiene su base en McAllen. Nuestro enfoque principal es el SEO local para negocios del Rio Grande Valley. También aceptamos algunos proyectos de sitios web, publicidad y automatización para negocios que atienden mercados más amplios.',
  },
  {
    question: '¿La revisión gratis es lo mismo que una auditoría SEO personal?',
    answer: 'No. La revisión gratis (nuestro Business Grader) es una foto automática de tu perfil público de Google Business. Escribes el nombre de tu negocio, confirmas el perfil y eliges un servicio. Una auditoría personal es una conversación aparte con Eddie sobre tu perfil de Google Business, tu sitio web, cómo apareces en las búsquedas y tu competencia. Pídela en nuestra página de contacto o llama al 956-391-5991.',
  },
  {
    question: '¿Trabajan con negocios que atienden en español?',
    answer: 'Sí. El Valle tiene una dinámica bilingüe única: muchos clientes buscan en español y otros en inglés. Tomamos eso en cuenta al momento de investigar palabras clave y crear contenido. Si tu negocio atiende principalmente en español, eso forma parte de la estrategia.',
  },
  {
    question: '¿Ya tengo página web. Necesito SEO local?',
    answer: 'Un sitio web le da a tus clientes a dónde ir. El SEO local ayuda a conectar tu sitio y tu perfil de Google Business con la gente que busca tu servicio en las ciudades que atiendes.',
  },
];

const title = 'Diseño Web y SEO Local en McAllen, TX | RankRGV';
const description = 'Diseño web y SEO local en McAllen, TX para negocios del Rio Grande Valley. Sitios web desde $1,500, SEO local desde $600/mes, mes a mes. Llama al (956) 391-5991.';
---
<BaseLayout lang="es"
  title={title}
  description={description}
  canonical={`${site.url}/es/`}
  hreflang={[{ lang: 'en', href: `${site.url}/` }, { lang: 'es', href: `${site.url}/es/` }, { lang: 'x-default', href: `${site.url}/` }]}
  schema={[buildOrgSchema(), buildFAQSchema(faqs), buildWebPageSchema(title, description, '/es/')]}
  geoPlacename="McAllen, Texas"
  hideSticky
>
  <SpecHero lang="es" />
  <ServicesSplit lang="es" />

  <HomeReviews lang="es" />

  <FAQSection faqs={faqs} headline="Preguntas frecuentes sobre diseño web y SEO local en el Valle" />

  <section class="bg-bg-dark text-white py-14 lg:py-16" aria-labelledby="final-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 id="final-heading" class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4">Descubre cómo estás en Google.</h2>
      <p class="text-white/80 text-lg mb-8">Una revisión automática y gratis de tu perfil de Google en 60 segundos, o llama a Eddie y platícalo.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={graderHref('homepage-final', 'es')} class="inline-flex items-center h-12 px-6 rounded-xl bg-brand-blue hover:bg-brand-blue-light font-bold transition-colors">Revisar mi perfil de Google →</a>
        <a href={site.phoneHref} class="inline-flex items-center h-12 px-6 rounded-xl border border-white/25 hover:border-white font-bold transition-colors">Llama al {site.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>
