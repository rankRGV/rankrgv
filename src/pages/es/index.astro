---
// Spanish homepage (redesign 2026-10-19). Same layout and components as the English homepage,
// with lang="es" copy. FAQs below are the Spanish homepage FAQs plus the website price question.
import BaseLayout from '@/layouts/BaseLayout.astro';
import SpecHero from '@/components/SpecHero.astro';
import ServicesSplit from '@/components/ServicesSplit.astro';
import FAQSection from '@/components/FAQSection.astro';
import { graderHref, site } from '@/config/site';
import { buildOrgSchema, buildFAQSchema, buildWebPageSchema } from '@/components/SchemaMarkup.astro';
import { homeReviews } from '@/data/home';

const faqs = [
  {
    question: '¿Cuánto cuesta un sitio web?',
    answer: 'Nuestros sitios web empiezan en $1,500 por un sitio Fundación de 5 a 7 páginas y $2,500 por un sitio Crecimiento de 10 a 15 páginas con páginas completas por servicio y por ciudad, más impuesto de ventas. Los proyectos más grandes para varias ciudades se cotizan aparte. Recibes un precio fijo antes de empezar cualquier trabajo.',
  },
  {
    question: '¿Cuánto tiempo tarda en verse resultados con SEO local en McAllen?',
    answer: 'La mayoría de los negocios en el Valle empiezan a ver movimiento en Google Maps dentro de 60 a 90 días. El mercado del RGV tiene mucho menos competencia que Houston o San Antonio: eso significa resultados más rápidos para ti.',
  },
  {
    question: '¿Tienen que firmar un contrato a largo plazo?',
    answer: 'No. Trabajamos mes a mes porque preferimos ganarnos tu confianza con resultados, no con papeles. La mayoría de nuestros clientes se quedan más de un año, no porque estén obligados, sino porque ven el retorno.',
  },
  {
    question: '¿Qué diferencia a RankRGV de otras agencias en el Valle?',
    answer: 'RankRGV tiene su base en McAllen. Nuestro enfoque principal es el SEO local para negocios del Rio Grande Valley. También aceptamos algunos proyectos de sitios web, publicidad y automatización para negocios que atienden mercados más amplios.',
  },
  {
    question: '¿Qué incluye el diagnóstico SEO gratuito?',
    answer: 'El diagnóstico cubre cuatro áreas: tu perfil de Google Business (completitud, fotos, reseñas), el SEO técnico de tu sitio web, tus posiciones actuales en Google, y los 3 competidores más fuertes de tu área. Sin compromiso, sin presión.',
  },
  {
    question: '¿Trabajan con negocios que atienden en español?',
    answer: 'Sí. El Valle tiene una dinámica bilingüe única: muchos clientes buscan en español y otros en inglés. Tomamos eso en cuenta al momento de investigar palabras clave y crear contenido. Si tu negocio atiende principalmente en español, eso forma parte de la estrategia.',
  },
  {
    question: '¿Ya tengo página web. Necesito SEO local?',
    answer: 'Sí. Tener página web y aparecer en Google son dos cosas diferentes. La mayoría de los sitios web que auditamos en el Valle no tienen ni una sola posición en Google: llevan años en línea y siguen siendo invisibles. El SEO local es lo que conecta tu sitio con los clientes que te están buscando ahora mismo.',
  },
];

const title = 'Diseño Web y SEO Local en McAllen, TX | RankRGV';
const description = 'Diseño web y SEO local en McAllen, TX para negocios del Rio Grande Valley. Sitios web desde $1,500, SEO local desde $600/mes, mes a mes. Llama al (956) 391-5991.';
---
<BaseLayout lang="es"
  title={title}
  description={description}
  canonical={`${site.url}/es/`}
  hreflang={[{ lang: 'en', href: `${site.url}/` }, { lang: 'es', href: `${site.url}/es/` }, { lang: 'x-default', href: `${site.url}/` }]}
  schema={[buildOrgSchema(), buildFAQSchema(faqs), buildWebPageSchema(title, description, '/es/')]}
  geoPlacename="McAllen, Texas"
>
  <SpecHero lang="es" />
  <ServicesSplit lang="es" />

  <section class="py-14 lg:py-20 bg-white" aria-labelledby="reviews-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
        <div>
          <p class="text-sm font-semibold text-brand-blue mb-2">Reseñas de Google</p>
          <h2 id="reviews-heading" class="text-3xl sm:text-4xl font-extrabold tracking-tight text-text">Lo que dicen los dueños de negocios del RGV</h2>
          <p class="mt-2 text-sm text-text-muted">Reseñas tal como se escribieron en Google, en inglés.</p>
        </div>
        <a href={site.social.gbp} target="_blank" rel="noopener" class="text-sm font-semibold text-brand-blue hover:underline">5.0 en Google. Lee todas las reseñas →</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {homeReviews.map((r) => (
          <figure class="bg-white border border-border rounded-2xl p-6 flex flex-col">
            <span class="text-amber-400 text-lg leading-none tracking-wide mb-4" aria-label="5 de 5 estrellas">★★★★★</span>
            <blockquote lang="en" class="text-text leading-relaxed mb-5 flex-1">"{r.quote}"</blockquote>
            <figcaption class="flex items-center gap-3 pt-4 border-t border-border">
              <span class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0" style={`background:${r.bg};color:${r.fg}`}>{r.initials}</span>
              <span class="min-w-0"><span class="block text-sm font-bold text-text">{r.name}</span><span class="block text-xs text-text-muted">{r.meta}</span></span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <FAQSection faqs={faqs} headline="Preguntas frecuentes sobre diseño web y SEO local en el Valle" />

  <section class="bg-bg-dark text-white py-14 lg:py-16" aria-labelledby="final-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 id="final-heading" class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4">Descubre cómo estás en Google.</h2>
      <p class="text-white/80 text-lg mb-8">Calificación gratis en 60 segundos, o llama a Eddie y platícalo.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={graderHref('homepage-final', 'es')} class="inline-flex items-center h-12 px-6 rounded-xl bg-brand-blue hover:bg-brand-blue-light font-bold transition-colors">Obtener mi calificación gratis →</a>
        <a href={site.phoneHref} class="inline-flex items-center h-12 px-6 rounded-xl border border-white/25 hover:border-white font-bold transition-colors">Llama al {site.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>
