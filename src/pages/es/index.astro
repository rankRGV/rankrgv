---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { buildOrgSchema, buildFAQSchema, buildWebPageSchema } from '@/components/SchemaMarkup.astro';

const faqs = [
  {
    question: '¿Cuánto tiempo tarda en verse resultados con SEO local en McAllen?',
    answer: 'La mayoría de los negocios en el Valle empiezan a ver movimiento en Google Maps dentro de 60 a 90 días. En ciudades con menos competencia como Mission o Pharr, algunos negocios llegan al Top 3 en 30 a 45 días. El mercado del RGV tiene mucho menos competencia que Houston o San Antonio — eso significa resultados más rápidos para ti.',
  },
  {
    question: '¿Tienen que firmar un contrato a largo plazo?',
    answer: 'No. Trabajamos mes a mes porque preferimos ganarnos tu confianza con resultados, no con papeles. La mayoría de nuestros clientes se quedan más de un año — no porque estén obligados, sino porque ven el retorno.',
  },
  {
    question: '¿Qué diferencia a RankRGV de otras agencias en el Valle?',
    answer: 'RankRGV es 100% del Valle. No tenemos clientes en Dallas, Houston, o a nivel nacional — el RGV es nuestro único mercado y lo conocemos a fondo. Sabemos qué palabras clave funcionan en Edinburg versus Brownsville, qué industrias están sin servir en Pharr, y cómo es la competencia real en McAllen.',
  },
  {
    question: '¿Qué incluye el diagnóstico SEO gratuito?',
    answer: 'El diagnóstico cubre cuatro áreas: tu perfil de Google Business (completitud, fotos, reseñas), el SEO técnico de tu sitio web, tus posiciones actuales en Google, y los 3 competidores más fuertes de tu área. Sin compromiso, sin presión.',
  },
  {
    question: '¿Trabajan con negocios que atienden en español?',
    answer: 'Sí. El Valle tiene una dinámica bilingüe única — muchos clientes buscan en español y otros en inglés. Tomamos eso en cuenta al momento de investigar palabras clave y crear contenido. Si tu negocio atiende principalmente en español, eso forma parte de la estrategia.',
  },
  {
    question: '¿Ya tengo página web. Necesito SEO local?',
    answer: 'Sí. Tener página web y aparecer en Google son dos cosas diferentes. La mayoría de los sitios web que auditamos en el Valle no tienen ni una sola posición en Google — llevan años en línea y siguen siendo invisibles. El SEO local es lo que conecta tu sitio con los clientes que te están buscando ahora mismo.',
  },
];

const schema = [
  buildOrgSchema(),
  buildFAQSchema(faqs),
  buildWebPageSchema(
    'Agencia SEO Local McAllen TX | Marketing Digital en el Valle | RankRGV',
    'RankRGV ayuda a negocios del RGV a aparecer en Google y crecer. SEO local, diseño web y automatización para el Rio Grande Valley.',
    '/es/'
  ),
];
---

<BaseLayout lang="es"
  title="Agencia SEO Local McAllen TX | Marketing Digital en el Valle | RankRGV"
  description="RankRGV ayuda a negocios del Valle a aparecer en Google y conseguir más clientes. SEO local, diseño web y automatización — 100% enfocados en el RGV. Diagnóstico gratis."
  canonical="https://rankrgv.com/es/"
  schema={schema}
  geoPlacename="McAllen, Texas"
>

  <!-- Hreflang — tell Google about the English version -->
  <link slot="head" rel="alternate" hreflang="en" href="https://rankrgv.com/" />
  <link slot="head" rel="alternate" hreflang="es" href="https://rankrgv.com/es/" />

  <!-- HERO -->
  <section class="hero-bg pt-10 pb-28 lg:py-36 relative overflow-hidden" aria-label="Hero">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-blue/20 via-transparent to-brand-purple/20 pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 xl:gap-20 items-center">
        <div>
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 mb-6 px-4 py-2 rounded-full bg-white/10 border border-white/20 text-sm font-medium text-white/80 float">
            <span class="w-2 h-2 rounded-full bg-brand-blue-light flex-shrink-0"></span>
            Sirviendo al Rio Grande Valley
          </div>

          <!-- Headline -->
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
            Que te encuentren en Google.<br />
            <span class="gradient-text">Domina el Valle.</span>
          </h1>

          <!-- Subheadline -->
          <p class="text-lg sm:text-xl text-white/70 leading-relaxed mb-10 max-w-xl">
            Ayudamos a negocios de McAllen y todo el RGV a posicionarse en Google, recibir más llamadas y cerrar más clientes — sin rodeos. Diagnóstico SEO gratis para empezar.
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row gap-4">
            <a href={site.phoneHref} class="btn-primary">
              <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z" />
              </svg>
              Llama para consulta gratis de 15 min
            </a>
            <a href="/get-started/" class="btn-secondary">
              Pide tu diagnóstico gratis
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>

          <!-- Social proof -->
          <div class="flex items-center gap-3 mt-8 pt-6 border-t border-white/10">
            <div class="flex gap-0.5" role="img" aria-label="4.8 de 5 estrellas">
              {Array.from({ length: 5 }).map(() => (
                <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-white/60 text-sm">4.8 estrellas · Negocios del RGV que confían en nosotros</p>
          </div>
        </div>

        <!-- Right visual (reuse map-pack style) -->
        <div class="hidden lg:block relative px-6 pt-6 pb-8">
          <div class="absolute inset-0 bg-brand-blue/15 rounded-3xl blur-3xl" aria-hidden="true"></div>
          <div class="relative bg-white rounded-2xl shadow-2xl overflow-hidden">
            <div class="flex items-center gap-1.5 px-4 py-3 bg-gray-50 border-b border-gray-100">
              <div class="w-3 h-3 rounded-full bg-red-400" aria-hidden="true"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-400" aria-hidden="true"></div>
              <div class="w-3 h-3 rounded-full bg-green-400" aria-hidden="true"></div>
              <div class="flex-1 mx-3 bg-white border border-gray-200 rounded-full px-3 py-1 flex items-center gap-2">
                <svg class="w-3 h-3 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <span class="text-xs text-gray-600">seo local mcallen tx</span>
              </div>
            </div>
            <div class="relative h-28 overflow-hidden" style="background: linear-gradient(135deg, #d1fae5 0%, #bfdbfe 100%);" aria-hidden="true">
              <div class="absolute inset-0 opacity-20" style="background-image: linear-gradient(#94a3b8 1px, transparent 1px), linear-gradient(90deg, #94a3b8 1px, transparent 1px); background-size: 36px 36px;"></div>
              <div class="absolute top-4 left-[28%] flex flex-col items-center">
                <div class="w-7 h-7 rounded-full bg-brand-blue border-2 border-white shadow-lg flex items-center justify-center text-white text-xs font-bold">1</div>
                <div class="w-1.5 h-2 bg-brand-blue rounded-b-full"></div>
              </div>
              <div class="absolute top-9 left-[52%] flex flex-col items-center">
                <div class="w-5 h-5 rounded-full bg-gray-400 border-2 border-white shadow flex items-center justify-center text-white text-xs font-bold">2</div>
              </div>
              <div class="absolute top-14 left-[68%] flex flex-col items-center">
                <div class="w-5 h-5 rounded-full bg-gray-400 border-2 border-white shadow flex items-center justify-center text-white text-xs font-bold">3</div>
              </div>
            </div>
            <div class="divide-y divide-gray-100">
              <div class="flex items-center gap-3 px-4 py-3.5 bg-blue-50/70">
                <div class="w-7 h-7 rounded-full bg-brand-blue flex items-center justify-center text-white text-xs font-bold flex-shrink-0">1</div>
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-bold text-brand-blue">Tu Negocio Aquí</div>
                  <div class="flex items-center gap-1 mt-0.5">
                    <span class="text-amber-400 text-xs">★★★★★</span>
                    <span class="text-xs text-gray-500">4.8 · McAllen, TX</span>
                  </div>
                </div>
                <span class="flex-shrink-0 text-xs bg-green-100 text-green-700 font-bold px-2 py-0.5 rounded-full">#1</span>
              </div>
              <div class="flex items-center gap-3 px-4 py-3 opacity-40">
                <div class="w-6 h-6 rounded-full bg-gray-300 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">2</div>
                <div class="text-sm font-medium text-gray-600">Competidor A</div>
              </div>
              <div class="flex items-center gap-3 px-4 py-3 opacity-20">
                <div class="w-6 h-6 rounded-full bg-gray-300 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">3</div>
                <div class="text-sm font-medium text-gray-600">Competidor B</div>
              </div>
            </div>
          </div>
          <div class="absolute -top-2 right-2 bg-white rounded-xl shadow-xl px-3.5 py-2.5 border border-gray-100 flex items-center gap-2.5 float" aria-hidden="true">
            <div class="w-9 h-9 rounded-full bg-green-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <div>
              <div class="text-sm font-extrabold text-gray-900 leading-none">+312%</div>
              <div class="text-xs text-gray-500 mt-0.5">Tráfico en Google</div>
            </div>
          </div>
          <div class="absolute -bottom-2 left-2 bg-white rounded-xl shadow-xl px-3.5 py-2.5 border border-gray-100 flex items-center gap-2.5 float" style="animation-delay: 1.5s;" aria-hidden="true">
            <div class="w-9 h-9 rounded-full bg-brand-blue/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <div class="text-sm font-extrabold text-gray-900 leading-none">90 días</div>
              <div class="text-xs text-gray-500 mt-0.5">a los primeros resultados</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PAIN POINTS -->
  <section class="py-20 bg-bg-dark" aria-label="Problemas comunes">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4 reveal">¿Te suena familiar?</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { title: 'Eres invisible en Google', body: 'Tus clientes te buscan. Tu competencia aparece primero. Tú no.' },
          { title: 'Pierdes clientes sin darte cuenta', body: 'Las llamadas no llegan, el sitio web no convierte, y no sabes exactamente por qué.' },
          { title: 'Tu página web no está trabajando', body: 'La hiciste hace años. No aparece en Google. No genera llamadas. Solo existe.' },
        ].map(({ title, body }) => (
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 reveal">
            <h3 class="text-lg font-bold text-white mb-3">{title}</h3>
            <p class="text-white/60 text-sm leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="py-20 bg-bg" aria-label="Nuestros servicios">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-text mb-4 reveal">
          La agencia de marketing de McAllen — hecha para el Valle
        </h2>
        <p class="text-text-muted text-lg reveal reveal-delay-1">
          Tres servicios enfocados. Un solo objetivo: que más clientes del RGV te encuentren en Google.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          {
            icon: '📍',
            name: 'SEO Local y Google Maps',
            desc: 'Aparece en el Top 3 del Map Pack cuando tus clientes buscan lo que ofreces en McAllen, Brownsville, Edinburg y todo el Valle.',
            href: '/es/seo-local/',
          },
          {
            icon: '🖥️',
            name: 'Diseño Web',
            desc: 'Sitios rápidos, en móvil, optimizados para Google — diseñados para convertir visitas en llamadas y formularios completados.',
            href: '/web-design/',
          },
          {
            icon: '⚙️',
            name: 'Automatización de Negocios',
            desc: 'Rescata clientes perdidos con respuestas automáticas por texto, seguimiento de leads y flujos que trabajan por ti 24/7.',
            href: '/business-automation/',
          },
        ].map(({ icon, name, desc, href }) => (
          <a href={href} class="group bg-bg-surface border border-border rounded-2xl p-6 hover:border-brand-blue/40 hover:shadow-md transition-all duration-200 no-underline reveal">
            <div class="text-3xl mb-4">{icon}</div>
            <h3 class="text-lg font-bold text-text mb-2 group-hover:text-brand-blue transition-colors">{name}</h3>
            <p class="text-text-muted text-sm leading-relaxed">{desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- AREAS DE SERVICIO -->
  <section class="py-20 bg-bg-surface" aria-label="Áreas de servicio">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <h2 class="text-3xl font-bold text-text mb-4 reveal">Servimos a todo el Valle</h2>
        <p class="text-text-muted reveal reveal-delay-1">
          De McAllen a Brownsville, de Edinburg a Harlingen — si tu negocio está en el RGV, te podemos ayudar.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 justify-center reveal reveal-delay-2">
        {[
          { city: 'McAllen', href: '/es/areas-de-servicio/mcallen/' },
          { city: 'Brownsville', href: '/es/areas-de-servicio/brownsville/' },
          { city: 'Edinburg', href: '/es/areas-de-servicio/edinburg/' },
          { city: 'Harlingen', href: '/es/areas-de-servicio/harlingen/' },
          { city: 'Mission', href: '/es/areas-de-servicio/mission/' },
          { city: 'Pharr', href: '/es/areas-de-servicio/pharr/' },
        ].map(({ city, href }) => (
          <a href={href} class="px-5 py-2.5 rounded-full bg-bg border border-border text-sm font-semibold text-text hover:border-brand-blue/50 hover:text-brand-blue transition-colors no-underline">
            {city}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-bg" aria-labelledby="faq-es">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="faq-es" class="text-3xl font-bold text-text mb-10 text-center reveal">
        Preguntas frecuentes sobre marketing digital en el Valle
      </h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="bg-bg-surface border border-border rounded-xl overflow-hidden group reveal">
            <summary class="flex items-center justify-between gap-4 px-6 py-4 cursor-pointer font-semibold text-text list-none">
              {faq.question}
              <svg class="w-5 h-5 text-text-muted flex-shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-5 text-text-muted leading-relaxed">{faq.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-bg-dark" aria-label="Llamada a la acción">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4 reveal">
        ¿Listo para aparecer cuando tus clientes te buscan?
      </h2>
      <p class="text-white/60 text-lg mb-8 reveal reveal-delay-1">
        Llama o pide tu diagnóstico gratis. Sin compromiso, sin contratos.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center reveal reveal-delay-2">
        <a href={site.phoneHref} class="btn-primary">
          Llama al {site.phone}
        </a>
        <a href="/get-started/" class="btn-secondary">
          Pide el diagnóstico gratis
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
