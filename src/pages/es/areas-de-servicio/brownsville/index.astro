---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildFAQSchema, buildBreadcrumbSchema, buildWebPageSchema, buildOrgSchema } from '@/components/SchemaMarkup.astro';
import { graderHref, site } from '@/config/site';

const title = 'Agencia SEO Local Brownsville TX | Marketing Digital | RankRGV';
const description =
  'RankRGV ayuda a negocios de Brownsville a aparecer en Google y el Map Pack. SEO local y diseño web para el sur de Texas. Auditoría gratis — (956) 391-5991.';
const canonicalUrl = `${site.url}/es/areas-de-servicio/brownsville/`;

const faqs = [
  {
    question: '¿El SEO local funciona para negocios en Brownsville?',
    answer:
      'Sí — y mejor que en la mayoría de los mercados de Texas. Brownsville tiene demanda de búsqueda real pero competencia digital débil. Los negocios que inviertan en SEO local ahora tienen una ventana abierta para dominar el Map Pack antes de que la competencia despierte, especialmente con el crecimiento que está trayendo SpaceX y el desarrollo económico de la ciudad.',
  },
  {
    question: '¿Cuánto tiempo tarda ver resultados en Brownsville?',
    answer:
      'Entre 60 y 90 días para los primeros movimientos en Google Maps. Algunas categorías en Brownsville tienen tan poca competencia que pueden llegar al top 3 en 30 a 45 días. Te reportamos el progreso mensualmente para que siempre sepas exactamente dónde estás.',
  },
  {
    question: '¿Trabajan con negocios nuevos en Brownsville que están empezando?',
    answer:
      'Sí. No necesitas llevar años en el negocio para empezar a rankear. De hecho, a veces es más fácil construir una presencia digital sólida desde cero que intentar reparar una que lleva años mal configurada. Empezamos con lo que tienes y construimos desde ahí.',
  },
  {
    question: '¿El crecimiento de SpaceX en Brownsville afecta el SEO local?',
    answer:
      'Sí, positivamente. El desarrollo alrededor de Starbase está atrayendo nuevos residentes, negocios y tráfico a Brownsville. Eso significa más búsquedas locales, más demanda de servicios, y más oportunidades para que tu negocio aparezca cuando la gente nueva llega buscando proveedores locales.',
  },
];

const schema = [
  buildOrgSchema(),
  buildFAQSchema(faqs),
  buildBreadcrumbSchema([
    { label: 'Inicio', href: '/es/' },
    { label: 'Áreas de Servicio', href: '/es/' },
    { label: 'Brownsville', href: '/es/areas-de-servicio/brownsville/' },
  ]),
  buildWebPageSchema(title, description, '/es/areas-de-servicio/brownsville/'),
];
---

<BaseLayout lang="es"
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schema}
  lang="es"
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="en" href={`${site.url}/service-areas/brownsville/`} />
    <link rel="alternate" hreflang="es" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={`${site.url}/service-areas/brownsville/`} />
  </Fragment>

  <!-- Hero -->
  <section class="relative bg-bg-dark overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 24px 24px;"></div>
    <div class="absolute inset-0 bg-gradient-to-br from-brand-blue-dark/60 via-bg-dark to-brand-purple/20"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-blue/10 border border-brand-blue/20 text-brand-blue text-sm font-semibold mb-6">
          <span>Sirviendo Brownsville, TX y el Condado de Cameron</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
          SEO local en Brownsville — <span class="gradient-text">crece en el sur del Valle.</span>
        </h1>
        <p class="text-xl text-white/70 mb-10 max-w-2xl">
          Brownsville está creciendo rápido — con SpaceX, nuevos residentes y más búsquedas locales cada mes. Te ayudamos a aparecer primero cuando te busquen.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href={graderHref('brownsville-hero', 'es')} class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-gradient-to-r from-brand-blue to-brand-purple text-white font-semibold text-base shadow-lg hover:opacity-90 transition-opacity">
            Califica tu negocio gratis
          </a>
          <a href="tel:9563915991" class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-white/10 border border-white/20 text-white font-semibold text-base hover:bg-white/15 transition-colors">
            (956) 391-5991
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust signals -->
  <section class="py-12 bg-bg-surface border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {[
          { value: 'Brownsville', label: 'Mercado en crecimiento' },
          { value: '185K+', label: 'Residentes en Brownsville' },
          { value: 'Baja', label: 'Competencia digital local' },
          { value: '90 días', label: 'Primeros resultados promedio' },
        ].map(({ value, label }) => (
          <div>
            <div class="text-2xl font-extrabold gradient-text mb-1">{value}</div>
            <div class="text-sm text-text-muted">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Market context -->
  <section class="py-20 bg-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div class="reveal">
          <h2 class="text-3xl sm:text-4xl font-bold text-text mb-6">
            Por qué ahora es el momento de invertir en SEO en Brownsville
          </h2>
          <p class="text-text-muted text-lg leading-relaxed mb-5">
            Brownsville es la ciudad más grande del sur de Texas y está experimentando un crecimiento económico acelerado. Con la instalación de SpaceX Starbase en Boca Chica, la ciudad está atrayendo nuevas empresas, talento y residentes — todos buscando servicios locales en Google.
          </p>
          <p class="text-text-muted text-lg leading-relaxed mb-5">
            A pesar de su tamaño, el mercado digital de Brownsville sigue siendo relativamente poco competitivo. La mayoría de los negocios locales no tienen una estrategia de SEO seria, lo que significa que hay una ventana abierta para que tu negocio tome esas posiciones antes de que los competidores despierten.
          </p>
          <p class="text-text-muted text-lg leading-relaxed">
            No somos una agencia de Houston o Dallas que no sabe nada del Valle. Somos RGV-only — Brownsville es nuestro mercado y sabemos cómo moverlo.
          </p>
        </div>
        <div class="reveal reveal-delay-1 space-y-4">
          <div class="rounded-2xl overflow-hidden border border-border shadow-sm aspect-video bg-bg-dark relative flex items-end">
            <div class="absolute inset-0 bg-gradient-to-br from-brand-blue-dark via-bg-dark to-brand-purple/40"></div>
            <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 24px 24px;"></div>
            <div class="relative z-10 p-6 w-full">
              <div class="text-white/70 text-xs font-semibold uppercase tracking-widest mb-1">Sur de Texas</div>
              <div class="text-white text-2xl font-extrabold tracking-tight">Brownsville, Texas</div>
              <div class="text-white/60 text-sm mt-1">Ciudad de mayor crecimiento en el RGV · Condado de Cameron</div>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            {[
              { value: '185K+', label: 'Población de Brownsville' },
              { value: 'SpaceX', label: 'Starbase — motor de crecimiento económico' },
              { value: 'Baja', label: 'Competencia SEO local vs. su tamaño' },
              { value: '60-90d', label: 'Tiempo promedio a primeros rankings' },
            ].map(({ value, label }) => (
              <div class="bg-bg-surface rounded-xl p-4 border border-border text-center">
                <div class="text-xl font-extrabold gradient-text mb-0.5">{value}</div>
                <div class="text-xs text-text-muted leading-tight">{label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-20 bg-bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-text mb-4 reveal">
          Servicios disponibles para negocios en Brownsville
        </h2>
        <p class="text-text-muted text-lg reveal reveal-delay-1">
          Cada servicio adaptado a la realidad del mercado de Brownsville y el sur del Valle.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          {
            icon: '📍',
            name: 'SEO Local',
            desc: 'Aparece en el top 3 del Google Map Pack cuando alguien en Brownsville busca lo que tú ofreces. Optimización de Google Business Profile, citas locales y contenido local.',
            href: '/es/seo-local/',
          },
          {
            icon: '🖥️',
            name: 'Diseño Web',
            desc: 'Sitios web que convierten. Rápidos, optimizados para móvil, y construidos para generar llamadas y formularios desde el primer día.',
            href: '/web-design/',
          },
          {
            icon: '⚙️',
            name: 'Automatización',
            desc: 'Respuestas automáticas, seguimiento de leads y flujos de trabajo — para que tu negocio opere más eficientemente sin trabajo manual extra.',
            href: '/business-automation/',
          },
        ].map(({ icon, name, desc, href }) => (
          <a href={href} class="block bg-bg rounded-2xl border border-border p-8 hover:border-brand-blue/40 hover:shadow-md transition-all reveal group">
            <div class="text-4xl mb-4">{icon}</div>
            <h3 class="text-xl font-bold text-text mb-3 group-hover:text-brand-blue transition-colors">{name}</h3>
            <p class="text-text-muted text-sm leading-relaxed">{desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Neighborhoods -->
  <section class="py-16 bg-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-text mb-4 reveal">Servimos toda el área de Brownsville</h2>
      <p class="text-text-muted mb-8 reveal reveal-delay-1">
        Desde el Downtown histórico hasta Southmost, Boca Chica y Palm Gardens — si tus clientes están en Brownsville, te ayudamos a que te encuentren.
      </p>
      <div class="flex flex-wrap gap-3 justify-center reveal reveal-delay-2">
        {['Downtown Brownsville', 'Southmost', 'Boca Chica', 'Palm Gardens', 'Sunrise', 'y más...'].map((n) => (
          <span class="px-4 py-2 rounded-full bg-bg-surface border border-border text-sm text-text-muted font-medium">{n}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-bg-surface">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-text mb-10 text-center reveal">
        Preguntas sobre SEO local en Brownsville
      </h2>
      <div class="space-y-4">
        {faqs.map(({ question, answer }) => (
          <details class="group bg-bg rounded-2xl border border-border p-6 reveal">
            <summary class="flex items-center justify-between cursor-pointer font-semibold text-text list-none">
              {question}
              <span class="text-brand-blue ml-4 flex-shrink-0 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-4 text-text-muted leading-relaxed">{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-bg-dark relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 24px 24px;"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4 reveal">
        ¿Listo para crecer en Brownsville?
      </h2>
      <p class="text-white/70 text-lg mb-8 reveal reveal-delay-1">
        El mercado está creciendo. La competencia digital todavía es baja. Ahora es el momento.
      </p>
      <div class="flex flex-wrap gap-4 justify-center reveal reveal-delay-2">
        <a href={graderHref('brownsville-final', 'es')} class="inline-flex items-center justify-center px-8 py-4 rounded-xl bg-gradient-to-r from-brand-blue to-brand-purple text-white font-semibold text-lg shadow-lg hover:opacity-90 transition-opacity">
          Califica tu negocio gratis
        </a>
        <a href="tel:9563915991" class="inline-flex items-center justify-center px-8 py-4 rounded-xl bg-white/10 border border-white/20 text-white font-semibold text-lg hover:bg-white/15 transition-colors">
          (956) 391-5991
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
