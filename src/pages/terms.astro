---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';

const title = 'Terms of Service | RankRGV';
const description = 'Terms of service for RankRGV digital marketing services.';
const lastUpdated = 'February 2026';
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="py-20 bg-bg">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-10">
        <h1 class="text-3xl font-extrabold text-text mb-2">Terms of Service</h1>
        <p class="text-text-muted text-sm">Last updated: {lastUpdated}</p>
      </div>

      <div class="space-y-8">

        <div>
          <h2 class="text-xl font-bold text-text mb-3">1. Agreement to terms</h2>
          <p class="text-text-muted leading-relaxed">
            By accessing and using the RankRGV website (rankrgv.com) and any services we provide, you agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use our website or services. RankRGV is operated by RankRGV, based in McAllen, Texas.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-bold text-text mb-3">2. Services</h2>
          <p class="text-text-muted leading-relaxed mb-3">
            RankRGV provides digital marketing services including local SEO, web design, and business automation for businesses in the Rio Grande Valley. Specific terms for paid engagements are outlined in separate service agreements provided to clients prior to any work commencing.
          </p>
          <p class="text-text-muted leading-relaxed">
            Free audit requests submitted through our website are non-binding. Submitting an audit request does not constitute a service agreement or payment obligation.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-bold text-text mb-3">3. Website content</h2>
          <p class="text-text-muted leading-relaxed">
            The content on this website — including text, graphics, and other materials — is provided for informational purposes and to describe our services. While we make every effort to ensure accuracy, we make no warranties about the completeness, reliability, or accuracy of the information. Market data, competition levels, and ranking timelines referenced on this site are illustrative and vary by business, category, and market conditions.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-bold text-text mb-3">4. No guarantee of results</h2>
          <p class="text-text-muted leading-relaxed">
            Digital marketing outcomes depend on many factors outside our control, including Google algorithm updates, competitor actions, market conditions, and client implementation. References to ranking timelines (e.g., "top 3 in 30–45 days") on this website are based on observed market conditions and typical results — they are not guarantees. We do not promise specific ranking positions or revenue outcomes.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-bold text-text mb-3">5. Intellectual property</h2>
          <p class="text-text-muted leading-relaxed">
            All content on this website — including copy, design, and code — is the property of RankRGV unless otherwise noted. You may not reproduce, distribute, or create derivative works without explicit written permission. For client work we produce (websites, content, etc.), ownership terms are defined in the applicable service agreement.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-bold text-text mb-3">6. Third-party services</h2>
          <p class="text-text-muted leading-relaxed">
            Our website and services may include or reference third-party tools and platforms (Google Business Profile, Formspark, GoHighLevel, Vercel, etc.). Use of these services is governed by their respective terms of service. RankRGV is not liable for the availability, accuracy, or conduct of third-party platforms.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-bold text-text mb-3">7. Limitation of liability</h2>
          <p class="text-text-muted leading-relaxed">
            To the maximum extent permitted by law, RankRGV shall not be liable for any indirect, incidental, special, or consequential damages arising from your use of our website or services. Our total liability for any claim arising from our services shall not exceed the amount you have paid to us in the 90 days preceding the claim.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-bold text-text mb-3">8. Governing law</h2>
          <p class="text-text-muted leading-relaxed">
            These terms are governed by the laws of the State of Texas. Any disputes shall be resolved in the courts of Hidalgo County, Texas, or as otherwise agreed in a separate service agreement.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-bold text-text mb-3">9. Changes to these terms</h2>
          <p class="text-text-muted leading-relaxed">
            We reserve the right to update these terms at any time. The "last updated" date at the top of this page reflects the most recent revision. Continued use of our website after changes constitutes acceptance of the updated terms.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-bold text-text mb-3">10. Contact</h2>
          <p class="text-text-muted leading-relaxed">
            Questions about these terms? Contact us:<br />
            Email: <a href={`mailto:${site.email}`} class="text-brand-blue hover:underline">{site.email}</a><br />
            Phone: <a href={site.phoneHref} class="text-brand-blue hover:underline">{site.phone}</a>
          </p>
        </div>

      </div>

      <div class="mt-12 pt-8 border-t border-border">
        <a href="/" class="text-sm text-brand-blue font-semibold hover:underline">← Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>
