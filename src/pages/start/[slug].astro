---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { onboardingClients, type OnboardingClient } from '@/data/onboarding';

// Private onboarding wizard. Passcode-gated on Vercel by /middleware.js; noindex and out of the sitemap.
export function getStaticPaths() {
  return onboardingClients.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: OnboardingClient };

const promises = [
  { title: 'You work with me directly.', text: 'The person you talk to is the person doing the work. No account managers, no hand-offs.' },
  { title: 'You own everything.', text: 'Your website, content, Google accounts and data stay in your name. If we ever part ways, all of it stays with you.' },
  c.exclusivity,
  { title: 'Straight numbers.', text: "Reports show what moved and what didn't. If something isn't working, you hear it from me first." },
  { title: 'No surprise bills.', text: 'Anything outside your plan gets quoted in writing and waits for your yes.' },
];

const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const earliest = ['6:00 AM', '7:00 AM', '8:00 AM', '9:00 AM', '10:00 AM', '11:00 AM'];
const latest = ['4:00 PM', '5:00 PM', '6:00 PM', '7:00 PM', '8:00 PM', '9:00 PM', '10:00 PM'];

const input = 'w-full rounded-lg border border-border bg-bg-surface px-4 py-3 text-text placeholder:text-text-muted/60 focus:outline-none focus:ring-2 focus:ring-brand-blue focus:border-transparent';
const label = 'block text-sm font-semibold text-text mb-2';
const chip = 'inline-flex items-center gap-2 rounded-lg border border-border bg-bg-surface px-4 py-3 text-sm font-medium text-text cursor-pointer select-none transition-colors has-[:checked]:border-brand-blue has-[:checked]:bg-brand-blue/10 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-brand-blue';
const eyebrow = 'text-xs font-bold tracking-widest uppercase text-brand-purple mb-2';
const h = 'text-2xl sm:text-3xl font-extrabold text-text mb-3 outline-none';
---

<BaseLayout title={`Welcome, ${c.clientName} | RankRGV`} description="Your RankRGV onboarding." noindex={true} bare={true}>
  <div class="min-h-screen bg-bg-surface py-8 sm:py-14 px-4">
    <div class="max-w-xl mx-auto">

      <div class="flex items-center justify-between mb-6">
        <img src="/images/RankRGV_compact_logo.png" alt="RankRGV" class="h-7 w-auto" />
        <span class="text-xs font-semibold text-text-muted">{c.clientName}</span>
      </div>

      <div id="progress" class="mb-5" aria-live="polite" hidden>
        <div class="flex justify-between text-xs font-semibold text-text-muted mb-2">
          <span id="progress-label"></span>
        </div>
        <div class="h-1.5 rounded-full bg-border overflow-hidden">
          <div id="progress-bar" class="h-full bg-brand-blue rounded-full transition-all duration-300" style="width:0%"></div>
        </div>
      </div>

      <form id="wizard" class="bg-bg rounded-2xl border border-border shadow-sm p-6 sm:p-10" novalidate
        data-client={c.slug} data-endpoint={`https://submit-form.com/${site.formsparkId}`}>

        <!-- 0: Welcome -->
        <section data-step="0">
          <p class={eyebrow}>Welcome to RankRGV</p>
          <h1 class={h} tabindex="-1">Thank you, {c.contactFirst}.</h1>
          {c.letter.map((p) => <p class="text-text-muted leading-relaxed mb-4">{p}</p>)}
          <p class="text-text-muted leading-relaxed mb-4">The next few screens take about three minutes. I'll ask how and when you want to hear from me, walk you through how we'll stay in touch, and confirm your billing. After that I'll send you everything in writing.</p>
          <p class="font-bold text-text mb-1">Eddie Urbano</p>
          <p class="text-sm text-text-muted mb-8">Founder, RankRGV</p>

          <div class="rounded-xl bg-bg-surface border border-border p-5">
            <p class="text-sm font-bold text-text mb-3">What you can count on</p>
            <ol class="space-y-3">
              {promises.map((p, i) => (
                <li class="flex gap-3 text-sm">
                  <span class="font-extrabold text-brand-purple w-5 shrink-0">0{i + 1}</span>
                  <span><strong class="text-text">{p.title}</strong> <span class="text-text-muted">{p.text}</span></span>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <!-- 1: Contact method -->
        <section data-step="1" hidden>
          <p class={eyebrow}>Question 1 of 5</p>
          <h2 class={h} tabindex="-1">How should we reach you?</h2>
          <p class="text-text-muted mb-6">Pick as many as you like.</p>
          <fieldset class="mb-6">
            <legend class="sr-only">Contact methods</legend>
            <div class="grid grid-cols-2 gap-2">
              {['Text', 'Phone call', 'WhatsApp', 'Email'].map((m) => (
                <label class={chip}><input type="checkbox" name="reach_by" value={m} class="accent-brand-blue" /> {m}</label>
              ))}
            </div>
          </fieldset>
          <div class="space-y-4 mb-6">
            <div>
              <label for="name" class={label}>Your name</label>
              <input id="name" name="name" value={c.contactName} autocomplete="name" class={input} />
            </div>
            <div data-show-for="phone" hidden>
              <label for="phone" class={label}>Best phone number</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" class={input} placeholder="956-555-0123" />
            </div>
            <div data-show-for="email" hidden>
              <label for="email" class={label}>Best email</label>
              <input id="email" name="email" type="email" autocomplete="email" class={input} />
            </div>
          </div>
          <fieldset>
            <legend class={label}>Language</legend>
            <div class="flex flex-wrap gap-2">
              {['English', 'Español', 'Either one'].map((o, i) => (
                <label class={chip}><input type="radio" name="language" value={o} checked={i === 0} class="accent-brand-blue" /> {o}</label>
              ))}
            </div>
          </fieldset>
          <p class="step-error text-sm text-red-600 mt-4" hidden></p>
        </section>

        <!-- 2: Days -->
        <section data-step="2" hidden>
          <p class={eyebrow}>Question 2 of 5</p>
          <h2 class={h} tabindex="-1">Which days are okay to contact you?</h2>
          <p class="text-text-muted mb-6">Anything non-urgent will wait for one of these days.</p>
          <fieldset>
            <legend class="sr-only">Days</legend>
            <div class="grid grid-cols-4 sm:grid-cols-7 gap-2">
              {days.map((d, i) => (
                <label class={`${chip} justify-center px-2`}><input type="checkbox" name="ok_days" value={d} checked={i < 5} class="sr-only" /> {d}</label>
              ))}
            </div>
          </fieldset>
          <p class="step-error text-sm text-red-600 mt-4" hidden></p>
        </section>

        <!-- 3: Hours -->
        <section data-step="3" hidden>
          <p class={eyebrow}>Question 3 of 5</p>
          <h2 class={h} tabindex="-1">What hours work for you?</h2>
          <p class="text-text-muted mb-6">I'll write whenever I'm working, but schedule messages so they only reach you inside this window.</p>
          <div class="grid grid-cols-2 gap-4 mb-6">
            <div>
              <label for="earliest" class={label}>Not before</label>
              <select id="earliest" name="not_before" class={input}>
                <option value="">No limit</option>
                {earliest.map((t) => <option selected={t === '8:00 AM'}>{t}</option>)}
              </select>
            </div>
            <div>
              <label for="latest" class={label}>Not after</label>
              <select id="latest" name="not_after" class={input}>
                <option value="">No limit</option>
                {latest.map((t) => <option selected={t === '7:00 PM'}>{t}</option>)}
              </select>
            </div>
          </div>
          <fieldset>
            <legend class={label}>If something urgent comes up outside those hours</legend>
            <p class="text-sm text-text-muted mb-3">Urgent means a suspended Google profile, the website down, or a hacked account.</p>
            <div class="flex flex-col gap-2">
              {['Call me anyway', "Text me, I'll see it when I see it", 'Wait until my hours start'].map((o, i) => (
                <label class={chip}><input type="radio" name="urgent_after_hours" value={o} checked={i === 1} class="accent-brand-blue" /> {o}</label>
              ))}
            </div>
          </fieldset>
        </section>

        <!-- 4: Additional authorized person -->
        <section data-step="4" hidden>
          <p class={eyebrow}>Question 4 of 5</p>
          <h2 class={h} tabindex="-1">Should anyone else get our updates?</h2>
          <p class="text-text-muted mb-6">A partner, manager, or office lead who should have the same information in their hands.</p>
          <div class="flex gap-2 mb-6">
            <label class={chip}><input type="radio" name="has_other" value="No" checked class="accent-brand-blue" /> Just me</label>
            <label class={chip}><input type="radio" name="has_other" value="Yes" class="accent-brand-blue" /> Add someone</label>
          </div>
          <div id="other-fields" class="space-y-4" hidden>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div><label for="other_name" class={label}>Name</label><input id="other_name" name="other_name" class={input} /></div>
              <div><label for="other_role" class={label}>Role</label><input id="other_role" name="other_role" class={input} placeholder="Office manager" /></div>
              <div><label for="other_email" class={label}>Email</label><input id="other_email" name="other_email" type="email" class={input} /></div>
              <div><label for="other_phone" class={label}>Phone</label><input id="other_phone" name="other_phone" type="tel" class={input} /></div>
            </div>
            <fieldset>
              <legend class={label}>What can they do?</legend>
              <div class="flex flex-col gap-2">
                <label class={chip}><input type="radio" name="other_access" value="Receives updates only" checked class="accent-brand-blue" /> Receive updates only</label>
                <label class={chip}><input type="radio" name="other_access" value="Receives updates and can approve work" class="accent-brand-blue" /> Receive updates and approve work</label>
              </div>
            </fieldset>
          </div>
          <p class="step-error text-sm text-red-600 mt-4" hidden></p>
        </section>

        <!-- 5: Update format -->
        <section data-step="5" hidden>
          <p class={eyebrow}>Question 5 of 5</p>
          <h2 class={h} tabindex="-1">How do you want your updates?</h2>
          <p class="text-text-muted mb-6">Every two weeks you'll get a rundown of rankings, website activity, what we did and what's next.</p>
          <div class="flex flex-col gap-3">
            <label class={`${chip} items-start p-4`}>
              <input type="radio" name="update_format" value="Loom video" checked class="accent-brand-blue mt-1" />
              <span><strong class="block text-text">Short video (Loom)</strong><span class="text-text-muted font-normal">A few minutes, watchable on your phone. I walk you through the numbers on screen.</span></span>
            </label>
            <label class={`${chip} items-start p-4`}>
              <input type="radio" name="update_format" value="Written report" class="accent-brand-blue mt-1" />
              <span><strong class="block text-text">Written report</strong><span class="text-text-muted font-normal">The same information as a short email you can read or forward.</span></span>
            </label>
          </div>
        </section>

        <!-- 6: Staying in touch -->
        <section data-step="6" hidden>
          <p class={eyebrow}>Staying in touch</p>
          <h2 class={h} tabindex="-1">Here's how you'll hear from us.</h2>
          <ol class="relative border-l-2 border-border ml-2 space-y-6 my-6">
            <li class="pl-6 relative"><span class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-brand-blue"></span>
              <p class="text-xs font-bold uppercase tracking-wider text-brand-purple">Every 2 weeks</p>
              <p class="font-bold text-text">Your <span data-fill="update_format_lc">video update</span></p>
              <p class="text-sm text-text-muted">Rankings, website activity, what we did, and what's next.</p></li>
            <li class="pl-6 relative"><span class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-brand-blue"></span>
              <p class="text-xs font-bold uppercase tracking-wider text-brand-purple">Week 6</p>
              <p class="font-bold text-text">First check-in call</p>
              <p class="text-sm text-text-muted">How we're doing so far: pace, early results, and what to focus on next.</p></li>
            <li class="pl-6 relative"><span class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-brand-blue"></span>
              <p class="text-xs font-bold uppercase tracking-wider text-brand-purple">Every 6 to 8 weeks after that</p>
              <p class="font-bold text-text">Strategy call</p>
              <p class="text-sm text-text-muted">We look at the numbers together and set the plan for the weeks ahead.</p></li>
          </ol>
          <div class="rounded-xl bg-bg-surface border border-border p-5 text-sm space-y-2">
            <p><strong class="text-text">Questions:</strong> <span class="text-text-muted">answered within one business day, usually the same day.</span></p>
            <p><strong class="text-text">Your window:</strong> <span class="text-text-muted" data-fill="window_summary"></span></p>
            <p><strong class="text-text">Reach me anytime:</strong> <span class="text-text-muted">{site.phone} · {site.email}</span></p>
          </div>
        </section>

        <!-- 7: Billing -->
        <section data-step="7" hidden>
          <p class={eyebrow}>Billing</p>
          <h2 class={h} tabindex="-1">A quick look at billing.</h2>
          <div class="rounded-xl bg-bg-dark text-white p-6 my-6">
            <p class="text-lg font-extrabold">{c.planName}</p>
            <p class="text-sm text-slate-400 mb-4">{c.planSub}</p>
            <p class="text-3xl font-extrabold">{c.monthly}<span class="text-base font-semibold text-slate-400">/mo</span></p>
            <p class="text-sm text-slate-400">plus tax</p>
          </div>
          <ul class="space-y-3 text-sm text-text-muted mb-2">
            <li><strong class="text-text">When:</strong> charged automatically on the {c.billingDay} of each month to the card on file through Stripe.</li>
            <li><strong class="text-text">Receipts:</strong> emailed to you after every charge.</li>
            {c.billingNote && <li><strong class="text-text">Setup:</strong> {c.billingNote}</li>}
            <li><strong class="text-text">Terms:</strong> {c.cancelNote}</li>
            <li><strong class="text-text">Extra work:</strong> quoted in writing first. No quote, no charge.</li>
          </ul>
          <p class="submit-error text-sm text-red-600 mt-4" hidden>That didn't go through. Try again, or text me at {site.phone} and I'll take it from there.</p>
        </section>

        <!-- 8: Thank you -->
        <section data-step="8" hidden>
          <div class="text-center py-6">
            <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            </div>
            <h2 class={h} tabindex="-1">You're all set, {c.contactFirst}.</h2>
            <p class="text-text-muted leading-relaxed mb-3">Thank you for taking the time. Within one business day I'll send you a recap with everything in writing: your preferences, the plan, how we'll stay in touch, and my confidentiality pledge.</p>
            <p class="text-text-muted leading-relaxed">Glad to have you with us.</p>
            <p class="font-bold text-text mt-6">Eddie</p>
          </div>
        </section>

        <div id="nav" class="flex items-center justify-between gap-3 mt-8 pt-6 border-t border-border">
          <button type="button" id="back" class="px-4 py-3 text-sm font-semibold text-text-muted hover:text-text invisible">Back</button>
          <button type="button" id="next" class="px-7 py-3 bg-brand-blue text-white font-semibold rounded-lg hover:opacity-90 transition-opacity disabled:opacity-60">Let's get started</button>
        </div>
      </form>

      <p class="text-center text-xs text-text-muted mt-6">Private to {c.clientName}. Questions? {site.phone}</p>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('wizard') as HTMLFormElement;
  const steps = Array.from(form.querySelectorAll<HTMLElement>('[data-step]'));
  const back = document.getElementById('back') as HTMLButtonElement;
  const next = document.getElementById('next') as HTMLButtonElement;
  const nav = document.getElementById('nav') as HTMLElement;
  const progress = document.getElementById('progress') as HTMLElement;
  const bar = document.getElementById('progress-bar') as HTMLElement;
  const progressLabel = document.getElementById('progress-label') as HTMLElement;
  const LAST_INPUT = 7; // billing; step 8 is the thank-you screen
  let current = 0;

  const val = (name: string) => (form.elements.namedItem(name) as RadioNodeList | HTMLInputElement | null)?.value?.trim() ?? '';
  const all = (name: string) => Array.from(form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)).map((i) => i.value);

  function windowSummary() {
    const days = all('ok_days');
    const d = days.length === 7 ? 'Any day' : days.join(', ') || 'No days picked';
    const from = val('not_before'), to = val('not_after');
    const hours = from || to ? `${from || 'any time'} to ${to || 'any time'}` : 'any time';
    return `${d}, ${hours}. Non-urgent messages are scheduled to land inside it.`;
  }

  function syncConditional() {
    const methods = all('reach_by');
    form.querySelector<HTMLElement>('[data-show-for="phone"]')!.hidden = !methods.some((m) => m !== 'Email');
    form.querySelector<HTMLElement>('[data-show-for="email"]')!.hidden = !methods.includes('Email');
    (document.getElementById('other-fields') as HTMLElement).hidden = val('has_other') !== 'Yes';
    form.querySelectorAll<HTMLElement>('[data-fill="update_format_lc"]').forEach((el) => {
      el.textContent = val('update_format') === 'Written report' ? 'written report' : 'video update';
    });
    form.querySelectorAll<HTMLElement>('[data-fill="window_summary"]').forEach((el) => (el.textContent = windowSummary()));
  }

  function validate(step: number): string {
    if (step === 1) {
      const methods = all('reach_by');
      if (!methods.length) return 'Pick at least one way to reach you.';
      if (methods.some((m) => m !== 'Email') && !val('phone')) return 'Add the best phone number.';
      if (methods.includes('Email') && !/^\S+@\S+\.\S+$/.test(val('email'))) return 'Add a valid email.';
    }
    if (step === 2 && !all('ok_days').length) return 'Pick at least one day.';
    if (step === 4 && val('has_other') === 'Yes') {
      if (!val('other_name')) return 'Add their name.';
      if (!val('other_email') && !val('other_phone')) return 'Add an email or phone for them.';
    }
    return '';
  }

  function show(step: number) {
    steps.forEach((s) => (s.hidden = Number(s.dataset.step) !== step));
    current = step;
    syncConditional();
    back.classList.toggle('invisible', step === 0);
    next.textContent = step === 0 ? "Let's get started" : step === LAST_INPUT ? 'Finish' : 'Next';
    nav.hidden = step > LAST_INPUT;
    progress.hidden = step === 0 || step > LAST_INPUT;
    progressLabel.textContent = `Step ${step} of ${LAST_INPUT}`;
    bar.style.width = `${(step / LAST_INPUT) * 100}%`;
    steps[step].querySelector<HTMLElement>('h1, h2')?.focus({ preventScroll: true });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function answers() {
    return {
      client: form.dataset.client,
      name: val('name'),
      reach_by: all('reach_by').join(', '),
      phone: val('phone'),
      email: val('email'),
      language: val('language'),
      ok_days: all('ok_days').join(', '),
      not_before: val('not_before') || 'No limit',
      not_after: val('not_after') || 'No limit',
      urgent_after_hours: val('urgent_after_hours'),
      other_person: val('has_other') === 'Yes'
        ? { name: val('other_name'), role: val('other_role'), email: val('other_email'), phone: val('other_phone'), access: val('other_access') }
        : null,
      update_format: val('update_format'),
    };
  }

  async function submit() {
    const err = form.querySelector<HTMLElement>('.submit-error')!;
    err.hidden = true;
    next.disabled = true;
    next.textContent = 'Sending...';
    const a = answers();
    const { other_person, ...flat } = a;
    const payload = {
      ...flat,
      other_person: other_person ? `${other_person.name} (${other_person.role || 'no role'}) ${other_person.email} ${other_person.phone} · ${other_person.access}` : 'None',
      form_type: 'onboarding-wizard',
      '_email.subject': `Onboarding complete: ${a.client}`,
      recap_json: JSON.stringify(a),
    };
    try {
      const res = await fetch(form.dataset.endpoint!, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(String(res.status));
      show(LAST_INPUT + 1);
    } catch {
      err.hidden = false;
      next.disabled = false;
      next.textContent = 'Finish';
    }
  }

  next.addEventListener('click', () => {
    const msg = validate(current);
    const errEl = steps[current].querySelector<HTMLElement>('.step-error');
    if (errEl) { errEl.textContent = msg; errEl.hidden = !msg; }
    if (msg) return;
    if (current === LAST_INPUT) submit();
    else show(current + 1);
  });
  back.addEventListener('click', () => show(Math.max(0, current - 1)));
  form.addEventListener('change', syncConditional);
  form.addEventListener('submit', (e) => e.preventDefault());
  form.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && (e.target as HTMLElement).tagName === 'INPUT') { e.preventDefault(); next.click(); }
  });
  show(0);
</script>
