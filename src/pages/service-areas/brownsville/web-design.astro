---
import ServiceAreaLayout from '@/layouts/ServiceAreaLayout.astro';
import Hero from '@/components/Hero.astro';
import TrustSignals from '@/components/TrustSignals.astro';
import HowWeWork from '@/components/HowWeWork.astro';
import Testimonials from '@/components/Testimonials.astro';
import FAQSection from '@/components/FAQSection.astro';
import CTASection from '@/components/CTASection.astro';
import { getAreaBySlug } from '@/data/serviceAreas';
import { getServiceBySlug } from '@/data/services';
import {
  buildServiceSchema,
  buildFAQSchema,
  buildHowToSchema,
  buildBreadcrumbSchema,
  buildWebPageSchema,
} from '@/components/SchemaMarkup.astro';
import { site } from '@/config/site';

const area = getAreaBySlug('brownsville')!;
const service = getServiceBySlug('web-design')!;

const title = 'Web Design Brownsville TX | Fast, SEO-Ready Sites That Convert | RankRGV';
const description =
  "Brownsville web design built for a bilingual, growing economy. 99+ PageSpeed, mobile-first, built to rank from day one. Free audit — (956) 391-5991.";

const faqs = [
  {
    question: 'Should my Brownsville business website be bilingual?',
    answer:
      "For most Brownsville businesses, yes — and it's not just about translation. A bilingual site serves both the English-dominant and Spanish-dominant segments of your market without excluding either. We implement bilingual content in a way that doesn't hurt your SEO: separate pages, correct hreflang tags, and content that reads naturally in both languages rather than machine-translated. How much Spanish content makes sense depends on your industry and customer base — we'll advise you specifically.",
  },
  {
    question: 'How much does a professional website cost for a Brownsville business?',
    answer:
      "Most Brownsville small business websites run $2,000–$5,000 for a clean, fast, properly built site. The range depends on page count, bilingual requirements, and service complexity. We build on Astro — not WordPress or page builders — which means your site will score 99+ on Google PageSpeed and rank significantly better than what most Brownsville businesses are currently running. Fixed pricing, no surprise add-ons.",
  },
  {
    question: 'Does my Brownsville website need to target SpaceX or the growing tech economy?',
    answer:
      "It depends entirely on your business. If you serve the Boca Chica / SpaceX corridor — whether that's housing, food service, professional services, or commercial — then yes, we build pages that target those searches specifically. If you're serving the broader Brownsville residential market, the tech angle is less critical. We analyze your specific opportunity and build for it, not for a generic template.",
  },
  {
    question: 'My Brownsville competitor has a poor website but still ranks. Why?',
    answer:
      "In Brownsville's current market, GBP strength, citation volume, and review count often outweigh website quality. That advantage is temporary — Google's Core Web Vitals now factor directly into rankings, and the gap between a fast, well-structured site and a slow one is widening. Your competitor's weak site is an opportunity: a properly built site with the right technical foundation will overtake them within 60–90 days in most Brownsville categories.",
  },
  {
    question: 'Do you build sites that work for both Brownsville and neighboring areas like Matamoros?',
    answer:
      "We focus on the US-side Brownsville market specifically. For businesses with cross-border customer bases, we can build content that speaks to that context — but we don't build Matamoros-facing content since Google Mexico rankings are a different discipline. Your Brownsville GBP and website are configured to serve the Cameron County market, with Brownsville as the primary anchor city.",
  },
  {
    question: 'How long does a Brownsville website build take?',
    answer:
      "4–6 weeks for a standard business site. The primary variable is how quickly you provide your content — logo, photos, service descriptions. We move fast on the build side. Bilingual projects typically add 1–2 weeks depending on translation complexity. You'll see a full design mockup for approval before any code is written.",
  },
];

const howToSteps = [
  { name: 'Discovery Call', text: "We start by understanding your Brownsville business — your services, customer base, whether bilingual content is needed, and what you need your website to actually do. We also assess your current site if you have one." },
  { name: 'Site Architecture & Keyword Map', text: "We map the full page structure before any design starts — based on how Brownsville customers search, what Cameron County terms matter, and whether bilingual or SpaceX-economy pages are warranted." },
  { name: 'Design Mockup', text: "Full desktop and mobile design mockup for your review before code is written. We iterate until it's right — built around your brand, not a template." },
  { name: 'Build & Content Integration', text: "We build the site and integrate your content, photos, and business information. Every page is optimized for Brownsville local search as it's built — not retrofitted." },
  { name: 'Testing & Launch', text: "Full cross-device and browser testing. PageSpeed audited, schema validated, forms tested. DNS migration handled. You get a handoff walkthrough at launch." },
  { name: 'Post-Launch Foundation', text: "Google Search Console setup, sitemap submission, GBP link updated, 30-day indexing monitoring. Your Brownsville rankings don't stall at launch." },
];

const schema = [
  buildServiceSchema('Web Design Brownsville TX', 'RankRGV designs and builds professional websites for Brownsville businesses — fast-loading, mobile-first, bilingual-capable, and built to rank on Google.', 'Brownsville'),
  buildFAQSchema(faqs),
  buildHowToSchema('How We Build Brownsville Business Websites That Rank and Convert', 'The step-by-step process RankRGV uses to build fast, high-converting websites for Brownsville businesses.', howToSteps),
  buildBreadcrumbSchema([
    { label: 'Home', href: '/' },
    { label: 'Service Areas', href: '/service-areas/' },
    { label: 'Brownsville', href: '/service-areas/brownsville/' },
    { label: 'Web Design', href: '/service-areas/brownsville/web-design/' },
  ]),
  buildWebPageSchema(title, description, '/service-areas/brownsville/web-design/'),
];
---

<ServiceAreaLayout area={area} service={service} title={title} description={description} schema={schema}>
  <Hero
    badge="Web Design · Brownsville, TX"
    headline='A Brownsville website built for a bilingual market<br /><span class="gradient-text">and a growing economy.</span>'
    subheadline="Brownsville's market is unique in Texas — bilingual customer base, growing SpaceX economy, and Cameron County's second-largest city. We build sites fast enough to rank, smart enough to convert, and built for the real Brownsville market."
    secondaryCTA={{ label: 'See how we build', href: '#how-we-work' }}
    mockupQuery="web design brownsville tx"
    mockupCategory="Web Design · Brownsville, TX"
    visualType="pagespeed"
  />

  <TrustSignals
    stats={[
      { value: '99+', label: 'PageSpeed score (Google Lighthouse)' },
      { value: '<1s', label: 'Average load time' },
      { value: 'Bilingual', label: 'English + Spanish capable' },
      { value: '0', label: 'Page builders or WordPress' },
    ]}
  />

  <section class="py-20 bg-bg" aria-labelledby="brownsville-webdesign-intro">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div class="reveal">
          <h2 id="brownsville-webdesign-intro" class="text-3xl sm:text-4xl font-bold text-text mb-6">
            Brownsville's market demands more than a generic business website
          </h2>
          <p class="text-text-muted text-lg leading-relaxed mb-5">
            Brownsville is not a template market. A bilingual customer base, a border economy, a growing SpaceX-driven tech corridor, and Cameron County's second-largest population center — these factors shape how Brownsville customers search and what builds trust when they land on your site.
          </p>
          <p class="text-text-muted text-lg leading-relaxed mb-5">
            Most Brownsville business websites are slow, not mobile-first, and treating the local market as an afterthought. We've looked at the sites ranking for Brownsville keywords right now — the opportunity to outrank them with a properly built site is real and immediate.
          </p>
          <p class="text-text-muted text-lg leading-relaxed">
            We build on Astro, which produces 99+ PageSpeed scores on every site we ship. That gap over a page-builder site is measurable in rankings and in conversion rate. Your Brownsville customers are searching on their phones — if your site doesn't load in under a second, you're losing them to the next result.
          </p>
        </div>
        <div class="space-y-4 reveal reveal-delay-1">
          {[
            { icon: '✓', title: 'Bilingual capability built in from day one', body: "We build bilingual sites that work for your SEO — not just translated text bolted on. Proper hreflang, natural copy, no ranking penalties.", highlight: true },
            { icon: '✓', title: 'SpaceX economy = new search demand', body: "New Boca Chica workers and the growing tech corridor create fresh search demand for housing, services, and professional businesses. We build for those searches.", highlight: true },
            { icon: '✓', title: 'Cameron County coverage built in', body: "Brownsville is the hub of Cameron County. We build your site to rank for Brownsville-specific searches while building authority that extends across the county.", highlight: true },
          ].map(({ icon, title, body }) => (
            <div class="p-5 rounded-xl border bg-green-50 border-green-200">
              <div class="flex gap-4">
                <span class="text-green-600 font-bold text-lg flex-shrink-0">{icon}</span>
                <div>
                  <div class="font-bold text-text mb-1">{title}</div>
                  <div class="text-text-muted text-sm leading-relaxed">{body}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-bg-surface" aria-labelledby="brownsville-webdesign-includes">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-14">
        <h2 id="brownsville-webdesign-includes" class="text-3xl sm:text-4xl font-bold text-text mb-4 reveal">
          What's included in every Brownsville web design project
        </h2>
        <p class="text-text-muted text-lg reveal reveal-delay-1">No add-on fees for the basics. Every site ships with the full stack.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {[
          {
            title: 'Performance & technical foundation',
            items: [
              '99+ Google PageSpeed / Lighthouse score',
              'Sub-1-second load time on mobile and desktop',
              'Core Web Vitals optimized (LCP, INP, CLS)',
              'Secure HTTPS with SSL certificate',
              'Clean, crawlable HTML — no page builder bloat',
              'Automatic sitemap generation',
            ],
          },
          {
            title: 'Local SEO built in from day one',
            items: [
              'LocalBusiness schema with Brownsville / Cameron County service area',
              'City-specific pages for every RGV city you serve',
              'Title tags and meta targeting Brownsville keywords',
              'Bilingual content structure (if applicable)',
              'Google Search Console setup and sitemap submission',
              'GBP website link updated at launch',
            ],
          },
        ].map(({ title, items }, i) => (
          <div class={`bg-bg rounded-2xl border border-border p-7 reveal reveal-delay-${i + 1}`}>
            <h3 class="font-bold text-text mb-5 text-lg">{title}</h3>
            <ul class="space-y-2.5">
              {items.map((item) => (
                <li class="flex items-start gap-3 text-sm text-text-muted">
                  <svg class="w-4 h-4 text-brand-blue flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <HowWeWork
    headline="How we build Brownsville business websites"
    subheadline="From first call to Google-indexed and ranking — a clear, proven process."
    steps={howToSteps.map((s, i) => ({ number: String(i + 1).padStart(2, '0'), title: s.name, body: s.text }))}
  />

  <Testimonials />

  <section class="py-16 bg-bg" aria-labelledby="other-cities-webdesign-bv">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="other-cities-webdesign-bv" class="text-2xl font-bold text-text mb-8 text-center reveal">Also building websites for these RGV cities</h2>
      <div class="flex flex-wrap gap-3 justify-center reveal reveal-delay-1">
        {[
          { label: 'Web Design McAllen TX', href: '/service-areas/mcallen/web-design/' },
          { label: 'Web Design Edinburg TX', href: '/service-areas/edinburg/web-design/' },
          { label: 'Web Design Harlingen TX', href: '/service-areas/harlingen/web-design/' },
          { label: 'Web Design Mission TX', href: '/service-areas/mission/web-design/' },
          { label: 'Web Design Pharr TX', href: '/service-areas/pharr/web-design/' },
        ].map(({ label, href }) => (
          <a href={href} class="px-4 py-2 rounded-full bg-bg-surface border border-border text-sm font-medium text-brand-blue hover:bg-brand-blue hover:text-white hover:border-brand-blue transition-all duration-200 no-underline">{label}</a>
        ))}
        <a href="/web-design/" class="px-4 py-2 rounded-full bg-bg-surface border border-border text-sm font-medium text-text-muted hover:text-brand-blue transition-colors duration-200 no-underline">All Web Design Services →</a>
      </div>
    </div>
  </section>

  <FAQSection faqs={faqs} headline="Brownsville web design questions answered" />

  <CTASection
    headline="Let's build a Brownsville website that actually works for your market"
    subheadline="15-minute call and we'll audit your current site and show you exactly what it's costing you — or get a free written audit."
  />
</ServiceAreaLayout>
