---
import ServiceAreaLayout from '@/layouts/ServiceAreaLayout.astro';
import Hero from '@/components/Hero.astro';
import TrustSignals from '@/components/TrustSignals.astro';
import HowWeWork from '@/components/HowWeWork.astro';
import Testimonials from '@/components/Testimonials.astro';
import FAQSection from '@/components/FAQSection.astro';
import CTASection from '@/components/CTASection.astro';
import { getAreaBySlug } from '@/data/serviceAreas';
import { getServiceBySlug } from '@/data/services';
import {
  buildServiceSchema,
  buildFAQSchema,
  buildHowToSchema,
  buildBreadcrumbSchema,
  buildWebPageSchema,
} from '@/components/SchemaMarkup.astro';
import { site } from '@/config/site';

const area = getAreaBySlug('edinburg')!;
const service = getServiceBySlug('web-design')!;

const title = 'Web Design Edinburg TX | Fast, SEO-Ready Sites That Convert | RankRGV';
const description =
  'Edinburg web design for professional services and UTRGV-area businesses. 99+ PageSpeed, built to rank on Google. Free audit — (956) 391-5991.';

const faqs = [
  {
    question: 'What makes a good website for an Edinburg professional services business?',
    answer:
      "Trust signals and speed. Edinburg's professional services market — attorneys, CPAs, healthcare providers, financial advisors — competes on credibility first. A slow, outdated site undermines the trust you've built everywhere else. We build sites that load fast (99+ PageSpeed), present your credentials clearly, and are structured to rank for the specific searches Edinburg professionals' clients make. Schema markup for professional services is included as standard.",
  },
  {
    question: 'Does UTRGV affect how I should build my Edinburg website?',
    answer:
      "Yes, if you serve the UTRGV market. Students, faculty, and staff have different search behaviors and price sensitivities than the general Edinburg residential market. For businesses near the university — tutoring, housing, food, professional services — we build content that speaks to both audiences without diluting your positioning. If UTRGV isn't relevant to your customer base, we don't force it.",
  },
  {
    question: 'How much does a professional website cost for an Edinburg business?',
    answer:
      "Most Edinburg business websites run $2,000–$5,000 for a properly built site. We build on Astro — not WordPress — which means 99+ PageSpeed scores and significantly better rankings than the average Edinburg site. Professional services firms sometimes invest more for additional pages (practice area pages, team bios, resource sections). We give you a clear number upfront — no hourly billing, no surprise fees.",
  },
  {
    question: 'Will a new website help me rank for Edinburg county seat searches?',
    answer:
      "Edinburg's county seat status means it attracts searches from across all of Hidalgo County — not just within city limits. A site with the right Edinburg keyword targeting, proper schema, and dedicated service-area pages will capture county-wide searches that come to Edinburg as the commercial and governmental hub. We build the page architecture to take advantage of this.",
  },
  {
    question: 'How long does an Edinburg website build take?',
    answer:
      "4–6 weeks for a standard business site. Professional services sites with multiple practice areas or team pages can run 6–8 weeks. The biggest timeline variable is content delivery — your logo, photos, service descriptions, and bios. We provide content checklists early so nothing holds up the build. You see a full design mockup before any code is written.",
  },
  {
    question: 'Do you use WordPress for Edinburg websites?',
    answer:
      "No. We build on Astro — a modern static site framework that produces sites scoring 99+ on Google PageSpeed out of the box. WordPress with plugins typically scores 40–65. That performance gap directly affects your Google rankings and your conversion rate. If you need a CMS for blog content, we can add one without sacrificing performance. But for most Edinburg business sites, static is faster, more secure, and better-ranking.",
  },
];

const howToSteps = [
  { name: 'Discovery Call', text: "We start by understanding your Edinburg business — your services, whether you target the UTRGV corridor or general Hidalgo County market, your competitors, and what your website needs to do for you." },
  { name: 'Site Architecture & Keyword Map', text: "We map the full page structure before design begins — based on how Edinburg customers search, what county seat terms matter, and whether university-adjacent content is relevant to your business." },
  { name: 'Design Mockup', text: "Full desktop and mobile design mockup for your review before any code is written. Professional services sites get specific trust-signal treatment: credentials, awards, years of experience — built into the design." },
  { name: 'Build & Content Integration', text: "We build the site and integrate your content, photos, and business information. Every page is optimized for Edinburg and Hidalgo County search as it's built." },
  { name: 'Testing & Launch', text: "Full device and browser testing. PageSpeed audited, schema validated, forms tested. DNS migration handled. Professional services sites get extra review on schema markup for their category." },
  { name: 'Post-Launch Foundation', text: "Google Search Console setup, sitemap submission, GBP link updated, 30-day indexing monitoring. We make sure your Edinburg rankings build properly from launch." },
];

const schema = [
  buildServiceSchema('Web Design Edinburg TX', 'RankRGV designs and builds professional websites for Edinburg businesses — fast-loading, mobile-first, and optimized for the Hidalgo County professional services market.', 'Edinburg'),
  buildFAQSchema(faqs),
  buildHowToSchema('How We Build Edinburg Business Websites That Rank and Convert', 'The step-by-step process RankRGV uses to build fast, high-converting websites for Edinburg businesses.', howToSteps),
  buildBreadcrumbSchema([
    { label: 'Home', href: '/' },
    { label: 'Service Areas', href: '/service-areas/' },
    { label: 'Edinburg', href: '/service-areas/edinburg/' },
    { label: 'Web Design', href: '/service-areas/edinburg/web-design/' },
  ]),
  buildWebPageSchema(title, description, '/service-areas/edinburg/web-design/'),
];
---

<ServiceAreaLayout area={area} service={service} title={title} description={description} schema={schema}>
  <Hero
    badge="Web Design · Edinburg, TX"
    headline='An Edinburg website built for professional credibility<br /><span class="gradient-text">and top Google rankings.</span>'
    subheadline="Edinburg is the Hidalgo County seat and home to UTRGV. Professional services here compete on trust and visibility. We build sites that establish both — 99+ PageSpeed, proper schema, and ranking for the searches your clients actually make."
    secondaryCTA={{ label: 'See how we build', href: '#how-we-work' }}
    mockupQuery="web design edinburg tx"
    mockupCategory="Web Design · Edinburg, TX"
    visualType="pagespeed"
  />

  <TrustSignals
    stats={[
      { value: '99+', label: 'PageSpeed score (Google Lighthouse)' },
      { value: '<1s', label: 'Average load time' },
      { value: 'Edinburg', label: 'Hidalgo County seat coverage' },
      { value: '0', label: 'Page builders or WordPress' },
    ]}
  />

  <section class="py-20 bg-bg" aria-labelledby="edinburg-webdesign-intro">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div class="reveal">
          <h2 id="edinburg-webdesign-intro" class="text-3xl sm:text-4xl font-bold text-text mb-6">
            Edinburg's professional market expects more than a slow website
          </h2>
          <p class="text-text-muted text-lg leading-relaxed mb-5">
            Edinburg is the county seat, the UTRGV campus city, and the professional services hub of Hidalgo County. Attorneys, healthcare providers, CPAs, and financial advisors here are being evaluated on credibility before a prospect ever calls. A slow, outdated website signals the wrong thing — regardless of how good your actual service is.
          </p>
          <p class="text-text-muted text-lg leading-relaxed mb-5">
            We've looked at the sites ranking for Edinburg professional keywords right now. Most are running on slow WordPress installations, lacking proper schema markup, and not structured to capture county-wide search demand. A properly built site breaks into this market fast.
          </p>
          <p class="text-text-muted text-lg leading-relaxed">
            We build on Astro, which produces 99+ PageSpeed scores as a baseline. That performance advantage over a typical Edinburg competitor site directly translates into better rankings and higher conversion rates — particularly on mobile, where most Edinburg searches happen.
          </p>
        </div>
        <div class="space-y-4 reveal reveal-delay-1">
          {[
            { icon: '✓', title: 'Professional services trust signals built in', body: "Credentials, schema markup for attorneys and healthcare providers, review integration — the signals that convert a county-seat professional services search into a call.", highlight: true },
            { icon: '✓', title: 'County seat = county-wide search demand', body: "Edinburg attracts searches from across all of Hidalgo County. We build page architecture to capture those cross-city searches — not just in-city traffic.", highlight: true },
            { icon: '✓', title: 'UTRGV-adjacent opportunity for the right businesses', body: "Students, faculty, and staff represent a distinct, high-frequency search segment. We build for this audience when it's relevant to your business.", highlight: true },
          ].map(({ icon, title, body }) => (
            <div class="p-5 rounded-xl border bg-green-50 border-green-200">
              <div class="flex gap-4">
                <span class="text-green-600 font-bold text-lg flex-shrink-0">{icon}</span>
                <div>
                  <div class="font-bold text-text mb-1">{title}</div>
                  <div class="text-text-muted text-sm leading-relaxed">{body}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-bg-surface" aria-labelledby="edinburg-webdesign-includes">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-14">
        <h2 id="edinburg-webdesign-includes" class="text-3xl sm:text-4xl font-bold text-text mb-4 reveal">
          What's included in every Edinburg web design project
        </h2>
        <p class="text-text-muted text-lg reveal reveal-delay-1">No add-on fees for the basics. Every site ships with the full stack.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {[
          {
            title: 'Performance & technical foundation',
            items: [
              '99+ Google PageSpeed / Lighthouse score',
              'Sub-1-second load time on mobile and desktop',
              'Core Web Vitals optimized (LCP, INP, CLS)',
              'Secure HTTPS with SSL certificate',
              'Clean, crawlable HTML — no page builder bloat',
              'Automatic sitemap generation',
            ],
          },
          {
            title: 'Google Maps Optimization built in from day one',
            items: [
              'LocalBusiness schema with Edinburg / Hidalgo County service area',
              'Professional service schema (attorney, medical, financial)',
              'City-specific pages for every RGV market you serve',
              'Title tags targeting Edinburg and county seat keywords',
              'Google Search Console setup and sitemap submission',
              'GBP website link updated at launch',
            ],
          },
        ].map(({ title, items }, i) => (
          <div class={`bg-bg rounded-2xl border border-border p-7 reveal reveal-delay-${i + 1}`}>
            <h3 class="font-bold text-text mb-5 text-lg">{title}</h3>
            <ul class="space-y-2.5">
              {items.map((item) => (
                <li class="flex items-start gap-3 text-sm text-text-muted">
                  <svg class="w-4 h-4 text-brand-blue flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <HowWeWork
    headline="How we build Edinburg business websites"
    subheadline="A clear process — built for professional services and the Hidalgo County market."
    steps={howToSteps.map((s, i) => ({ number: String(i + 1).padStart(2, '0'), title: s.name, body: s.text }))}
  />

  <Testimonials />

  <section class="py-16 bg-bg" aria-labelledby="other-cities-webdesign-ed">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="other-cities-webdesign-ed" class="text-2xl font-bold text-text mb-8 text-center reveal">Also building websites for these RGV cities</h2>
      <div class="flex flex-wrap gap-3 justify-center reveal reveal-delay-1">
        {[
          { label: 'Web Design McAllen TX', href: '/service-areas/mcallen/web-design/' },
          { label: 'Web Design Brownsville TX', href: '/service-areas/brownsville/web-design/' },
          { label: 'Web Design Harlingen TX', href: '/service-areas/harlingen/web-design/' },
          { label: 'Web Design Mission TX', href: '/service-areas/mission/web-design/' },
          { label: 'Web Design Pharr TX', href: '/service-areas/pharr/web-design/' },
        ].map(({ label, href }) => (
          <a href={href} class="px-4 py-2 rounded-full bg-bg-surface border border-border text-sm font-medium text-brand-blue hover:bg-brand-blue hover:text-white hover:border-brand-blue transition-all duration-200 no-underline">{label}</a>
        ))}
        <a href="/web-design/" class="px-4 py-2 rounded-full bg-bg-surface border border-border text-sm font-medium text-text-muted hover:text-brand-blue transition-colors duration-200 no-underline">All Web Design Services →</a>
      </div>
    </div>
  </section>

  <FAQSection faqs={faqs} headline="Edinburg web design questions answered" />

  <CTASection
    headline="Let's build an Edinburg website that earns trust and ranks on Google"
    subheadline="15-minute call and we'll audit your current site and show you exactly what it's missing — or get a free written audit."
  />
</ServiceAreaLayout>
