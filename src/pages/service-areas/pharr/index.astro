---
import ServiceAreaLayout from '@/layouts/ServiceAreaLayout.astro';
import Hero from '@/components/Hero.astro';
import TrustSignals from '@/components/TrustSignals.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import Testimonials from '@/components/Testimonials.astro';
import FAQSection from '@/components/FAQSection.astro';
import CTASection from '@/components/CTASection.astro';
import { getAreaBySlug } from '@/data/serviceAreas';
import { services } from '@/data/services';
import {
  buildFAQSchema,
  buildBreadcrumbSchema,
  buildWebPageSchema,
} from '@/components/SchemaMarkup.astro';
import { site } from '@/config/site';

const area = getAreaBySlug('pharr')!;

const title = 'Digital Marketing Agency Pharr TX | Local SEO & Web Design | RankRGV';
const description =
  "Pharr's local SEO & digital marketing agency. Near-zero SEO competition, real search demand. Rank on Google fast. Free audit — (956) 391-5991.";

const faqs = [
  {
    question: "Why is Pharr such a strong opportunity for local SEO?",
    answer:
      "Pharr has real search demand — the international bridge drives logistics, trade, and commercial activity that generates consistent local searches — but almost no local businesses have optimized their digital presence. Most Pharr businesses ranking in Google today are there purely by default. Zero real competition. A properly built website and Google Business Profile can reach the Map Pack in Pharr faster than any other RGV city.",
  },
  {
    question: "What kinds of businesses in Pharr benefit from local SEO?",
    answer:
      "Logistics and warehousing businesses near the Pharr International Bridge, home services serving the Las Milpas and Sharyland Plantation areas, healthcare providers, restaurants, auto repair, and any professional service business. The cross-border commerce economy also creates demand for import/export services, customs brokers, freight forwarders, and related legal and financial services — searches that are largely uncontested in Pharr.",
  },
  {
    question: "Is Pharr SEO just for businesses tied to the international bridge?",
    answer:
      "No — Pharr's residential base creates the same demand for home services, healthcare, and professional services that every other RGV city has. The bridge economy is a bonus layer on top of a normal local market. We serve plumbers, roofers, HVAC companies, attorneys, and dentists in Pharr just as readily as logistics businesses. The low competition applies across all categories.",
  },
  {
    question: "How quickly can a Pharr business start ranking?",
    answer:
      "Pharr is where we see our fastest Map Pack movement in the RGV. With proper GBP optimization, a dedicated Pharr page, and a few foundational citations, some businesses see initial movement within 30–45 days. The competitive vacuum is that real. We don't overpromise, but Pharr is legitimately the lowest-hanging fruit in South Texas digital marketing right now.",
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': ['LocalBusiness', 'ProfessionalService'],
    name: site.name,
    url: site.url,
    telephone: site.phone,
    description: 'Digital marketing agency serving Pharr and the Rio Grande Valley. Local SEO, web design, and business automation.',
    areaServed: { '@type': 'City', name: 'Pharr, TX' },
  },
  buildFAQSchema(faqs),
  buildBreadcrumbSchema([
    { label: 'Home', href: '/' },
    { label: 'Service Areas', href: '/service-areas/' },
    { label: 'Pharr', href: '/service-areas/pharr/' },
  ]),
  buildWebPageSchema(title, description, '/service-areas/pharr/'),
];
---

<ServiceAreaLayout
  area={area}
  title={title}
  description={description}
  schema={schema}
  hreflang={[
    { lang: 'en', href: 'https://rankrgv.com/service-areas/pharr/' },
    { lang: 'es', href: 'https://rankrgv.com/es/areas-de-servicio/pharr/' },
    { lang: 'x-default', href: 'https://rankrgv.com/service-areas/pharr/' },
  ]}
>
  <Hero
    badge="Serving Pharr, TX & Hidalgo County"
    headline={`Pharr's local SEO & digital marketing agency.<br /><span class="gradient-text">Zero competition. Real results.</span>`}
    subheadline="Pharr has strong search demand and almost no SEO competition. One of Texas's busiest international bridges drives real commercial activity — and most businesses here still have zero local SEO presence. That's your opportunity."
    secondaryCTA={{ label: 'View our services', href: '#pharr-services' }}
    mockupQuery="digital marketing pharr tx"
    mockupCategory="Marketing Agency · Pharr, TX"
  />

  <TrustSignals
    stats={[
      { value: '80K+', label: 'Pharr population' },
      { value: '#1', label: 'Busiest commercial port in RGV' },
      { value: 'Lowest', label: 'SEO competition in South Texas' },
      { value: '30–45 days', label: 'Fastest Map Pack movement in RGV' },
    ]}
  />

  <section class="py-20 bg-bg" aria-labelledby="pharr-market">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div class="reveal">
          <h2 id="pharr-market" class="text-3xl sm:text-4xl font-bold text-text mb-6">
            Pharr is the best-kept secret in South Texas digital marketing
          </h2>
          <p class="text-text-muted text-lg leading-relaxed mb-5">
            Pharr International Bridge is one of the busiest commercial ports of entry in Texas. The logistics, warehousing, and cross-border commerce it generates creates real local search demand — for freight services, legal, financial, home services, and everything that supports a working commercial city of 80,000+ people.
          </p>
          <p class="text-text-muted text-lg leading-relaxed mb-5">
            The residential communities of Las Milpas and Sharyland Plantation are growing, bringing new household demand for every service category. These are real customers searching on their phones — and right now, almost no Pharr businesses are set up to capture them.
          </p>
          <p class="text-text-muted text-lg leading-relaxed">
            We've seen Pharr businesses hit the top 3 in Google Maps faster than anywhere else in the RGV. The barrier is low, the demand is real, and almost nobody has noticed yet.
          </p>
        </div>
        <div class="reveal reveal-delay-1 space-y-4">
          <div class="rounded-2xl overflow-hidden border border-border shadow-sm aspect-video bg-bg-dark relative flex items-end">
            <div class="absolute inset-0 bg-gradient-to-br from-brand-blue-dark via-bg-dark to-brand-purple/40"></div>
            <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 24px 24px;"></div>
            <div class="relative z-10 p-6 w-full">
              <div class="text-white/70 text-xs font-semibold uppercase tracking-widest mb-1">Rio Grande Valley</div>
              <div class="text-white text-2xl font-extrabold tracking-tight">Pharr, Texas</div>
              <div class="text-white/60 text-sm mt-1">Hidalgo County · International trade gateway</div>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            {[
              { value: '80K+', label: 'Pharr population' },
              { value: 'Intl.', label: 'Bridge — top TX commercial port' },
              { value: 'Near Zero', label: 'SEO competition' },
              { value: '30 days', label: 'Fastest results in RGV' },
            ].map(({ value, label }) => (
              <div class="bg-bg-surface rounded-xl p-4 border border-border text-center">
                <div class="text-xl font-extrabold gradient-text mb-0.5">{value}</div>
                <div class="text-xs text-text-muted leading-tight">{label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-bg-surface" aria-labelledby="pharr-services">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <h2 id="pharr-services" class="text-3xl sm:text-4xl font-bold text-text mb-4 reveal">
          Digital marketing services for Pharr businesses
        </h2>
        <p class="text-text-muted text-lg reveal reveal-delay-1">
          Strategies built for the Pharr market — logistics, residential, and everything in between.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {services.map((service, i) => (
          <div class={`reveal reveal-delay-${i + 1}`}>
            <div class="relative">
              <ServiceCard service={service} />
              <a href={`/service-areas/pharr/${service.slug}/`} class="absolute inset-0 rounded-2xl" aria-label={`${service.name} in Pharr`}></a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-bg" aria-labelledby="pharr-neighborhoods">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <h2 id="pharr-neighborhoods" class="text-3xl font-bold text-text mb-4 reveal">
          We help businesses across all of Pharr
        </h2>
        <p class="text-text-muted reveal reveal-delay-1">
          Downtown Pharr to Sharyland Plantation, Las Milpas to North Pharr — if your customers are in the Pharr area, we help them find you.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 justify-center reveal reveal-delay-2">
        {area.neighborhoods.map((n) => (
          <span class="px-4 py-2 rounded-full bg-bg-surface border border-border text-sm text-text-muted font-medium">{n}</span>
        ))}
        <span class="px-4 py-2 rounded-full bg-bg-surface border border-border text-sm text-text-muted font-medium">& surrounding areas</span>
      </div>
    </div>
  </section>

  <Testimonials />

  <section aria-labelledby="pharr-map">
    <div class="py-12 bg-bg-surface">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 id="pharr-map" class="text-2xl font-bold text-text mb-2 reveal">Serving Pharr and all of Hidalgo County</h2>
        <p class="text-text-muted reveal reveal-delay-1">We serve businesses throughout Pharr and surrounding RGV communities.</p>
      </div>
    </div>
    <div class="w-full reveal reveal-delay-2" style="height: 420px;">
      <iframe
        title="Pharr, Texas service area map"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d114841.30974648!2d-98.1836!3d26.1951!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x86657a4d9b7a1a33%3A0x0!2sPharr%2C%20TX!5e0!3m2!1sen!2sus!4v1700000000005!5m2!1sen!2sus"
        width="100%" height="420" style="border:0; display:block;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </section>

  <FAQSection faqs={faqs} headline="Questions about digital marketing in Pharr" />

  <CTASection
    headline="Pharr has the lowest competition in the RGV. Let's use it."
    subheadline="15-min call and we'll map out exactly how fast you can rank in Pharr — or get a free written audit."
  />
</ServiceAreaLayout>
