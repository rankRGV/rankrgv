---
// Approved homepage, refined from the local v2 draft.
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchHero from '@/components/SearchHero.astro';
import FAQSection from '@/components/FAQSection.astro';
import { buildOrgSchema, buildFAQSchema, buildWebPageSchema } from '@/components/SchemaMarkup.astro';
import { site } from '@/config/site';
import eddiePhoto from '@/assets/eddie-urbano.png';
import coolAidWebsite from '@/assets/cool-aid-website.png';

const faqs = [
  { question: 'How long does local SEO take?', answer: 'SEO builds over months. The starting point, service and competition affect how quickly rankings move. We track progress and explain what changed. We do not promise a particular Google position or number of calls.' },
  { question: 'How much does local SEO cost?', answer: 'Our Visibility plan starts at $600/month. Domination is $975/month. Google Business Profile maintenance is a separate service, and web design starts at $1,500. See our pricing page for the full scope of each plan.' },
  { question: 'Do I need a long-term contract?', answer: 'No. Local SEO is month-to-month. We earn your business with the work and clear reporting, and you can leave any month.' },
  { question: 'Do you only work in the Rio Grande Valley?', answer: 'We are based in McAllen, and Local SEO for Rio Grande Valley businesses is our main focus. We also take on selected website, advertising and automation projects for businesses serving wider markets.' },
  { question: 'Is the free grade the same as a personal SEO audit?', answer: 'The Business Grader is an automated public-listing snapshot. You choose your business and city, confirm the listing, and select a service. A personal audit is a separate conversation with Eddie about your Google Business Profile, website, search visibility and competition. Request it through our contact page or call 956-391-5991.' },
  { question: 'Do I need local SEO if I already have a website?', answer: 'A website gives customers somewhere to go. Local SEO helps connect your site and Google Business Profile with people searching for your service in the cities you serve.' },
];

const title = 'Local SEO McAllen TX | Get More Calls From Google | RankRGV';
const description = 'Local SEO in McAllen, TX built for Rio Grande Valley businesses. We get you ranked on Google Maps and driving calls — month-to-month, no long-term contracts. Free audit, call (956) 391-5991.';

const schema = [
  buildOrgSchema(),
  buildFAQSchema(faqs),
  buildWebPageSchema(title, description, '/'),
];

const graderAction = `${site.graderUrl}/`;
const finalCities = ['McAllen', 'Edinburg', 'Mission', 'Pharr', 'Brownsville', 'Harlingen', 'Weslaco'];

const check = 'M5 13l4 4L19 7';

// Real Google reviews from the RankRGV profile, copied word for word (checked 2026-10-02).
const reviews = [
  {
    quote: 'Eddie has gone above and beyond in restructuring, fixing and optimizing both our website and SEO. He has greatly improved our ranking and online presence. He is honest, knowledgeable and communicative in regards to our concerns. He has gained our trust and we hope to continue working and seeing results. Thank you for our peace of mind!',
    name: 'Monica Castillo',
    meta: 'Cool Aid Air Conditioning · Edinburg, TX',
    initials: 'MC',
    bg: '#e0f2fe',
    fg: '#0369a1',
  },
  {
    quote: 'I highly recommend RankRGV! Eddie is extremely knowledgeable and has provided great insights on how to grow my business and stand out amongst others. His tools, resources, and customer service alongside his genuine passion for what he does is unmatched. Thank you for all your help.',
    name: 'Delfino Cervantes',
    meta: 'Realtor · McAllen, TX',
    initials: 'DC',
    bg: 'rgba(29, 78, 216, 0.1)',
    fg: '#1d4ed8',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${site.url}/`}
  hreflang={[{ lang: 'en', href: `${site.url}/` }, { lang: 'es', href: `${site.url}/es/` }, { lang: 'x-default', href: `${site.url}/` }]}
  schema={schema}
>

  <SearchHero />

  <!-- ===================== Proof strip: real facts only ===================== -->
  <section class="bg-bg border-b border-border" aria-label="Why businesses trust RankRGV">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ul class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 lg:gap-x-0 divide-border lg:divide-x">
        <li class="flex flex-col items-start sm:flex-row sm:items-center gap-2 sm:gap-3 py-5 lg:px-6 lg:first:pl-0">
          <span class="text-2xl font-extrabold text-brand-blue tabular-nums leading-none">$600</span>
          <span class="text-sm leading-snug text-text-muted"><strong class="block text-text font-semibold">Prices posted</strong><a href="/pricing/" class="hover:text-brand-blue hover:underline">No "call for a quote"</a></span>
        </li>
        <li class="flex flex-col items-start sm:flex-row sm:items-center gap-2 sm:gap-3 py-5 lg:px-6">
          <span class="text-2xl font-extrabold text-text tabular-nums leading-none">5.0<span class="text-amber-400 text-xl align-[1px]">★</span></span>
          <span class="text-sm leading-snug text-text-muted"><strong class="block text-text font-semibold">Google reviews</strong>Verified on our profile</span>
        </li>
        <li class="flex flex-col items-start sm:flex-row sm:items-center gap-2 sm:gap-3 py-5 lg:px-6">
          <span class="w-9 h-9 rounded-full bg-green-100 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d={check} /></svg>
          </span>
          <span class="text-sm leading-snug text-text-muted"><strong class="block text-text font-semibold">Month-to-month</strong>No long-term contract</span>
        </li>
        <li class="flex flex-col items-start sm:flex-row sm:items-center gap-2 sm:gap-3 py-5 lg:px-6 lg:last:pr-0">
          <span class="w-9 h-9 rounded-full bg-brand-blue/10 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-brand-blue" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z" /></svg>
          </span>
          <span class="text-sm leading-snug text-text-muted"><strong class="block text-text font-semibold">Based in McAllen</strong>Rooted in the Valley</span>
        </li>
      </ul>
    </div>
  </section>

  <section id="our-work" class="py-12 lg:py-16 bg-bg" aria-labelledby="work-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-7 lg:gap-10 items-center">
        <div>
          <h2 id="work-heading" class="text-3xl sm:text-4xl font-bold text-text mb-4">Work you can actually see.</h2>
          <p class="text-lg text-text-muted mb-5">We rebuilt Cool Aid Air Conditioning's website for its Edinburg business. The live site includes service pages in English and Spanish, with clear ways to call or request help.</p>
          <a href="https://coolaidairconditioning.com/" target="_blank" rel="noopener" class="font-semibold text-brand-blue underline underline-offset-4">Visit the Cool Aid website <span class="sr-only">(opens in a new tab)</span><span aria-hidden="true"> ↗</span></a>
          <p class="mt-3 text-sm text-text-muted">A published client website, not a concept or a promised result.</p>
        </div>
        <figure class="overflow-hidden rounded-2xl border border-border">
          <Image src={coolAidWebsite} alt="Cool Aid Air Conditioning's published homepage, with its service information and contact options" width={1280} height={850} class="w-full h-auto" loading="lazy" />
          <figcaption class="px-4 py-3 text-sm text-text-muted bg-bg-surface">Cool Aid Air Conditioning · website rebuild</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ===================== Reviews + who you work with ===================== -->
  <section class="py-12 lg:py-16 bg-bg" aria-labelledby="results-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <h2 id="results-heading" class="text-3xl sm:text-4xl font-bold text-text mb-3">What RGV business owners say</h2>
        <p class="text-text-muted text-lg">Attributed reviews from our Google profile.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {reviews.map((r) => (
          <figure class="bg-white border border-border rounded-2xl p-6 shadow-sm flex flex-col">
            <div class="flex items-center justify-between gap-3 mb-4">
              <span class="text-amber-400 text-lg leading-none tracking-wide" aria-label="5 out of 5 stars">★★★★★</span>
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-text-muted">
                <svg class="w-3.5 h-3.5" viewBox="0 0 48 48" aria-hidden="true">
                  <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
                  <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
                  <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24c0 3.55.85 6.91 2.34 9.88l7.35-5.7z"/>
                  <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>
                </svg>
                Google review
              </span>
            </div>
            <blockquote class="text-text leading-relaxed mb-5 flex-1">"{r.quote}"</blockquote>
            <figcaption class="flex items-center gap-3 pt-4 border-t border-border">
              <span class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0" style={`background:${r.bg};color:${r.fg}`}>{r.initials}</span>
              <span class="min-w-0">
                <span class="block text-sm font-bold text-text">{r.name}</span>
                <span class="block text-xs text-text-muted">{r.meta}</span>
              </span>
            </figcaption>
          </figure>
        ))}

        <div class="bg-white border border-border rounded-2xl p-6 shadow-sm flex flex-col">
          <div class="inline-flex self-start items-center gap-1.5 mb-4 px-2.5 py-1 rounded-full bg-green-100 text-green-700 text-xs font-bold">
            <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
            Active client
          </div>
          <p class="text-text leading-relaxed mb-5 flex-1">
            Roofing contractor on our Domination plan, plus Google and Meta ads. Schema markup, a multi-city plan and a bilingual content roadmap.
          </p>
          <div class="flex items-center gap-3 pt-4 border-t border-border">
            <span class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-white text-sm flex-shrink-0" style="background:#1d4ed8">ER</span>
            <span>
              <span class="block text-sm font-bold text-text">Edel Roofing</span>
              <span class="block text-xs text-text-muted">Roofing · Edinburg, TX</span>
            </span>
          </div>
        </div>
      </div>

      <p class="mt-8 text-center text-sm text-text-muted">
        5.0 stars on Google.{" "}
        <a href={site.social.gbp} target="_blank" rel="noopener" class="font-semibold text-brand-blue hover:underline">Read every review →</a>
      </p>

      <!-- Founder -->
      <div class="mt-16 lg:mt-20 rounded-3xl bg-bg-dark text-white overflow-hidden">
        <div class="grid grid-cols-1 md:grid-cols-[15rem_1fr] lg:grid-cols-[17rem_1fr]">
          <div class="relative h-72 md:h-full min-h-[18rem]">
            <Image
              src={eddiePhoto}
              alt="Eddie Urbano, founder of RankRGV"
              widths={[320, 480, 640]}
              sizes="(min-width: 1024px) 272px, (min-width: 768px) 240px, 100vw"
              class="absolute inset-0 w-full h-full object-cover object-[50%_20%]"
              loading="lazy"
            />
          </div>
          <div class="p-8 sm:p-10 lg:p-12 flex flex-col justify-center">
            <p class="text-sm font-semibold text-brand-blue-light uppercase tracking-wider mb-3">Your point of contact</p>
            <h2 class="text-2xl sm:text-3xl font-bold leading-tight mb-4">Eddie Urbano, founder</h2>
            <p class="text-white/80 text-lg leading-relaxed mb-6 max-w-2xl">
              Eddie spent 15 years in tech before starting RankRGV in McAllen. He saw Valley businesses paying full price for slow, generic agency work, and built RankRGV to do it the other way: one market, plain-English reporting, and you can leave any month.
            </p>
            <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
              <a href={site.phoneHref} class="inline-flex items-center gap-2 font-semibold text-white hover:text-brand-blue-light transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z" /></svg>
                {site.phone}
              </a>
              <a href="/about/" class="text-sm font-semibold text-white/70 hover:text-white underline-offset-4 hover:underline">More about RankRGV</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== Services ===================== -->
  <section class="py-12 lg:py-16 bg-bg-surface" aria-labelledby="services-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <h2 id="services-heading" class="text-3xl sm:text-4xl font-bold text-text mb-4">Local SEO first. The rest when it helps.</h2>
        <p class="text-text-muted text-lg">Most of our clients start with Local SEO. Ads, web design and automation are there when they make the phone ring faster.</p>
      </div>

      <a href="/local-seo/" class="group block rounded-3xl bg-white border border-border p-8 sm:p-10 lg:p-12 mb-6 transition-[border-color,box-shadow] duration-200 hover:border-brand-blue hover:shadow-xl hover:shadow-brand-blue/10">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-10 items-center">
          <div class="lg:col-span-3">
            <div class="inline-flex items-center gap-2 mb-4 px-3 py-1 rounded-full bg-brand-blue/10 text-brand-blue text-xs font-bold uppercase tracking-wide">
              What we do best
            </div>
            <h3 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-text mb-4 leading-tight">
              Local SEO &amp; Google Maps for the Rio Grande Valley
            </h3>
            <p class="text-text-muted text-lg leading-relaxed mb-6">
              When someone in McAllen pulls out their phone and searches for what you do, you should be the first name they see. We get RGV businesses into the map pack and ranking for the city searches their customers actually make.
            </p>
            <span class="inline-flex items-center gap-2 text-sm font-bold text-brand-blue">
              See how Local SEO works
              <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </span>
          </div>

          <div class="lg:col-span-2 lg:pl-10 lg:border-l lg:border-border">
            <div class="text-xs font-bold text-text-muted uppercase tracking-wide mb-4">What's included</div>
            <ul class="space-y-3">
              {[
                ['Google Business Profile', 'set up for the right RGV categories and service areas'],
                ['City & service pages', 'for McAllen, Edinburg, Mission, Brownsville, Harlingen and Pharr'],
                ['Citations & reviews', 'the two signals Google leans on most for local rankings'],
                ['Monthly report', 'in plain English: what moved and what\'s next'],
              ].map(([b, rest]) => (
                <li class="flex items-start gap-3">
                  <span class="flex-shrink-0 w-5 h-5 mt-0.5 rounded-full bg-green-100 flex items-center justify-center">
                    <svg class="w-3 h-3 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d={check} /></svg>
                  </span>
                  <span class="text-text text-sm leading-snug"><strong>{b}</strong> {rest}</span>
                </li>
              ))}
            </ul>
            <div class="mt-6 pt-5 border-t border-border flex items-end justify-between gap-4">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-xs text-text-muted">Domination plan</span>
                  <span class="text-[11px] font-bold uppercase tracking-wide px-1.5 py-0.5 rounded bg-brand-blue/10 text-brand-blue">Domination</span>
                </div>
                <div class="text-2xl font-extrabold text-text">$975<span class="text-base font-medium text-text-muted">/mo</span></div>
              </div>
              <div class="text-xs text-text-muted text-right">Plans start<br />at $600/mo</div>
            </div>
          </div>
        </div>
      </a>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          { href: '/web-design/', title: 'Web Design', body: 'Fast, mobile-first sites built to rank and to get visitors to call.', link: 'See web design details', icon: 'M4 5h16v11H4zM8 20h8M12 16v4' },
          { href: '/ads-management/', title: 'Google & Meta Ads', body: 'Paid search and social campaigns alongside SEO. Flat management fee, separate from ad spend.', link: 'See ad pricing', icon: 'M3 11l18-8-8 18-2-8-8-2z' },
          { href: '/business-automation/', title: 'Business Automation', body: 'Missed-call texts, review requests and follow-ups, so leads stop slipping away.', link: 'See automation', icon: 'M12 8v4l3 2M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
        ].map((s) => (
          <a href={s.href} class="group flex flex-col bg-white border border-border rounded-2xl p-6 transition-[border-color,box-shadow] duration-200 hover:border-brand-blue hover:shadow-md">
            <span class="w-10 h-10 rounded-lg bg-brand-blue/10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={s.icon} /></svg>
            </span>
            <h3 class="text-base font-bold text-text mb-2">{s.title}</h3>
            <p class="text-text-muted text-sm leading-relaxed mb-4 flex-1">{s.body}</p>
            <span class="text-sm font-semibold text-brand-blue">{s.link} <span class="inline-block transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>

      <p class="mt-8 text-center">
        <a href="/pricing/" class="text-sm font-semibold text-brand-blue hover:underline">Local SEO from $600/mo · Web design from $1,500 · See full pricing →</a>
      </p>
    </div>
  </section>

  <section class="py-12 lg:py-16 bg-bg" aria-labelledby="how-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="how-heading" class="text-3xl sm:text-4xl font-bold text-text mb-7">A clear starting point. Work you can follow.</h2>
      <div class="grid sm:grid-cols-3 gap-7">
        {[
          ['Check your visibility', 'Start with the automated grade, or ask Eddie for a personal audit. We look at where you are today.'],
          ['Choose the right work', 'Agree on the scope and posted price. Local SEO comes first; a site, ads or follow-ups come next when needed.'],
          ['See what changed', 'Get plain-English reporting and a direct point of contact. Local SEO stays month-to-month.'],
        ].map(([heading, body]) => <div><h3 class="text-lg font-bold mb-2">{heading}</h3><p class="text-text-muted leading-relaxed">{body}</p></div>)}
      </div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <FAQSection faqs={faqs} headline="Common questions about local SEO in the RGV" />

  <!-- ===================== Final CTA: same search, one more time ===================== -->
  <section class="hero-bg relative overflow-hidden py-12 lg:py-16" aria-labelledby="final-cta">
    <div class="absolute inset-0 bg-gradient-to-tl from-brand-blue/25 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 id="final-cta" class="text-3xl sm:text-4xl lg:text-[2.75rem] font-extrabold text-white leading-tight mb-4">
        See what customers find when they Google you.
      </h2>
      <p class="text-lg text-white/80 mb-8 max-w-xl mx-auto">
        Start with an automated public-listing snapshot. Prefer to talk through your website and competition? Ask Eddie for a personal audit.
      </p>

      <form action={graderAction} method="get" class="final-form mx-auto max-w-xl rounded-2xl bg-white p-2 shadow-2xl shadow-black/30 text-left">
        <input type="hidden" name="utm_source" value="rankrgv.com" />
        <input type="hidden" name="utm_medium" value="website" />
        <input type="hidden" name="utm_campaign" value="business-grader" />
        <input type="hidden" name="utm_content" value="homepage-final" />
        <div class="flex flex-col sm:flex-row sm:items-center gap-2">
          <label class="flex-1 min-w-0 flex items-center gap-2.5 rounded-xl px-3 h-12 focus-within:bg-bg-surface transition-colors">
            <span class="sr-only">Your business name</span>
            <svg class="w-5 h-5 text-text-muted flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-5.2-5.2M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z" /></svg>
            <input name="business" type="text" maxlength="60" autocomplete="organization" placeholder="Your business name" class="w-full min-w-0 bg-transparent text-base text-text placeholder:text-text-muted/80 outline-none" />
          </label>
          <div class="flex items-center gap-2">
            <label class="relative flex items-center h-12 rounded-xl sm:border-l sm:rounded-none sm:border-border bg-bg-surface sm:bg-transparent flex-none">
              <span class="sr-only">City</span>
              <select name="city" class="bg-transparent h-full w-[7.5rem] pl-2 pr-2 text-sm font-medium text-text rounded-xl cursor-pointer">
                {finalCities.map((c) => <option value={c}>{c}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-2.5 w-4 h-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </label>
            <button type="submit" class="btn-primary h-12 justify-center whitespace-nowrap px-4 flex-1 sm:flex-none text-sm"><span class="sm:hidden">Get free grade</span><span class="hidden sm:inline">Get my free grade</span></button>
          </div>
        </div>
      </form>

      <p class="mt-5 text-sm text-white/70">
