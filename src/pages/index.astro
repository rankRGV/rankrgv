---
// Homepage (redesign 2026-10-19, built on branch concept/awwwards-hero). Web design first,
// local SEO second, per DataForSEO demand. Reviews and base FAQs live in src/data/home.ts.
import BaseLayout from '@/layouts/BaseLayout.astro';
import SpecHero from '@/components/SpecHero.astro';
import ServicesSplit from '@/components/ServicesSplit.astro';
import FAQSection from '@/components/FAQSection.astro';
import HomeReviews from '@/components/HomeReviews.astro';
import { buildOrgSchema, buildFAQSchema, buildWebPageSchema } from '@/components/SchemaMarkup.astro';
import { site } from '@/config/site';
import { homeFaqs } from '@/data/home';

const faqs = [
  { question: 'How much does a website cost?', answer: 'Our websites start at $1,500 for a 5 to 7 page Foundation site and $2,500 for a 10 to 15 page Growth site with full service and city pages, plus sales tax. Larger multi-city builds are quoted custom. You get a fixed price before any work begins.' },
  ...homeFaqs,
];

const title = 'Web Design & Local SEO in McAllen, TX | RankRGV';
const description = 'Web design and local SEO in McAllen, TX for Rio Grande Valley businesses. Websites from $1,500, local SEO from $600/mo, month-to-month. Call (956) 391-5991.';
---
<BaseLayout
  title={title}
  description={description}
  canonical={`${site.url}/`}
  hreflang={[{ lang: 'en', href: `${site.url}/` }, { lang: 'es', href: `${site.url}/es/` }, { lang: 'x-default', href: `${site.url}/` }]}
  schema={[buildOrgSchema(), buildFAQSchema(faqs), buildWebPageSchema(title, description, '/')]}
  hideSticky
>
  <SpecHero />
  <ServicesSplit />

  <HomeReviews />

  <FAQSection faqs={faqs} headline="Common questions about web design and local SEO in the RGV" />

  <section class="bg-bg-dark text-white py-14 lg:py-16" aria-labelledby="final-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 id="final-heading" class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4">Find out where you stand on Google.</h2>
      <p class="text-white/80 text-lg mb-8">Free automated check of your Google listing in 60 seconds, or call Eddie and talk it through.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={`${site.graderUrl}/?utm_source=rankrgv.com&utm_medium=website&utm_campaign=business-grader&utm_content=homepage-final`} class="inline-flex items-center h-12 px-6 rounded-xl bg-brand-blue hover:bg-brand-blue-light font-bold transition-colors">Check my Google listing →</a>
        <a href={site.phoneHref} class="inline-flex items-center h-12 px-6 rounded-xl border border-white/25 hover:border-white font-bold transition-colors">Call {site.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>

