---
import ServiceLayout from '@/layouts/ServiceLayout.astro';
import Hero from '@/components/Hero.astro';
import TrustSignals from '@/components/TrustSignals.astro';
import HowWeWork from '@/components/HowWeWork.astro';
import Testimonials from '@/components/Testimonials.astro';
import PricingSection from '@/components/PricingSection.astro';
import FAQSection from '@/components/FAQSection.astro';
import CTASection from '@/components/CTASection.astro';
import ServiceAreaGrid from '@/components/ServiceAreaGrid.astro';
import { getServiceBySlug } from '@/data/services';
import {
  buildServiceSchema,
  buildFAQSchema,
  buildHowToSchema,
  buildBreadcrumbSchema,
  buildWebPageSchema,
} from '@/components/SchemaMarkup.astro';
import { site } from '@/config/site';

const service = getServiceBySlug('business-automation')!;

const faqs = [
  {
    question: 'What is business automation and how does it help my RGV business?',
    answer:
      "Business automation means setting up software systems that handle repetitive tasks automatically — things like texting a missed caller, requesting a Google review after a job, or sending a follow-up message to a lead who didn't book. For most McAllen small businesses, this means fewer leads falling through the cracks, faster response times, and more 5-star reviews — without adding staff or working longer hours.",
  },
  {
    question: "What's a missed call text-back and why do I need it?",
    answer:
      "A missed call text-back automatically sends a text message to anyone who calls your business and doesn't get answered — within seconds. Studies show that 78% of customers go with the first business that responds to them. If you miss a call and don't follow up within 5 minutes, most leads are gone. The text-back keeps you in the conversation even when you're busy. It's one of the fastest ROI automations we set up.",
  },
  {
    question: 'How does automated review generation work?',
    answer:
      "After a job or service is completed, the system automatically sends your customer a text or email with a direct link to leave a Google review. The timing, message, and follow-up are all automated. Most RGV businesses that implement this see their Google review count double or triple within 60 days. More reviews = higher Map Pack rankings = more calls. It's a compounding loop.",
  },
  {
    question: 'Do I need to be tech-savvy to use these systems?',
    answer:
      "No. We handle all setup, integration, and configuration. Once we hand it off, the systems run themselves. We build a simple dashboard so you can see what's happening — missed calls, texts sent, reviews requested — but you don't need to touch any settings. We also do a 30-minute training session so your team knows what's automated and what to expect.",
  },
  {
    question: 'How long does it take to set up business automation?',
    answer:
      "Most automation setups take 1–2 weeks from the time we start to the time everything is live and tested. That includes missed call text-back, review requests, and basic lead follow-up sequences. More complex integrations (CRM connections, multi-step nurture campaigns) take 2–3 weeks. We don't rush setup — we'd rather spend an extra few days testing than hand you something that fires incorrectly.",
  },
  {
    question: 'What tools do you use for business automation?',
    answer:
      "We primarily work with GoHighLevel (GHL) for McAllen small businesses — it handles CRM, messaging, review requests, and automation workflows in one platform. If you already use a specific CRM or tool, we can integrate with it. We're tool-agnostic: we care about what works for your business, not about pushing a specific platform.",
  },
];

const howToSteps = [
  {
    name: 'Lead Flow Audit',
    text: "We map exactly how leads currently come into your business — phone calls, web forms, social messages, walk-ins — and where they fall through the cracks. Most RGV businesses lose 30–50% of their leads at this stage without realizing it.",
  },
  {
    name: 'Automation Design',
    text: "Based on your audit, we design the specific automations that will have the biggest impact on your business. Missed call text-back, review requests, appointment reminders, lead nurture sequences — we prioritize by ROI.",
  },
  {
    name: 'System Setup & Integration',
    text: "We build everything in your automation platform, connect it to your phone number, website forms, and CRM. Every automation is configured with your business name, voice, and branding.",
  },
  {
    name: 'Testing Every Scenario',
    text: "We simulate every lead scenario before going live: missed calls, form submissions, completed jobs, no-shows. Every automation fires correctly in every situation — or we don't launch it.",
  },
  {
    name: 'Team Handoff & Training',
    text: "30-minute training session for you and your team. You'll know exactly what's automated, what you'll receive as notifications, and how to handle responses that come back from automated messages.",
  },
  {
    name: 'Monitor & Optimize',
    text: "We track response rates, review growth, and lead contact rates monthly. Automations get refined over time — messaging that doesn't convert gets updated, timing gets adjusted, new workflows get added as your business grows.",
  },
];

const schema = [
  buildServiceSchema(
    'Business Automation McAllen TX',
    'RankRGV sets up business automation systems for McAllen small businesses — missed call text-back, automated review requests, and lead follow-up sequences that work 24/7.',
    site.areaServed
  ),
  buildFAQSchema(faqs),
  buildHowToSchema(
    'How RankRGV Sets Up Business Automation for McAllen Businesses',
    'The step-by-step process for implementing lead capture and follow-up automation for RGV small businesses.',
    howToSteps
  ),
  buildBreadcrumbSchema([
    { label: 'Home', href: '/' },
    { label: 'Business Automation', href: '/business-automation/' },
  ]),
  buildWebPageSchema(service.titleTag, service.metaDescription, '/business-automation/'),
];
---

<ServiceLayout service={service} schema={schema}>
  <Hero
    badge="Business Automation — McAllen, TX"
    headline='Stop losing leads to missed calls<br /><span class="gradient-text">and slow follow-up.</span>'
    subheadline="Every missed call is a missed customer. We set up automated systems that text back missed callers, request reviews, and follow up with leads — 24/7, automatically."
    visualType="sms"
    secondaryCTA={{ label: 'See how it works', href: '#how-we-work' }}
  />

  <TrustSignals
    stats={[
      { value: '<5 min', label: 'Automated lead response time' },
      { value: '24/7', label: 'Follow-up that never sleeps' },
      { value: '3×', label: 'Avg. increase in Google reviews' },
      { value: '0', label: 'Leads that fall through the cracks' },
    ]}
  />

  <!-- Where RGV businesses lose leads -->
  <section class="py-20 bg-bg" aria-labelledby="lead-loss">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div class="reveal">
          <h2 id="lead-loss" class="text-3xl sm:text-4xl font-bold text-text mb-6">
            Most McAllen businesses are losing 30–50% of their leads without knowing it
          </h2>
          <p class="text-text-muted text-lg leading-relaxed mb-5">
            A customer calls your business while you're on a job. No answer. They hang up and call your competitor. That's revenue that never showed up in your numbers — so you never see it.
          </p>
          <p class="text-text-muted text-lg leading-relaxed mb-5">
            Studies show that <strong>78% of customers go with the first business that responds.</strong> If a lead submits a form on your website at 9pm and you see it at 9am the next morning, they've already called three other businesses. The window is measured in minutes, not hours.
          </p>
          <p class="text-text-muted text-lg leading-relaxed">
            Business automation closes these gaps permanently. Missed caller gets a text in 30 seconds. Form submission gets a follow-up email in 2 minutes. Completed job triggers a review request automatically. You stop losing business you never knew you were losing.
          </p>
        </div>

        <!-- Lead loss scenarios -->
        <div class="space-y-4 reveal reveal-delay-1">
          {[
            {
              scenario: 'Missed call — no follow-up',
              result: 'Lead goes to competitor',
              icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z',
              fixed: 'Text-back sent in 30 seconds',
              bad: true,
            },
            {
              scenario: 'Form submitted at 9pm',
              result: 'Seen next morning — too late',
              icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
              fixed: 'Auto-response in 2 minutes',
              bad: true,
            },
            {
              scenario: 'Job completed — no review ask',
              result: 'No new Google reviews',
              icon: 'M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z',
              fixed: 'Review request auto-sent after job',
              bad: true,
            },
            {
              scenario: 'Lead goes cold after quote',
              result: 'Booked elsewhere',
              icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
              fixed: '3-touch follow-up sequence fires',
              bad: true,
            },
          ].map(({ scenario, result, icon, fixed }) => (
            <div class="bg-bg-surface rounded-xl border border-border p-5">
              <div class="flex items-start gap-4">
                <div class="w-9 h-9 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icon} />
                  </svg>
                </div>
                <div class="flex-1">
                  <div class="font-semibold text-text text-sm">{scenario}</div>
                  <div class="text-red-500 text-xs mt-0.5 font-medium">Without automation: {result}</div>
                  <div class="text-green-600 text-xs mt-1 font-medium">With RankRGV: {fixed}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- What we automate -->
  <section class="py-20 bg-bg-surface" aria-labelledby="what-we-automate">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-16">
        <h2 id="what-we-automate" class="text-3xl sm:text-4xl font-bold text-text mb-4 reveal">
          What we automate for McAllen businesses
        </h2>
        <p class="text-text-muted text-lg reveal reveal-delay-1">
          Specific systems. Specific outcomes. No vague "digital transformation."
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z',
            title: 'Missed Call Text-Back',
            body: 'Anyone who calls and doesn\'t get answered receives an automatic text within 30 seconds: "Hey, we missed your call — how can we help?" Keeps you in the conversation instead of losing the lead.',
          },
          {
            icon: 'M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z',
            title: 'Review Request Automation',
            body: 'After a job is completed, the system automatically sends your customer a direct link to leave a Google review. Most businesses triple their review count within 60 days.',
          },
          {
            icon: 'M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z',
            title: 'Lead Follow-Up Automation',
            body: "When a lead submits a form or sends a message, an automated sequence fires: immediate reply, 2-hour follow-up, next-day check-in. Most leads close after the 2nd or 3rd touch. We make sure those touches happen.",
          },
          {
            icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
            title: 'Appointment Reminders',
            body: '24 hours before and 1 hour before every appointment, your customer gets an automatic reminder via text. No-show rates drop significantly. Your schedule stays full.',
          },
          {
            icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
            title: 'CRM & Contact Management',
            body: 'Every lead — from calls, forms, and messages — automatically enters your CRM with full contact history. No more lost sticky notes or forgotten follow-ups.',
          },
          {
            icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
            title: 'Reporting Dashboard',
            body: 'See every missed call, every text sent, every review requested, and every lead in the pipeline — in one dashboard. Know exactly what your automation is doing.',
          },
        ].map((item, i) => (
          <div class={`bg-bg rounded-2xl p-7 border border-border card-hover reveal reveal-delay-${Math.min(i + 1, 4)}`}>
            <div class="w-11 h-11 rounded-xl bg-brand-blue/10 flex items-center justify-center mb-5">
              <svg class="w-5 h-5 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
              </svg>
            </div>
            <h3 class="font-bold text-text mb-2">{item.title}</h3>
            <p class="text-text-muted text-sm leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <HowWeWork
    headline="How we set up your automation"
    subheadline="A structured process from audit to launch — everything tested before it goes live."
    steps={howToSteps.map((s, i) => ({
      number: String(i + 1).padStart(2, '0'),
      title: s.name,
      body: s.text,
    }))}
  />

  <!-- Guarantee, bonuses, scarcity -->
  <section class="py-20 bg-bg" aria-labelledby="automation-guarantee">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <div class="inline-flex items-center gap-2 mb-4 px-3 py-1 rounded-full bg-brand-blue/10 text-brand-blue text-xs font-bold uppercase tracking-wide reveal">
          Verified before it's turned on
        </div>
        <h2 id="automation-guarantee" class="text-3xl sm:text-4xl font-bold text-text mb-4 reveal reveal-delay-1">
          Our guarantee
        </h2>
        <p class="text-text-muted text-lg reveal reveal-delay-2">
          Every automation we build gets tested against every real scenario — missed call, form fill, no-show — before it ever goes live. If something misfires in your first 30 days, we fix it free.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-12">
        {[
          { title: 'Free Lead Flow Audit', body: 'Before you pay anything, we map exactly where your leads are falling through the cracks — already step one of our process.' },
          { title: '30-Minute Team Training', body: "Included with every setup. Your team knows what's automated and what to expect before we hand it off." },
          { title: 'Monthly Dashboard', body: 'See every missed call, text sent, and review requested — included, every month, no extra charge.' },
        ].map((item, i) => (
          <div class={`bg-bg-surface rounded-2xl p-6 border border-border reveal reveal-delay-${Math.min(i + 1, 4)}`}>
            <h3 class="font-bold text-text mb-2 text-sm">{item.title}</h3>
            <p class="text-text-muted text-sm leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>

      <p class="text-center text-text-muted text-sm max-w-2xl mx-auto reveal">
        We intentionally keep our retainer roster small enough that every client gets real, hands-on attention — not a templated report and a rotating account manager.
      </p>
    </div>
  </section>

  <PricingSection
    id="automation-pricing"
    headline="Business automation pricing"
    subheadline="Every business is different. We scope automation projects individually — you only pay for what you actually need."
    bg="bg-surface"
    cards={[
      {
        name: 'Business Automation',
        price: 'Custom',
        period: 'quoted per project',
        description: 'Missed call text-back, lead nurture sequences, review automation, and appointment systems — built to your workflow.',
        features: [
          'Missed call text-back (< 60 sec response)',
          'Automated lead nurture sequences',
          'Review request automation',
          'Appointment reminders',
          'CRM pipeline setup',
          'Monthly performance monitoring',
        ],
        cta: { label: 'Schedule a free call', href: '/contact/' },
      },
    ]}
    note="Typical setup starts at $750 one-time + $250/month management. Schedule a free call and we'll scope it for your specific setup."
  />

  <Testimonials />

  <ServiceAreaGrid
    headline="Business automation services across the Rio Grande Valley"
    serviceSlug="business-automation"
  />

  <FAQSection faqs={faqs} headline="Business automation questions from RGV business owners" />

  <CTASection
    headline="Ready to stop losing leads to missed calls?"
    subheadline="Call for a free 15-min conversation about where your business is losing leads — we'll show you exactly what to automate first."
  />
</ServiceLayout>
