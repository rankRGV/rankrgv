---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { services } from '@/data/services';

const title = "You're on the list — RankRGV";
const description = "We received your audit request. We'll review your Google Business Profile and website before we reach out — usually within one business day.";
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="min-h-[80vh] flex items-center justify-center py-20 bg-bg">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

      <!-- Success icon -->
      <div class="w-20 h-20 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-8">
        <svg class="w-10 h-10 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-4">
        Got it — we'll be in touch.
      </h1>
      <p class="text-text-muted text-lg leading-relaxed mb-8">
        We received your request. Before we reach out, we review your Google Business Profile, your current website, and who's ranking above you for your main keywords. You get a prepared conversation — not a cold call.
      </p>
      <p class="text-text-muted mb-10">
        <strong class="text-text">Response time:</strong> Within one business day, usually the same day.
        <br />
        Want to reach us faster? Call or text <a href={site.phoneHref} class="text-brand-blue font-semibold hover:underline">{site.phone}</a>.
      </p>

      <!-- What happens next -->
      <div class="bg-bg-surface rounded-2xl border border-border p-8 mb-10 text-left">
        <h2 class="font-bold text-text mb-5 text-lg">What happens next</h2>
        <div class="space-y-4">
          {[
            { step: '01', text: 'We review your Google Business Profile, website, and top competitors for your category and city.' },
            { step: '02', text: 'We identify keyword gaps and Map Pack opportunities specific to your business — not generic advice.' },
            { step: '03', text: "We reach out with our findings and a straight assessment of what's possible and how fast." },
          ].map(({ step, text }) => (
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-9 h-9 rounded-full bg-brand-blue/10 flex items-center justify-center">
                <span class="text-brand-blue font-bold text-xs">{step}</span>
              </div>
              <p class="text-text-muted text-sm leading-relaxed pt-1.5">{text}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Explore while you wait -->
      <h2 class="font-bold text-text mb-5">Explore while you wait</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
        {services.map((service) => (
          <a
            href={`/${service.slug}/`}
            class="bg-bg-surface border border-border rounded-xl p-4 text-left hover:border-brand-blue hover:shadow-sm transition-all duration-200 no-underline group"
          >
            <div class="font-semibold text-text text-sm mb-1 group-hover:text-brand-blue transition-colors">{service.name}</div>
            <div class="text-xs text-text-muted leading-tight">{service.headline}</div>
          </a>
        ))}
      </div>

      <a href="/" class="text-sm text-brand-blue font-semibold hover:underline">← Back to home</a>
    </div>
  </section>
</BaseLayout>
